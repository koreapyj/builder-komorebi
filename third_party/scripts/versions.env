# shellcheck shell=bash disable=SC2034,SC2317
NDK_VERSION=r27c
NDK_URL=https://dl.google.com/android/repository/android-ndk-r27c-linux.zip
# Google publishes the r27c Linux archive checksum as SHA-1.
NDK_SHA1=090e8083a715fdb1a3e402d0763c388abb03fb4e

JELLYFIN_FFMPEG_VERSION=v8.1.3-2
JELLYFIN_FFMPEG_URL=https://github.com/jellyfin/jellyfin-ffmpeg.git
JELLYFIN_FFMPEG_COMMIT=7250de8375a4959ac1c25c139ce9789fdac199fb

# FFmpeg source patches come from builder-ffmpeg's source-patches/.
BUILDER_FFMPEG_URL="${KOMOREBI_BUILDER_FFMPEG_URL:-https://github.com/koreapyj/builder-ffmpeg.git}"
BUILDER_FFMPEG_COMMIT="${KOMOREBI_BUILDER_FFMPEG_COMMIT:-916a5c350b95de6c204b1fb33e1ae85e0112e7d4}"

ANDROID_API=24
FFMPEG_ABIS="arm64-v8a armeabi-v7a"
ANDROID_ABI="${FFMPEG_ABI:-arm64-v8a}"

case "$ANDROID_ABI" in
    arm64-v8a)
        TARGET_TRIPLE=aarch64-linux-android
        FFMPEG_ARCH=aarch64
        FFMPEG_CPU=armv8-a
        FFMPEG_ENABLE_NEON=1
        FFMPEG_ENABLE_THUMB=0
        ;;
    armeabi-v7a)
        TARGET_TRIPLE=armv7a-linux-androideabi
        FFMPEG_ARCH=arm
        FFMPEG_CPU=armv7-a
        FFMPEG_ENABLE_NEON=1
        FFMPEG_ENABLE_THUMB=1
        ;;
    *)
        printf 'Unsupported Android ABI: %s\n' "$ANDROID_ABI" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

THIRD_PARTY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_ROOT="${FFMPEG_BUILD_DIR:-$(dirname "$THIRD_PARTY_DIR")/.tmp/ffmpeg-build}"
SOURCE_DIR="$BUILD_ROOT/src"
BUILD_DIR="$BUILD_ROOT/$ANDROID_ABI"
INSTALL_PREFIX="$BUILD_DIR/sysroot"
PREBUILT_DIR="$THIRD_PARTY_DIR/prebuilt/$ANDROID_ABI"
FFMPEG_LIBS="libavcodec.so libavfilter.so libavutil.so libswscale.so"
