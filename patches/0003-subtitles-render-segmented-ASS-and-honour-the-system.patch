--- /dev/null
+++ b/app/src/test/java/kr/dcmys/komorebi/ass/AssFeedTest.kt
@@ -0,0 +1,168 @@
+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssFeedTest {
+
+    private val base = "https://cdn.example.com/arib_ass/"
+    private val t0 = 1_800_000_000_000L
+
+    private fun line(start: String, text: String) =
+        "[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n" +
+            "Dialogue: 0,$start,,Default,,0,0,0,,$text\n"
+
+    /** A playlist of 5 s segments named by [names]; segment i starts at t0 + startIndex*5 s + i*5 s. */
+    private fun playlist(names: List<String>, startIndex: Int, boundaryAt: String? = null): AssMediaPlaylist {
+        val sb = StringBuilder("#EXTM3U\n#EXT-X-TARGETDURATION:5\n#EXT-X-MAP:URI=\"init.ass\"\n")
+        names.forEachIndexed { i, n ->
+            if (n == boundaryAt) sb.append("#EXT-X-DISCONTINUITY\n#EXT-X-MAP:URI=\"init2.ass\"\n")
+            val pdt = t0 + (startIndex + i) * 5_000L
+            sb.append("#EXTINF:5.000000,\n#EXT-X-PROGRAM-DATE-TIME:").append(iso(pdt)).append('\n').append(n).append('\n')
+        }
+        return AssPlaylistParser.parse(sb.toString(), base + "stream.m3u8")
+    }
+
+    private fun iso(ms: Long): String {
+        val f = java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", java.util.Locale.US)
+        f.timeZone = java.util.TimeZone.getTimeZone("UTC")
+        return f.format(java.util.Date(ms))
+    }
+
+    private val files = mapOf(
+        "a.ass" to line("0:00:02.00", "carried"), // t0 + 2 s, still on screen in c
+        "b.ass" to "[Events]\n",
+        "c.ass" to line("0:00:03.00", "next"), // t0 + 13 s
+        "d.ass" to "[Events]\n",
+    )
+
+    @Test
+    fun refreshKeepsPredecessorLearnedEarlier() {
+        val index = AssSegmentIndex()
+        index.ingest(playlist(listOf("a.ass", "b.ass", "c.ass"), 0))
+        index.ingest(playlist(listOf("b.ass", "c.ass", "d.ass"), 1))
+        assertEquals(base + "a.ass", index[base + "b.ass"]!!.prev)
+        assertEquals(base + "b.ass", index[base + "c.ass"]!!.prev)
+        assertEquals(base + "d.ass", index.nextOf(base + "c.ass")!!.uri)
+        assertEquals(4, index.size)
+        assertEquals(base + "c.ass", index.segmentAt(t0 + 12_000L)!!.uri)
+        assertNull(index.segmentAt(t0 - 1L))
+        assertNull(index.segmentAt(t0 + 60_000L))
+    }
+
+    @Test
+    fun indexIsBounded() {
+        val index = AssSegmentIndex(limit = 3)
+        index.ingest(playlist(listOf("a.ass", "b.ass", "c.ass", "d.ass", "e.ass"), 0))
+        assertEquals(3, index.size)
+        assertNull(index[base + "a.ass"])
+    }
+
+    @Test
+    fun backfillLooksBackUntilASegmentWithACaption() {
+        val index = AssSegmentIndex()
+        index.ingest(playlist(listOf("a.ass", "b.ass", "c.ass"), 0))
+        index.ingest(playlist(listOf("b.ass", "c.ass", "d.ass"), 1))
+
+        val fetched = ArrayList<String>()
+        val chain = AssBackfill.chain(index, base + "c.ass")
+        val found = AssBackfill.collect(chain, { u -> fetched += u.substringAfterLast('/'); files[u.substringAfterLast('/')] }, { false })!!
+        assertEquals(listOf("b.ass", "a.ass"), fetched)
+        assertEquals(listOf("a.ass", "b.ass"), found.map { it.first.uri.substringAfterLast('/') })
+
+        val timeline = AssTimeline()
+        timeline.addSegment(AssSegmentParser.parseDialogueLines(files.getValue("c.ass"), index[base + "c.ass"]!!.startMs))
+        for ((link, text) in found) timeline.addSegment(AssSegmentParser.parseDialogueLines(text, link.startMs))
+        val carried = timeline.resolve().single { it.dialogue.text == "carried" }
+        assertEquals(t0 + 2_000L, carried.startMs)
+        assertEquals(11_000L, carried.endMs - carried.startMs)
+    }
+
+    @Test
+    fun backfillDoesNotLookIntoThePreviousProgram() {
+        val index = AssSegmentIndex()
+        index.ingest(playlist(listOf("a.ass", "b.ass", "c.ass"), 0, boundaryAt = "c.ass"))
+        assertTrue(index[base + "c.ass"]!!.boundary)
+        assertEquals(base + "init2.ass", index[base + "c.ass"]!!.mapUri)
+        assertEquals(base + "init.ass", index[base + "b.ass"]!!.mapUri)
+        assertTrue(AssBackfill.chain(index, base + "c.ass").isEmpty())
+        index.ingest(playlist(listOf("a.ass", "b.ass", "c.ass", "d.ass"), 0, boundaryAt = "c.ass"))
+        assertEquals(listOf(base + "c.ass"), AssBackfill.chain(index, base + "d.ass").map { it.uri })
+    }
+
+    @Test
+    fun backfillIsBoundedAndCancellable() {
+        val index = AssSegmentIndex()
+        val names = (0 until 20).map { "s$it.ass" }
+        index.ingest(playlist(names, 0))
+        val chain = AssBackfill.chain(index, base + "s19.ass")
+        assertEquals(AssBackfill.MAX_SEGMENTS, chain.size)
+        assertEquals(base + "s18.ass", chain.first().uri)
+        var calls = 0
+        assertNull(AssBackfill.collect(chain, { calls++; "[Events]\n" }, { calls >= 2 }))
+        assertEquals(2, calls)
+        assertTrue(AssBackfill.collect(chain, { null }, { false })!!.isEmpty())
+    }
+
+    @Test
+    fun plannerFetchesNearThePositionOnly() {
+        val index = AssSegmentIndex()
+        val names = (0 until 120).map { "s$it.ass" }
+        index.ingest(playlist(names, 0))
+        val planner = AssFeedPlanner(index)
+
+        val now = t0 + 50 * 5_000L + 1_000L // inside s50
+        val first = planner.plan(now)
+        assertTrue(first is AssFeedStep.Restart)
+        assertEquals(base + "s50.ass", (first as AssFeedStep.Restart).link.uri)
+        planner.markAppended(first.link)
+
+        val appended = ArrayList<String>()
+        while (true) {
+            val step = planner.plan(now)
+            if (step !is AssFeedStep.Append) {
+                assertEquals(AssFeedStep.Idle, step)
+                break
+            }
+            appended += step.link.uri.substringAfterLast('/')
+            planner.markAppended(step.link)
+        }
+        assertEquals(listOf("s51.ass", "s52.ass"), appended)
+
+        assertEquals(AssFeedStep.Idle, planner.plan(now - 500L))
+        val back = planner.plan(t0 + 10 * 5_000L)
+        assertTrue(back is AssFeedStep.Restart)
+        assertEquals(base + "s10.ass", (back as AssFeedStep.Restart).link.uri)
+    }
+
+    @Test
+    fun plannerDropsWhenPlaybackLeavesTheRangeWithNoSegmentThere() {
+        val index = AssSegmentIndex()
+        index.ingest(playlist(listOf("a.ass", "b.ass"), 0))
+        val planner = AssFeedPlanner(index)
+        val start = planner.plan(t0 + 1_000L) as AssFeedStep.Restart
+        planner.markAppended(start.link)
+        assertEquals(AssFeedStep.Drop, planner.plan(t0 + 3_600_000L))
+        assertEquals(AssFeedStep.Idle, planner.plan(t0 + 3_600_000L))
+    }
+
+    @Test
+    fun trimmedRangeForcesRestartOnSeekBack() {
+        val index = AssSegmentIndex()
+        index.ingest(playlist((0 until 40).map { "s$it.ass" }, 0))
+        val planner = AssFeedPlanner(index)
+        var now = t0 + 1_000L
+        planner.markAppended((planner.plan(now) as AssFeedStep.Restart).link)
+        for (i in 1..30) {
+            now = t0 + i * 5_000L + 1_000L
+            while (true) {
+                val step = planner.plan(now) as? AssFeedStep.Append ?: break
+                planner.markAppended(step.link)
+            }
+        }
+        planner.trimRangeStart(now - 60_000L)
+        assertTrue(planner.plan(t0 + 2_000L) is AssFeedStep.Restart)
+    }
+}
