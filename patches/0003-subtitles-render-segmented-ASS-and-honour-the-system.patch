diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssLibassRenderer.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssLibassRenderer.kt
new file mode 100644
index 0000000..33c8f82
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssLibassRenderer.kt
@@ -0,0 +1,258 @@
+package kr.dcmys.komorebi.ass
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.os.Handler
+import android.os.HandlerThread
+import android.util.Log
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.asImageBitmap
+import io.github.peerless2012.ass.Ass
+import io.github.peerless2012.ass.AssRender
+import io.github.peerless2012.ass.AssTexType
+import io.github.peerless2012.ass.AssTrack
+import java.io.IOException
+
+internal class AssRenderedFrame(
+    val image: ImageBitmap,
+    val left: Int,
+    val top: Int,
+    val frameWidth: Int,
+    val frameHeight: Int,
+)
+
+/**
+ * Runs every libass call on one dedicated thread (including the slow fontconfig scan in
+ * `createRender`) so the UI thread never waits on the library lock.
+ *
+ * The track is rebuilt from the event snapshot on each change (ass-kt has no per-event update);
+ * libass drops a chunk whose ReadOrder it has already seen, so each rebuild uses fresh numbers.
+ */
+internal class AssLibassRenderer(
+    context: Context,
+    private val onFrame: (AssRenderedFrame?) -> Unit,
+) {
+    private val appContext = context.applicationContext
+    private val thread = HandlerThread("AssLibass").apply { start() }
+    private val handler = Handler(thread.looper)
+
+    // State below is only touched on [thread].
+    private var ass: Ass? = null
+    private var render: AssRender? = null
+    private var track: AssTrack? = null
+    private var trackHeader: String? = null
+    private var trackBorder: AssBorderMode? = null
+    private var border = AssBorderMode.AUTHORED
+
+    private var trackEvents: List<AssResolvedEvent> = emptyList()
+    private var fontFamily: String? = null
+    private var readOrder = 0
+    private var frameWidth = 0
+    private var frameHeight = 0
+    private var showing = false
+
+    @Volatile
+    private var pendingTimeMs = 0L
+    private val renderRunnable = Runnable { renderNow(pendingTimeMs) }
+
+    init {
+        handler.post { initLibass() }
+    }
+
+    private fun initLibass() {
+        try {
+            val library = Ass()
+            // Memory fonts must be added before the renderer is created (ass_set_fonts loads them).
+            fontFamily = if (addAribFont(library)) ARIB_FONT_FAMILY else null
+            ass = library
+            render = library.createRender()
+        } catch (t: Throwable) {
+            // Missing native library or libass failure: captions are simply not drawn.
+            Log.w(TAG, "libass unavailable", t)
+            ass = null
+            render = null
+        }
+    }
+
+    private fun addAribFont(library: Ass): Boolean = try {
+        val bytes = appContext.assets.open(ARIB_FONT_ASSET).use { it.readBytes() }
+        library.addFont(ARIB_FONT_ASSET.substringAfterLast('/'), bytes)
+        true
+    } catch (e: IOException) {
+        // The build copies the font into assets; without it libass falls back to system fonts.
+        Log.w(TAG, "ARIB font asset missing; using system fonts", e)
+        false
+    }
+
+    fun submit(header: String?, events: List<AssResolvedEvent>) {
+        handler.post { applyEvents(header, events) }
+    }
+
+    private fun applyEvents(header: String?, events: List<AssResolvedEvent>) {
+        val library = ass ?: return
+        val renderer = render ?: return
+        if (header == null) {
+            trackEvents = emptyList()
+            track?.clearEvent()
+            return
+        }
+        trackEvents = events
+        val old = track
+        val t: AssTrack
+        if (old == null || header !== trackHeader || border != trackBorder || readOrder > MAX_READ_ORDER) {
+            t = library.createTrack()
+            t.readBuffer(AssScript.prepareHeader(header, fontFamily, border).toByteArray(Charsets.UTF_8))
+            renderer.setTrack(t)
+            old?.release()
+            track = t
+            trackHeader = header
+            trackBorder = border
+            readOrder = 0
+        } else {
+            t = old
+            t.clearEvent()
+        }
+        for (ev in events) {
+            val d = ev.dialogue
+            if (AssScript.cleanText(d.text).isEmpty()) continue // a "clear" row draws nothing
+            val chunk = AssScript.chunkLine(++readOrder, d).toByteArray(Charsets.UTF_8)
+            t.readChunk(ev.startMs, ev.endMs - ev.startMs, chunk)
+        }
+    }
+
+    /** Runs after any render already queued, so a late picture of the old content is never published after the null this emits. */
+    fun clear() {
+        handler.post {
+            trackEvents = emptyList()
+            resetChangeDetection()
+            track?.clearEvent()
+            showing = false
+            onFrame(null)
+        }
+    }
+
+    /**
+     * Makes libass forget its previous picture so identical captions fed again (A -> B -> A zap) are
+     * reported as changed. libass only updates that list when the track has events (ass_start_frame
+     * bails out on an empty one), hence one render with an inactive placeholder event.
+     */
+    private fun resetChangeDetection() {
+        val t = track ?: return
+        val renderer = render ?: return
+        if (frameWidth <= 0 || frameHeight <= 0) return
+        try {
+            t.clearEvent()
+            t.readChunk(0L, 1L, "${++readOrder},0,Default,,0,0,0,,".toByteArray(Charsets.UTF_8))
+            renderer.renderFrame(2L, AssTexType.BITMAP_RGBA)
+        } catch (e: Throwable) {
+            Log.w(TAG, "libass change-detection reset failed", e)
+        }
+    }
+
+    fun setBorderMode(mode: AssBorderMode) {
+        handler.post {
+            if (mode == border) return@post
+            border = mode
+            val header = trackHeader
+            if (track != null && header != null) applyEvents(header, trackEvents)
+        }
+    }
+
+    fun setFrameSize(width: Int, height: Int) {
+        handler.post {
+            frameWidth = width
+            frameHeight = height
+            render?.setFrameSize(width, height)
+            render?.setStorageSize(width, height)
+        }
+    }
+
+    /** Render at libass time [timeMs] (epoch ms); coalesces with a request not yet started. */
+    fun requestRender(timeMs: Long) {
+        pendingTimeMs = timeMs
+        handler.removeCallbacks(renderRunnable)
+        handler.post(renderRunnable)
+    }
+
+    private fun renderNow(timeMs: Long) {
+        val renderer = render ?: return
+        if (track == null || frameWidth <= 0 || frameHeight <= 0) return
+        val frame = try {
+            renderer.renderFrame(timeMs, AssTexType.BITMAP_RGBA)
+        } catch (t: Throwable) {
+            Log.w(TAG, "renderFrame failed", t)
+            null
+        }
+        // ass-kt returns null when libass produced no image at all, and a frame with
+        // changed == 0 (no images) when the picture is identical to the previous call.
+        if (frame != null && frame.changed == 0) return
+        val images = frame?.images
+
+        if (images.isNullOrEmpty()) {
+            if (showing) {
+                showing = false
+                onFrame(null)
+            }
+            return
+        }
+        var left = Int.MAX_VALUE
+        var top = Int.MAX_VALUE
+        var right = Int.MIN_VALUE
+        var bottom = Int.MIN_VALUE
+        for (tex in images) {
+            if (tex.bitmap == null || tex.w <= 0 || tex.h <= 0) continue
+            left = minOf(left, tex.x)
+            top = minOf(top, tex.y)
+            right = maxOf(right, tex.x + tex.w)
+            bottom = maxOf(bottom, tex.y + tex.h)
+        }
+        if (right <= left || bottom <= top) {
+            if (showing) {
+                showing = false
+                onFrame(null)
+            }
+            return
+        }
+        // Allocated only when the picture changes; the previous one may still be on screen.
+        val picture = Bitmap.createBitmap(right - left, bottom - top, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(picture)
+        for (tex in images) {
+            val bitmap = tex.bitmap ?: continue
+            canvas.drawBitmap(bitmap, (tex.x - left).toFloat(), (tex.y - top).toFloat(), null)
+            bitmap.recycle()
+        }
+        showing = true
+        onFrame(AssRenderedFrame(picture.asImageBitmap(), left, top, frameWidth, frameHeight))
+    }
+
+    fun release() {
+        handler.removeCallbacks(renderRunnable)
+        handler.post {
+            try {
+                render?.release()
+                track?.release()
+                ass?.release()
+            } catch (t: Throwable) {
+                Log.w(TAG, "libass release failed", t)
+            }
+            render = null
+            track = null
+            ass = null
+            thread.quitSafely()
+        }
+    }
+
+    companion object {
+        private const val TAG = "AssLibassRenderer"
+
+        /** Placed by the build (downloaded; not in the source tree). */
+        const val ARIB_FONT_ASSET = "fonts/WLCMARU2004ARIBU.TTF"
+
+        /** Family name inside that TTF; also the Fontname init.ass styles use. */
+        const val ARIB_FONT_FAMILY = "WadaLabChuMaruGo2004ARIB"
+
+        /** Recreate the track before libass's ReadOrder bitmap grows large. */
+        private const val MAX_READ_ORDER = 200_000
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssPlaylist.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssPlaylist.kt
new file mode 100644
index 0000000..aa414e5
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssPlaylist.kt
@@ -0,0 +1,127 @@
+package kr.dcmys.komorebi.ass
+
+import java.net.URI
+
+data class AssPlaylistSegment(
+    val uri: String,
+    val durationMs: Long,
+    /** Epoch ms of segment-local time 0 (EXT-X-PROGRAM-DATE-TIME, or extrapolated); null if none. */
+    val startMs: Long?,
+    val mapUri: String?,
+    val discontinuity: Boolean,
+)
+
+data class AssMediaPlaylist(
+    val targetDurationMs: Long,
+    val segments: List<AssPlaylistSegment>,
+    val endList: Boolean,
+) {
+    val isAss: Boolean
+        get() = segments.any { isAssPath(it.mapUri) || isAssPath(it.uri) }
+
+    private fun isAssPath(uri: String?): Boolean =
+        uri != null && uri.substringBefore('?').substringBefore('#').endsWith(".ass", ignoreCase = true)
+}
+
+object AssPlaylistParser {
+
+    private const val DEFAULT_TARGET_DURATION_MS = 5_000L
+    private val MAP_URI = Regex("""^#EXT-X-MAP:.*?URI="([^"]+)"""", RegexOption.IGNORE_CASE)
+    private val PDT = Regex(
+        """^(\d{4})-(\d{2})-(\d{2})[Tt ](\d{2}):(\d{2}):(\d{2})(?:\.(\d+))?\s*(Z|z|[+-]\d{2}(?::?\d{2})?)?$""",
+    )
+
+    fun parse(text: String, playlistUrl: String): AssMediaPlaylist {
+        var targetDurationMs = DEFAULT_TARGET_DURATION_MS
+        var currentMap: String? = null
+        var pendingDuration = 0L
+        var pendingPdt: Long? = null
+        var pendingDiscontinuity = false
+        var endList = false
+        val raw = ArrayList<AssPlaylistSegment>()
+
+        for (rawLine in text.removePrefix("\uFEFF").split('\n')) {
+            val line = rawLine.trim()
+            if (line.isEmpty()) continue
+            if (line.startsWith("#")) {
+                when {
+                    line.startsWith("#EXT-X-TARGETDURATION:", ignoreCase = true) ->
+                        line.substringAfter(':').trim().toDoubleOrNull()?.let {
+                            targetDurationMs = (it * 1000).toLong()
+                        }
+                    line.startsWith("#EXT-X-MAP:", ignoreCase = true) ->
+                        MAP_URI.find(line)?.let { currentMap = resolve(playlistUrl, it.groupValues[1]) }
+                    line.startsWith("#EXTINF:", ignoreCase = true) ->
+                        pendingDuration = ((line.substringAfter(':').substringBefore(',').trim()
+                            .toDoubleOrNull() ?: 0.0) * 1000).toLong()
+                    line.startsWith("#EXT-X-PROGRAM-DATE-TIME:", ignoreCase = true) ->
+                        pendingPdt = parseProgramDateTimeMs(line.substringAfter(':'))
+                    line.equals("#EXT-X-DISCONTINUITY", ignoreCase = true) ->
+                        pendingDiscontinuity = true
+                    line.equals("#EXT-X-ENDLIST", ignoreCase = true) -> endList = true
+                }
+                continue
+            }
+            raw += AssPlaylistSegment(
+                uri = resolve(playlistUrl, line),
+                durationMs = pendingDuration,
+                startMs = pendingPdt,
+                mapUri = currentMap,
+                discontinuity = pendingDiscontinuity,
+            )
+            pendingDuration = 0L
+            pendingPdt = null
+            pendingDiscontinuity = false
+        }
+        return AssMediaPlaylist(targetDurationMs, extrapolateStarts(raw), endList)
+    }
+
+    private fun extrapolateStarts(segments: List<AssPlaylistSegment>): List<AssPlaylistSegment> {
+        if (segments.none { it.startMs != null } || segments.all { it.startMs != null }) return segments
+        val starts = arrayOfNulls<Long>(segments.size)
+        for (i in segments.indices) {
+            starts[i] = segments[i].startMs
+                ?: if (i > 0) starts[i - 1]?.let { it + segments[i - 1].durationMs } else null
+        }
+        for (i in segments.indices.reversed()) {
+            if (starts[i] == null && i + 1 < segments.size) {
+                starts[i] = starts[i + 1]?.let { it - segments[i].durationMs }
+            }
+        }
+        return segments.mapIndexed { i, s -> if (s.startMs == starts[i]) s else s.copy(startMs = starts[i]) }
+    }
+
+    /** ISO-8601 date-time (offset `Z`, `+hh:mm`, `+hhmm`, `+hh`, or none = UTC) to epoch ms. */
+    fun parseProgramDateTimeMs(value: String): Long? {
+        val m = PDT.matchEntire(value.trim()) ?: return null
+        val g = m.groupValues
+        val days = daysFromCivil(g[1].toLong(), g[2].toInt(), g[3].toInt())
+        val millis = g[7].padEnd(3, '0').substring(0, 3).toLong()
+        var ms = ((days * 24 + g[4].toLong()) * 60 + g[5].toLong()) * 60_000L + g[6].toLong() * 1000 + millis
+        val offset = g[8]
+        if (offset.isNotEmpty() && offset != "Z" && offset != "z") {
+            val sign = if (offset[0] == '-') -1 else 1
+            val digits = offset.substring(1).replace(":", "")
+            val hours = digits.substring(0, 2).toLong()
+            val minutes = if (digits.length >= 4) digits.substring(2, 4).toLong() else 0L
+            ms -= sign * (hours * 60 + minutes) * 60_000L
+        }
+        return ms
+    }
+
+    private fun daysFromCivil(year: Long, month: Int, day: Int): Long {
+        val y = if (month <= 2) year - 1 else year
+        val era = (if (y >= 0) y else y - 399) / 400
+        val yoe = y - era * 400
+        val mp = (month + 9) % 12
+        val doy = (153 * mp + 2) / 5 + day - 1
+        val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
+        return era * 146_097 + doe - 719_468
+    }
+
+    fun resolve(base: String, reference: String): String = try {
+        URI(base).resolve(reference.trim()).toString()
+    } catch (e: Exception) {
+        reference.trim()
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssScript.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssScript.kt
new file mode 100644
index 0000000..095641f
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssScript.kt
@@ -0,0 +1,139 @@
+package kr.dcmys.komorebi.ass
+
+import kr.dcmys.komorebi.platform.SystemCaptionStyle
+
+object AssScript {
+
+    /** The `[Events]` format the libass track is given; Matroska-style chunks skip its first 3. */
+    const val EVENTS_FORMAT = "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"
+
+    /**
+     * Per-event overrides stripped before rendering: the producer's transparent outline
+     * (`\3a&Hff&`) and fixed `\bord3` would otherwise override the style's own border.
+     */
+    private val STRIPPED_OVERRIDES = Regex("""\{\\(3a&Hff&|bord3)\}""")
+
+    fun cleanText(text: String): String = STRIPPED_OVERRIDES.replace(text, "")
+
+    /**
+     * Prepares init.ass for libass: outline/back alpha forced opaque, every style's Fontname set to
+     * [fontFamily] (the registered ARIB font, also the fallback face), borders rewritten for [border].
+     */
+    fun prepareHeader(
+        header: String,
+        fontFamily: String?,
+        border: AssBorderMode = AssBorderMode.AUTHORED,
+    ): String {
+        val out = StringBuilder(header.length + 128)
+        var section = ""
+        var styleFields: List<String>? = null
+        for (raw in header.removePrefix("\uFEFF").replace("\r\n", "\n").split('\n')) {
+            val line = raw.trim()
+            if (line.startsWith("[") && line.endsWith("]")) {
+                section = line.substring(1, line.length - 1).trim()
+                if (section.equals("Events", ignoreCase = true)) continue
+            }
+            if (section.equals("Events", ignoreCase = true)) continue
+            val isStyles = section.equals("V4+ Styles", ignoreCase = true) ||
+                section.equals("V4 Styles", ignoreCase = true)
+            if (isStyles && line.startsWith("Format:", ignoreCase = true)) {
+                styleFields = line.substringAfter(':').split(',').map { it.trim() }
+            } else if (isStyles && line.startsWith("Style:", ignoreCase = true) && styleFields != null) {
+                out.append(rewriteStyle(line, styleFields, fontFamily, border)).append('\n')
+                continue
+            }
+            out.append(raw.trimEnd()).append('\n')
+        }
+        while (out.endsWith("\n\n")) out.setLength(out.length - 1)
+        out.append('\n').append("[Events]\n").append(EVENTS_FORMAT).append('\n')
+        return out.toString()
+    }
+
+    private fun rewriteStyle(
+        line: String,
+        fields: List<String>,
+        fontFamily: String?,
+        border: AssBorderMode,
+    ): String {
+        val values = line.substringAfter(':').split(',').map { it.trim() }.toMutableList()
+        for (i in fields.indices) {
+            if (i >= values.size) break
+            when {
+                fields[i].equals("Fontname", ignoreCase = true) && fontFamily != null -> values[i] = fontFamily
+                fields[i].equals("OutlineColour", ignoreCase = true) ||
+                    fields[i].equals("BackColour", ignoreCase = true) -> values[i] = opaque(values[i])
+            }
+        }
+        applyBorder(values, fields, border)
+        return "Style: " + values.joinToString(",")
+    }
+
+    private fun applyBorder(values: MutableList<String>, fields: List<String>, border: AssBorderMode) {
+        if (border == AssBorderMode.AUTHORED) return
+        val borderStyle = fields.indexOfFirst { it.equals("BorderStyle", ignoreCase = true) }
+        val outline = fields.indexOfFirst { it.equals("Outline", ignoreCase = true) }
+        val shadow = fields.indexOfFirst { it.equals("Shadow", ignoreCase = true) }
+        if (borderStyle !in values.indices || outline !in values.indices || shadow !in values.indices) return
+        when (border) {
+            AssBorderMode.AUTHORED -> Unit
+            AssBorderMode.OUTLINE -> {
+                values[borderStyle] = "1"; values[outline] = "2"; values[shadow] = "0"
+            }
+            AssBorderMode.SHADOW -> {
+                values[borderStyle] = "1"; values[outline] = "0"; values[shadow] = "1"
+            }
+            AssBorderMode.BOX_OUTLINE -> when (values[borderStyle].toDoubleOrNull()?.toInt()) {
+                // libass BorderStyle 4: per-event box in BackColour padded by Shadow; glyph
+                // outlines are drawn normally, glyph shadows never. Keep the box, add the outline.
+                4 -> values[outline] = "2"
+                1 -> { values[outline] = "2"; values[shadow] = "0" }
+                // BorderStyle 3 draws its box from the outline itself: nothing to add.
+                else -> Unit
+            }
+        }
+    }
+
+    /**
+     * Only the presentational parts of the system caption style are honoured. Nothing customised,
+     * or background kept with a drop shadow, stays [AssBorderMode.AUTHORED]: a BorderStyle 4 box
+     * suppresses glyph shadows, and the shadow colour is the box colour.
+     */
+    fun borderModeFor(style: SystemCaptionStyle): AssBorderMode = when {
+        style.transparentBackground && style.edge == SystemCaptionStyle.Edge.DROP_SHADOW -> AssBorderMode.SHADOW
+        style.transparentBackground -> AssBorderMode.OUTLINE
+        style.edge == SystemCaptionStyle.Edge.OUTLINE -> AssBorderMode.BOX_OUTLINE
+        else -> AssBorderMode.AUTHORED
+    }
+
+    /** `&HAABBGGRR` (or decimal) with the alpha byte cleared; unparsable values are kept. */
+    fun opaque(colour: String): String {
+        val v = colour.trim()
+        val parsed = if (v.startsWith("&H", ignoreCase = true)) {
+            v.substring(2).trimEnd('&').toLongOrNull(16)
+        } else {
+            v.toLongOrNull()
+        } ?: return colour
+        return "&H%08X".format(parsed and 0x00FFFFFFL)
+    }
+
+    /** One Matroska-style chunk for `ass_process_chunk`: ReadOrder, Layer, then fields from Style. */
+    fun chunkLine(readOrder: Int, d: AssDialogue): String =
+        "$readOrder,${d.layer},${d.style},${d.name},${d.marginL},${d.marginR},${d.marginV},${d.effect},${cleanText(d.text)}"
+
+    /**
+     * Wall-clock (epoch ms) of the playback position; a positive [offsetMs] shows captions later.
+     * Callers check `windowStartTimeMs != C.TIME_UNSET` first. Primitive-only: used once per frame.
+     */
+    fun playbackWallClockMs(windowStartTimeMs: Long, positionMs: Long, offsetMs: Long): Long =
+        windowStartTimeMs + positionMs - offsetMs
+}
+
+enum class AssBorderMode {
+    AUTHORED,
+
+    OUTLINE,
+
+    SHADOW,
+
+    BOX_OUTLINE,
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentIndex.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentIndex.kt
new file mode 100644
index 0000000..e015b34
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentIndex.kt
@@ -0,0 +1,190 @@
+package kr.dcmys.komorebi.ass
+
+data class AssSegmentLink(
+    val uri: String,
+    /** Epoch ms of the segment's local time 0. */
+    val startMs: Long,
+    val durationMs: Long,
+    val prev: String?,
+    val prevDurationMs: Long,
+    val boundary: Boolean,
+    val mapUri: String?,
+) {
+    val endMs: Long get() = startMs + durationMs
+}
+
+/** De-duplicated by URL, bounded by [limit]. Not thread-safe; owned by a single thread. */
+class AssSegmentIndex(private val limit: Int = DEFAULT_LIMIT) {
+
+    private val links = LinkedHashMap<String, AssSegmentLink>()
+    private val nextByUri = HashMap<String, String>()
+
+    var targetDurationMs: Long = 5_000L
+        private set
+
+    val size: Int get() = links.size
+
+    operator fun get(uri: String): AssSegmentLink? = links[uri]
+
+    fun clear() {
+        links.clear()
+        nextByUri.clear()
+    }
+
+    fun ingest(playlist: AssMediaPlaylist) {
+        if (playlist.targetDurationMs > 0) targetDurationMs = playlist.targetDurationMs
+        var prev: AssPlaylistSegment? = null
+        for (seg in playlist.segments) {
+            val start = seg.startMs
+            if (start == null) {
+                prev = null // cannot place it on the wall clock
+                continue
+            }
+            // The playlist's first segment has no known predecessor; keep one learned earlier.
+            if (prev != null || !links.containsKey(seg.uri)) {
+                links[seg.uri] = AssSegmentLink(
+                    uri = seg.uri,
+                    startMs = start,
+                    durationMs = seg.durationMs,
+                    prev = prev?.uri,
+                    prevDurationMs = prev?.durationMs ?: 0L,
+                    boundary = seg.discontinuity,
+                    mapUri = seg.mapUri,
+                )
+            }
+            if (prev != null) nextByUri[prev.uri] = seg.uri
+            prev = seg
+        }
+        val it = links.keys.iterator()
+        while (links.size > limit && it.hasNext()) {
+            nextByUri.remove(it.next())
+            it.remove()
+        }
+    }
+
+    fun nextOf(uri: String): AssSegmentLink? = nextByUri[uri]?.let { links[it] }
+
+    fun segmentAt(t: Long): AssSegmentLink? {
+        var best: AssSegmentLink? = null
+        for (link in links.values) {
+            if (link.startMs <= t && (best == null || link.startMs > best.startMs)) best = link
+        }
+        val found = best ?: return null
+        return if (t < found.startMs + maxOf(found.durationMs, targetDurationMs)) found else null
+    }
+
+    companion object {
+        const val DEFAULT_LIMIT = 2_000
+    }
+}
+
+sealed class AssFeedStep {
+    object Idle : AssFeedStep()
+
+    /** Playback left the fetched range and no segment covers it yet: drop the captions. */
+    object Drop : AssFeedStep()
+
+    /** Not continuing the last segment: drop captions, append [link], then backfill before it. */
+    data class Restart(val link: AssSegmentLink) : AssFeedStep()
+
+    data class Append(val link: AssSegmentLink) : AssFeedStep()
+}
+
+/**
+ * Fetches only segments near the playback position: the one holding it and up to
+ * [lookaheadSegments] target durations past it. A seek inside the fetched range keeps the captions;
+ * one outside it drops them and restarts (with backfill) at the new position.
+ */
+class AssFeedPlanner(
+    private val index: AssSegmentIndex,
+    private val lookaheadSegments: Int = 2,
+) {
+    private var rangeStartMs = 0L
+    var lastAppended: AssSegmentLink? = null
+        private set
+
+    fun reset() {
+        lastAppended = null
+    }
+
+    fun markAppended(link: AssSegmentLink) {
+        if (lastAppended == null) rangeStartMs = link.startMs
+        lastAppended = link
+    }
+
+    /** Captions before [cutoffMs] were pruned: a seek back there must restart. */
+    fun trimRangeStart(cutoffMs: Long) {
+        if (cutoffMs > rangeStartMs) rangeStartMs = cutoffMs
+    }
+
+    fun plan(nowMs: Long): AssFeedStep {
+        val last = lastAppended
+        if (last != null) {
+            if (nowMs >= rangeStartMs && nowMs < last.endMs + index.targetDurationMs) {
+                val next = index.nextOf(last.uri) ?: return AssFeedStep.Idle
+                val horizon = nowMs + lookaheadSegments * index.targetDurationMs
+                return if (next.startMs <= horizon) AssFeedStep.Append(next) else AssFeedStep.Idle
+            }
+            val current = index.segmentAt(nowMs)
+            reset()
+            return if (current != null) AssFeedStep.Restart(current) else AssFeedStep.Drop
+        }
+        return index.segmentAt(nowMs)?.let { AssFeedStep.Restart(it) } ?: AssFeedStep.Idle
+    }
+}
+
+/**
+ * Backfill after a restart: a caption without an End that started in an earlier segment may still
+ * be on screen. Walks back up to [MAX_SEGMENTS] segments, stopping at a program boundary or at the
+ * first segment holding a Dialogue.
+ */
+object AssBackfill {
+    const val MAX_SEGMENTS = 12
+
+    /**
+     * The segments before [startUri], newest first, that a backfill may fetch. Stops before
+     * stepping back out of a program's first segment. Reads [index]; call on its owner thread.
+     */
+    fun chain(index: AssSegmentIndex, startUri: String): List<AssSegmentLink> {
+        val out = ArrayList<AssSegmentLink>()
+        var link = index[startUri]
+        while (out.size < MAX_SEGMENTS) {
+            val current = link ?: break
+            val prevUri = current.prev ?: break
+            if (current.boundary) break
+            val prevLink = index[prevUri] ?: AssSegmentLink(
+                uri = prevUri,
+                startMs = current.startMs - current.prevDurationMs,
+                durationMs = current.prevDurationMs,
+                prev = null,
+                prevDurationMs = 0L,
+                boundary = false,
+                mapUri = current.mapUri,
+            )
+            out += prevLink
+            link = prevLink
+        }
+        return out
+    }
+
+    /**
+     * Fetch along [chain] until a segment holds a Dialogue. Returns the fetched segments
+     * oldest-first, or null when [cancelled] (a drop happened meanwhile; discard the result).
+     * [fetch] blocks and returns null on failure, which ends the walk. Thread-agnostic.
+     */
+    fun collect(
+        chain: List<AssSegmentLink>,
+        fetch: (String) -> String?,
+        cancelled: () -> Boolean,
+    ): List<Pair<AssSegmentLink, String>>? {
+        val found = ArrayList<Pair<AssSegmentLink, String>>()
+        for (link in chain) {
+            val text = fetch(link.uri)
+            if (cancelled()) return null
+            if (text == null) break
+            found.add(0, link to text)
+            if (AssSegmentParser.containsDialogue(text)) break
+        }
+        return found
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentParser.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentParser.kt
new file mode 100644
index 0000000..c617c4f
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssSegmentParser.kt
@@ -0,0 +1,99 @@
+package kr.dcmys.komorebi.ass
+
+/** One Dialogue line, rebased to epoch ms. [endMs] is null when End is empty: the caption closes at the next caption start on any row (see [AssTimeline]). */
+data class AssDialogue(
+    val startMs: Long,
+    val endMs: Long?,
+    val layer: Int,
+    val style: String,
+    val name: String,
+    val marginL: Int,
+    val marginR: Int,
+    val marginV: Int,
+    val effect: String,
+    val text: String,
+)
+
+/**
+ * Each segment restarts its clock at 0 and carries its own `Format:` line, so Dialogue fields are
+ * read by name from it; the last format field keeps any commas.
+ */
+object AssSegmentParser {
+
+    private val TIME = Regex("""^(\d+):(\d{2}):(\d{2})(?:\.(\d{1,3}))?$""")
+    private val DIALOGUE_LINE = Regex("""^Dialogue:""", setOf(RegexOption.IGNORE_CASE, RegexOption.MULTILINE))
+
+    fun parseAssTimeMs(value: String): Long? {
+        val m = TIME.matchEntire(value.trim()) ?: return null
+        val frac = (m.groupValues[4]).padEnd(3, '0').substring(0, 3)
+        return m.groupValues[1].toLong() * 3_600_000L +
+            m.groupValues[2].toLong() * 60_000L +
+            m.groupValues[3].toLong() * 1_000L +
+            frac.toLong()
+    }
+
+    fun containsDialogue(text: String): Boolean = DIALOGUE_LINE.containsMatchIn(text)
+
+    fun parseDialogueLines(text: String, segmentStartMs: Long): List<AssDialogue> {
+        val out = ArrayList<AssDialogue>()
+        var section: String? = null
+        var fields: List<String>? = null
+
+        for (raw in text.removePrefix("\uFEFF").replace("\r\n", "\n").split('\n')) {
+            val line = raw.trim()
+            if (line.isEmpty()) continue
+            if (line.startsWith("[") && line.endsWith("]")) {
+                section = line.substring(1, line.length - 1)
+                continue
+            }
+            if (section != "Events") continue
+
+            if (line.startsWith("Format:", ignoreCase = true)) {
+                fields = line.substring(line.indexOf(':') + 1).split(',').map { it.trim() }
+                continue
+            }
+            val names = fields ?: continue
+            if (!line.startsWith("Dialogue:", ignoreCase = true)) continue
+
+            val parts = splitFields(line.substring(line.indexOf(':') + 1), names.size)
+            val row = HashMap<String, String>(names.size * 2)
+            for (i in names.indices) row[names[i]] = (parts.getOrNull(i) ?: "").trim()
+
+            val relStart = parseAssTimeMs(row["Start"] ?: "")
+            val endRaw = row["End"] ?: ""
+            val relEnd = if (endRaw.isEmpty()) null else parseAssTimeMs(endRaw)
+
+            out += AssDialogue(
+                startMs = segmentStartMs + (relStart ?: 0L),
+                endMs = relEnd?.let { segmentStartMs + it },
+                layer = num(row["Layer"]),
+                style = row["Style"] ?: "",
+                name = row["Name"] ?: "",
+                marginL = num(row["MarginL"]),
+                marginR = num(row["MarginR"]),
+                marginV = num(row["MarginV"]),
+                effect = row["Effect"] ?: "",
+                text = row["Text"] ?: "",
+            )
+        }
+        return out
+    }
+
+    private fun num(value: String?): Int = value?.trim()?.toDoubleOrNull()?.toInt() ?: 0
+
+    private fun splitFields(body: String, count: Int): List<String> {
+        val parts = ArrayList<String>(count)
+        var start = 0
+        for (i in 0 until count - 1) {
+            val comma = body.indexOf(',', start)
+            if (comma == -1) {
+                parts += body.substring(start)
+                return parts
+            }
+            parts += body.substring(start, comma)
+            start = comma + 1
+        }
+        parts += body.substring(start)
+        return parts
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssSubtitleController.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssSubtitleController.kt
