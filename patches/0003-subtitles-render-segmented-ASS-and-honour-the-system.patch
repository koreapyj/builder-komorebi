+++ b/app/src/test/java/kr/dcmys/komorebi/ass/AssTimelineTest.kt
@@ -0,0 +1,154 @@
+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssTimelineTest {
+
+    private fun line(start: String, text: String, end: String = "") =
+        "[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n" +
+            "Dialogue: 0,$start,$end,Default,,0,0,0,,$text\n"
+
+    private fun seg(timeline: AssTimeline, startSec: Int, text: String) =
+        timeline.addSegment(AssSegmentParser.parseDialogueLines(text, startSec * 1000L))
+
+    private fun AssTimeline.byText(text: String) = resolve().single { it.dialogue.text == text }
+
+    @Test
+    fun previousCaptionEndsWhereTheNextSegmentsCaptionStarts() {
+        val t = AssTimeline()
+        seg(t, 100, line("0:00:00.00", "first"))
+        val open = t.byText("first")
+        assertTrue(open.open)
+        assertEquals(100_000L + AssTimeline.OPEN_DURATION_MS, open.endMs)
+
+        seg(t, 102, line("0:00:00.00", "second"))
+        val closed = t.byText("first")
+        assertEquals(2_000L, closed.endMs - closed.startMs)
+        assertTrue(!closed.open)
+    }
+
+    @Test
+    fun rowsSharingAStartCloseTogetherAndAClearRowIsAStart() {
+        val t = AssTimeline()
+        val two = "[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n" +
+            "Dialogue: 0,0:00:01.00,,Default,,0,0,0,,a\n" +
+            "Dialogue: 0,0:00:01.00,,Default,,0,0,0,,b\n"
+        seg(t, 10, two)
+        seg(t, 15, line("0:00:00.50", "")) // clear at 15.5 s
+        assertEquals(15_500L, t.byText("a").endMs)
+        assertEquals(15_500L, t.byText("b").endMs)
+    }
+
+    @Test
+    fun lateCaptionUsesAnAlreadyKnownClearTime() {
+        val t = AssTimeline()
+        seg(t, 110, line("0:00:00.00", ""))
+        seg(t, 108, line("0:00:00.00", "late"))
+        val late = t.byText("late")
+        assertEquals(2_000L, late.endMs - late.startMs)
+    }
+
+    @Test
+    fun discontinuityResetRetainsFollowingClearTime() {
+        val t = AssTimeline()
+        seg(t, 90, line("0:00:00.00", "old program"))
+        t.resetAt(100_000L)
+        seg(t, 100, line("0:00:00.00", "new program"))
+        seg(t, 102, line("0:00:00.00", ""))
+        val events = t.resolve()
+        assertTrue(events.none { it.dialogue.text == "old program" })
+        assertEquals(102_000L, t.byText("new program").endMs)
+    }
+
+    @Test
+    fun boundaryAppendedAheadIsResetOnlyWhenPlayed() {
+        val t = AssTimeline()
+        seg(t, 90, line("0:00:00.00", "outgoing"))
+        seg(t, 100, line("0:00:00.50", "incoming"))
+        seg(t, 105, line("0:00:01.00", ""))
+        assertEquals(100_500L, t.byText("outgoing").endMs)
+        t.resetAt(100_000L)
+        assertEquals(listOf("incoming", ""), t.resolve().map { it.dialogue.text }) // "" = clear row
+        assertEquals(106_000L, t.byText("incoming").endMs)
+    }
+
+    @Test
+    fun resetKeepsBoundariesAtOrAfterTheProgramStart() {
+        val t = AssTimeline()
+        seg(t, 102, line("0:00:00.00", "")) // clear known before the boundary segment arrives
+        t.resetAt(100_000L)
+        seg(t, 100, line("0:00:00.00", "x"))
+        assertEquals(102_000L, t.byText("x").endMs)
+    }
+
+    @Test
+    fun afterAClearThePastCaptionEndsAtTheNextPastCaption() {
+        val t = AssTimeline()
+        seg(t, 600, line("0:00:01.00", "live"))
+        t.clear()
+        assertTrue(t.resolve().isEmpty())
+        seg(t, 300, line("0:00:04.00", "past A"))
+        seg(t, 306, line("0:00:01.00", "past B"))
+        val a = t.byText("past A")
+        assertEquals(3_000L, a.endMs - a.startMs)
+        assertEquals(listOf("past A", "past B"), t.resolve().map { it.dialogue.text })
+    }
+
+    @Test
+    fun explicitEndIsKept() {
+        val t = AssTimeline()
+        seg(t, 0, line("0:00:01.00", "x", end = "0:00:02.00"))
+        seg(t, 0, line("0:00:05.00", "y"))
+        assertEquals(2_000L, t.byText("x").endMs)
+    }
+
+    @Test
+    fun pruneDropsFinishedEventsButKeepsCaptionStillOnScreen() {
+        val t = AssTimeline()
+        seg(t, 0, line("0:00:00.00", "gone"))
+        seg(t, 10, line("0:00:00.00", "showing"))
+        seg(t, 100, line("0:00:00.00", "next"))
+        val before = t.version
+        t.prune(50_000L)
+        assertEquals(listOf("showing", "next"), t.resolve().map { it.dialogue.text })
+        assertEquals(100_000L, t.byText("showing").endMs)
+        assertTrue(t.version != before)
+    }
+
+    @Test
+    fun versionMovesOnlyOnChange() {
+        val t = AssTimeline()
+        val v0 = t.version
+        t.addSegment(emptyList())
+        t.clear()
+        assertEquals(v0, t.version)
+        seg(t, 0, line("0:00:00.00", "x"))
+        assertTrue(t.version > v0)
+    }
+
+    @Test
+    fun scheduleChangesOnlyAtEventBoundaries() {
+        val t = AssTimeline()
+        seg(t, 10, line("0:00:00.00", "a"))
+        seg(t, 20, line("0:00:00.00", "b"))
+        val s = AssRenderSchedule(t.resolve())
+        assertEquals(Long.MIN_VALUE, s.stableFrom(5_000L))
+        assertEquals(10_000L, s.stableUntil(5_000L))
+        assertEquals(10_000L, s.stableFrom(15_000L))
+        assertEquals(20_000L, s.stableUntil(15_000L))
+        assertEquals(20_000L, s.stableFrom(20_000L))
+        assertEquals(20_000L + AssTimeline.OPEN_DURATION_MS, s.stableUntil(20_000L))
+    }
+
+    @Test
+    fun animatedEventRequestsEveryFrame() {
+        val t = AssTimeline()
+        seg(t, 10, line("0:00:00.00", "{\\fad(200,200)}a", end = "0:00:03.00"))
+        val s = AssRenderSchedule(t.resolve())
+        assertEquals(11_001L, s.stableUntil(11_000L))
+        assertEquals(10_000L, s.stableUntil(9_000L))
+        assertTrue(!AssRenderSchedule.isAnimated("{\\an7}{\\pos(60,449)}{\\fsp4}{\\fscx50}{\\fs36}x"))
+    }
+}
diff --git a/app/src/test/java/kr/dcmys/komorebi/ass/VideoRectTest.kt b/app/src/test/java/kr/dcmys/komorebi/ass/VideoRectTest.kt
