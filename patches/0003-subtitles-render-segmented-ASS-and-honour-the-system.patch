@@ -0,0 +1,105 @@
+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssSegmentParserTest {
+
+    private val format = "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"
+
+    @Test
+    fun consecutiveSegmentsRestartAtZeroAndEmptyEndIsOpen() {
+        val seg1 = """
+            [Events]
+            $format
+            Dialogue: 0,0:00:00.00,,Default,,0,0,0,,{\an7}{\pos(170,390)}それとも今は
+            Dialogue: 0,0:00:00.00,,Default,,0,0,0,,{\an7}{\pos(190,450)}ただの傭兵稼業に逆戻りかな？》
+        """.trimIndent()
+        val seg2 = """
+            [Events]
+            $format
+            Dialogue: 0,0:00:00.00,,Default,,0,0,0,,{\an7}{\pos(100,100)}次のセリフ
+        """.trimIndent()
+
+        val s1 = AssSegmentParser.parseDialogueLines(seg1, 0)
+        val s2 = AssSegmentParser.parseDialogueLines(seg2, 22_022)
+
+        assertEquals(2, s1.size)
+        assertTrue(s1.all { it.startMs == 0L })
+        assertTrue(s1.all { it.endMs == null })
+        assertTrue(s1[0].text.contains("{\\pos(170,390)}"))
+        assertEquals("Default", s1[0].style)
+        assertEquals(0, s1[0].layer)
+        assertEquals(1, s2.size)
+        assertEquals(22_022L, s2[0].startMs)
+
+        val timeline = AssTimeline()
+        timeline.addSegment(s1)
+        timeline.addSegment(s2)
+        assertEquals(22_022L, timeline.closingTimeOf(s1[0]))
+    }
+
+    @Test
+    fun explicitEndIsRespected() {
+        val text = "[Events]\n$format\nDialogue: 0,0:00:01.00,0:00:03.50,Default,,0,0,0,,hi"
+        val e = AssSegmentParser.parseDialogueLines(text, 0).single()
+        assertEquals(1_000L, e.startMs)
+        assertEquals(3_500L, e.endMs)
+    }
+
+    @Test
+    fun fieldsAreReadByNameFromTheSegmentsOwnFormatLine() {
+        val text = """
+            [Events]
+            Format: Start, End, Layer, Style, Name, MarginL, MarginR, MarginV, Effect, Text
+            Dialogue: 0:00:01.00,0:00:02.50,5,Sub,,0,0,0,,Hello, world {\pos(1,2)}
+        """.trimIndent()
+        val r = AssSegmentParser.parseDialogueLines(text, 0).single()
+        assertEquals(1_000L, r.startMs)
+        assertEquals(2_500L, r.endMs)
+        assertEquals(5, r.layer)
+        assertEquals("Sub", r.style)
+        assertEquals("Hello, world {\\pos(1,2)}", r.text)
+    }
+
+    @Test
+    fun parseAssTime() {
+        assertEquals(22_020L, AssSegmentParser.parseAssTimeMs("0:00:22.02"))
+        assertEquals(3_661_500L, AssSegmentParser.parseAssTimeMs("1:01:01.5"))
+        assertEquals(1_650L, AssSegmentParser.parseAssTimeMs("0:00:01.65"))
+        assertNull(AssSegmentParser.parseAssTimeMs(""))
+        assertNull(AssSegmentParser.parseAssTimeMs("garbage"))
+    }
+
+    @Test
+    fun measuredServerSegment() {
+        val text = "[Events]\r\n$format\r\n" +
+            "Dialogue: 0,0:00:03.58,,Default,,0,0,0,,{\\an7}{\\pos(60,449)}{\\fsp4}{\\bord3}{\\1c&H00ffff&}text\r\n" +
+            "Dialogue: 0,0:00:03.58,,Default,,0,0,0,,\r\n"
+        val events = AssSegmentParser.parseDialogueLines(text, 1_700_000_000_000L)
+        assertEquals(2, events.size)
+        assertEquals(1_700_000_003_580L, events[0].startMs)
+        assertNull(events[0].endMs)
+        assertEquals("{\\an7}{\\pos(60,449)}{\\fsp4}{\\bord3}{\\1c&H00ffff&}text", events[0].text)
+        assertEquals("", events[1].text)
+    }
+
+    @Test
+    fun emptySegmentAndBomAndDialogueDetection() {
+        assertTrue(AssSegmentParser.parseDialogueLines("[Events]\n$format\n", 0).isEmpty())
+        assertFalse(AssSegmentParser.containsDialogue("[Events]\n$format\n"))
+        val bom = "\uFEFF[Events]\n$format\nDialogue: 0,0:00:01.00,,Default,,0,0,0,,x"
+        assertEquals(1, AssSegmentParser.parseDialogueLines(bom, 0).size)
+        assertTrue(AssSegmentParser.containsDialogue(bom))
+    }
+
+    @Test
+    fun dialogueBeforeFormatOrOutsideEventsIsIgnored() {
+        val text = "[Script Info]\nDialogue: 0,0:00:01.00,,Default,,0,0,0,,x\n[Events]\n" +
+            "Dialogue: 0,0:00:01.00,,Default,,0,0,0,,y"
+        assertTrue(AssSegmentParser.parseDialogueLines(text, 0).isEmpty())
+    }
+}
diff --git a/app/src/test/java/kr/dcmys/komorebi/ass/AssTimelineTest.kt b/app/src/test/java/kr/dcmys/komorebi/ass/AssTimelineTest.kt
