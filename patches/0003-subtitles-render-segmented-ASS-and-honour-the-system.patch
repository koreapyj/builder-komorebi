@@ -0,0 +1,36 @@
+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class VideoRectTest {
+
+    @Test
+    fun unknownVideoSizeCoversTheView() {
+        assertEquals(1920 to 1080, fitVideoRect(1920, 1080, 0, 0, 1f))
+    }
+
+    @Test
+    fun wideVideoFills() {
+        assertEquals(1920 to 1080, fitVideoRect(1920, 1080, 1920, 1080, 1f))
+        // 1440x1080 with square pixels is treated as anamorphic 16:9 and stretched.
+        assertEquals(1920 to 1080, fitVideoRect(1920, 1080, 1440, 1080, 1f))
+        // A 2.35:1 picture is stretched too (FILL from 1.7 up).
+        assertEquals(1280 to 1080, fitVideoRect(1280, 1080, 2350, 1000, 1f))
+    }
+
+    @Test
+    fun anamorphicWithPixelRatioWithinToleranceCovers() {
+        assertEquals(1920 to 1080, fitVideoRect(1920, 1080, 1440, 1080, 4f / 3f))
+    }
+
+    @Test
+    fun fourByThreeIsPillarboxed() {
+        assertEquals(1440 to 1080, fitVideoRect(1920, 1080, 720, 540, 1f))
+    }
+
+    @Test
+    fun tallViewLetterboxes() {
+        assertEquals(1440 to 960, fitVideoRect(1440, 1080, 720, 480, 1f))
+    }
+}
