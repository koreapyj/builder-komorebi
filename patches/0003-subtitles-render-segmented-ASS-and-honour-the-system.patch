@@ -0,0 +1,52 @@
+package kr.dcmys.komorebi.ass
+
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.graphics.FilterQuality
+import androidx.compose.ui.layout.onSizeChanged
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.IntSize
+import kotlin.math.roundToInt
+
+/**
+ * Draws the current picture scaled to this composable's bounds. The picture state is read in the
+ * draw phase only, so a new picture redraws without recomposition.
+ */
+@Composable
+fun AssSubtitleOverlay(controller: AssSubtitleController, modifier: Modifier = Modifier) {
+    val frameState = controller.frame.collectAsState()
+    val available by controller.available.collectAsState()
+    val onFrame: (Long) -> Unit = remember(controller) { { _: Long -> controller.onDisplayFrame() } }
+
+    LaunchedEffect(controller, available) {
+        if (!available) return@LaunchedEffect
+        while (true) withFrameNanos(onFrame)
+    }
+
+    Spacer(
+        modifier
+            .onSizeChanged { controller.setViewportSize(it.width, it.height) }
+            .drawBehind {
+                val picture = frameState.value ?: return@drawBehind
+                if (picture.frameWidth <= 0 || picture.frameHeight <= 0) return@drawBehind
+                val sx = size.width / picture.frameWidth
+                val sy = size.height / picture.frameHeight
+                drawImage(
+                    image = picture.image,
+                    dstOffset = IntOffset((picture.left * sx).roundToInt(), (picture.top * sy).roundToInt()),
+                    dstSize = IntSize(
+                        (picture.image.width * sx).roundToInt(),
+                        (picture.image.height * sy).roundToInt(),
+                    ),
+                    filterQuality = FilterQuality.Medium,
+                )
+            },
+    )
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/ass/AssTimeline.kt b/app/src/main/java/kr/dcmys/komorebi/ass/AssTimeline.kt
