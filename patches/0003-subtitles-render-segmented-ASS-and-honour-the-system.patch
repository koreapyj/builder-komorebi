     return cue;
 }
 
+// System caption style: draw no caption background (the forced stroke is kept), then
+// re-render the caption current at ptsMs so it can replace the one already on screen.
+JNIEXPORT jobject JNICALL
+Java_com_beeregg2001_komorebi_NativeLib_setCaptionNoBackground(JNIEnv *env, jobject thiz, jlong handle, jboolean noBackground, jlong ptsMs) {
+    auto* ctx = reinterpret_cast<AribCaptionDecoderContext*>(handle);
+    if (!ctx || !ctx->renderer) return nullptr;
+
+    aribcc_render_result_t renderResult = {};
+    aribcc_render_status_t renderStatus = ARIBCC_RENDER_STATUS_ERROR;
+    {
+        std::lock_guard<std::mutex> lock(ctx->mutex);
+        aribcc_renderer_set_force_no_background(ctx->renderer, noBackground == JNI_TRUE);
+        if (ptsMs >= 0) {
+            renderStatus = aribcc_renderer_render(ctx->renderer, static_cast<int64_t>(ptsMs), &renderResult);
+        }
+    }
+    if (renderStatus != ARIBCC_RENDER_STATUS_GOT_IMAGE &&
+        renderStatus != ARIBCC_RENDER_STATUS_GOT_IMAGE_UNCHANGED) {
+        aribcc_render_result_cleanup(&renderResult);
+        return nullptr;
+    }
+    jobject cue = renderResultToCue(env, renderResult, ptsMs, false);
+    aribcc_render_result_cleanup(&renderResult);
+    return cue;
+}
+
 JNIEXPORT jintArray JNICALL
 Java_com_beeregg2001_komorebi_NativeLib_getCaptionLanguageCodes(JNIEnv *env, jobject thiz, jlong handle) {
     auto* ctx = reinterpret_cast<AribCaptionDecoderContext*>(handle);
