+package kr.dcmys.komorebi.platform
+
+/**
+ * The caption decoders have no Compose or Context access, so the caption overlay publishes the live
+ * [SystemCaptionStyle] here and each decoder applies it before decoding the next packet.
+ */
+object AribCaptionSystemStyle {
+    @Volatile
+    var current: SystemCaptionStyle = SystemCaptionStyle.DEFAULT
+
+    /** The edge type is not mapped: the renderer always forces stroked text, its only edge. */
+    val noBackground: Boolean
+        get() = current.transparentBackground
+}
