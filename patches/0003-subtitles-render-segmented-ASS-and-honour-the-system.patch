+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssScriptTest {
+
+    private val initAss = "[Script Info]\r\nScriptType: v4.00+\r\nPlayResX: 960\r\nPlayResY: 540\r\nWrapStyle: 2\r\n\r\n" +
+        "[V4+ Styles]\r\n" +
+        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, " +
+        "Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, " +
+        "MarginR, MarginV, Encoding\r\n" +
+        "Style: Default,WadaLabChuMaruGo2004ARIB,36,&Hffffff,&Hffffff,&H80000000,&H40112233,0,0,0,0,100,100,0,0,4,0,4,2,10,10,10,0\r\n\r\n"
+
+    @Test
+    fun headerGetsEventsFormatAndOpaqueBorderColours() {
+        val h = AssScript.prepareHeader(initAss, null)
+        assertTrue(h.contains("PlayResX: 960\n"))
+        assertTrue(
+            h.contains("Style: Default,WadaLabChuMaruGo2004ARIB,36,&Hffffff,&Hffffff,&H00000000,&H00112233,0,0,0,0,100,100,0,0,4,0,4,2,10,10,10,0\n"),
+        )
+        assertTrue(h.endsWith("\n[Events]\n" + AssScript.EVENTS_FORMAT + "\n"))
+        assertFalse(h.contains("\r"))
+    }
+
+    @Test
+    fun headerFontnameIsReplacedWhenAFontIsRegistered() {
+        val h = AssScript.prepareHeader(initAss.replace("WadaLabChuMaruGo2004ARIB", "Other"), "WadaLabChuMaruGo2004ARIB")
+        assertTrue(h.contains("Style: Default,WadaLabChuMaruGo2004ARIB,36,"))
+    }
+
+    @Test
+    fun existingEventsSectionIsReplaced() {
+        val h = AssScript.prepareHeader(initAss + "[Events]\nFormat: Layer, Start, End, Style, Text\nDialogue: 0,0:00:00.00,0:00:01.00,Default,x\n", null)
+        assertEquals(1, Regex("""\[Events]""").findAll(h).count())
+        assertFalse(h.contains("Dialogue:"))
+        assertTrue(h.endsWith(AssScript.EVENTS_FORMAT + "\n"))
+    }
+
+    @Test
+    fun opaqueColour() {
+        assertEquals("&H00000000", AssScript.opaque("&H0"))
+        assertEquals("&H00FFFFFF", AssScript.opaque("&HFFFFFFFF&"))
+        assertEquals("&H00000010", AssScript.opaque("16"))
+        assertEquals("junk", AssScript.opaque("junk"))
+    }
+
+    @Test
+    fun textStripsExactlyTheOverridesMediaFeStrips() {
+        val text = "{\\an7}{\\pos(60,449)}{\\fsp4}{\\bord3}{\\3a&Hff&}{\\1c&H00ffff&}text"
+        assertEquals("{\\an7}{\\pos(60,449)}{\\fsp4}{\\1c&H00ffff&}text", AssScript.cleanText(text))
+        assertEquals("{\\bord2}{\\3a&HFF&}x", AssScript.cleanText("{\\bord2}{\\3a&HFF&}x"))
+    }
+
+    @Test
+    fun chunkLineIsMatroskaOrder() {
+        val d = AssSegmentParser.parseDialogueLines(
+            "[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n" +
+                "Dialogue: 1,0:00:03.58,,Default,nm,1,2,3,fx,{\\bord3}a, b\n",
+            0,
+        ).single()
+        assertEquals("7,1,Default,nm,1,2,3,fx,a, b", AssScript.chunkLine(7, d))
+    }
+
+    @Test
+    fun wallClockMapping() {
+        assertEquals(1_000_012_345L, AssScript.playbackWallClockMs(1_000_000_000L, 12_345L, 0L))
+        assertEquals(1_000_011_845L, AssScript.playbackWallClockMs(1_000_000_000L, 12_345L, 500L))
+    }
+}
