--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/ass/AssTimeline.kt
@@ -0,0 +1,125 @@
+package kr.dcmys.komorebi.ass
+
+import java.util.TreeSet
+
+/** A Dialogue whose end is resolved; [open] marks a placeholder end (no later caption known yet). */
+data class AssResolvedEvent(
+    val dialogue: AssDialogue,
+    val startMs: Long,
+    val endMs: Long,
+    val open: Boolean,
+)
+
+/**
+ * - Every Dialogue start (any row, including empty-text "clear" rows) is a caption boundary.
+ * - A Dialogue with an empty End ends at the first known boundary strictly after its start; rows
+ *   sharing a start therefore close together. Until one is known it gets [OPEN_DURATION_MS].
+ *
+ * Ends are resolved lazily, so segments may arrive out of order (backfill adds older ones last).
+ * Not thread-safe; owned by a single thread.
+ */
+class AssTimeline {
+
+    private val events = ArrayList<AssDialogue>()
+    private val captionStarts = TreeSet<Long>()
+
+    /** Bumped on every change; consumers rebuild the renderer when it moves. */
+    var version: Long = 0
+        private set
+
+    val size: Int get() = events.size
+
+    fun addSegment(dialogues: List<AssDialogue>) {
+        if (dialogues.isEmpty()) return
+        for (d in dialogues) captionStarts.add(d.startMs)
+        events.addAll(dialogues)
+        version++
+    }
+
+    fun clear() {
+        if (events.isEmpty() && captionStarts.isEmpty()) return
+        events.clear()
+        captionStarts.clear()
+        version++
+    }
+
+    /**
+     * Programme boundary: drop the previous programme's events and caption boundaries (those
+     * before [boundaryStartMs]); the new programme's, possibly appended ahead, are kept.
+     */
+    fun resetAt(boundaryStartMs: Long) {
+        events.removeAll { it.startMs < boundaryStartMs }
+        captionStarts.headSet(boundaryStartMs, false).clear()
+        version++
+    }
+
+    fun closingTimeOf(dialogue: AssDialogue): Long? =
+        dialogue.endMs ?: captionStarts.higher(dialogue.startMs)
+
+    fun resolve(): List<AssResolvedEvent> {
+        val out = ArrayList<AssResolvedEvent>(events.size)
+        for (d in events) {
+            val end = closingTimeOf(d)
+            out += AssResolvedEvent(d, d.startMs, end ?: (d.startMs + OPEN_DURATION_MS), end == null)
+        }
+        return out
+    }
+
+    /**
+     * Drops events that ended at or before [cutoffMs]. A surviving event that started earlier ends at
+     * a boundary at/after the cutoff, so removing earlier boundaries never changes it.
+     */
+    fun prune(cutoffMs: Long) {
+        val before = events.size
+        events.removeAll { d -> (closingTimeOf(d) ?: Long.MAX_VALUE) <= cutoffMs }
+        val startsBefore = captionStarts.size
+        captionStarts.headSet(cutoffMs, false).clear()
+        if (events.size > MAX_EVENTS) {
+            events.sortBy { it.startMs }
+            events.subList(0, events.size - MAX_EVENTS).clear()
+        }
+        if (events.size != before || captionStarts.size != startsBefore) version++
+    }
+
+    companion object {
+        const val OPEN_DURATION_MS = 3_600_000L
+        private const val MAX_EVENTS = 2_000
+    }
+}
+
+/**
+ * The picture can only change when playback crosses an event start or end (the measured ARIB tags
+ * are static), or on every frame while an animated event is on screen. Pure; allocation-free.
+ */
+class AssRenderSchedule(events: List<AssResolvedEvent>) {
+
+    private val starts = LongArray(events.size) { events[it].startMs }
+    private val ends = LongArray(events.size) { events[it].endMs }
+    private val animated = BooleanArray(events.size) { isAnimated(events[it].dialogue.text) }
+
+    fun stableFrom(t: Long): Long {
+        var from = Long.MIN_VALUE
+        for (i in starts.indices) {
+            if (starts[i] in (from + 1)..t) from = starts[i]
+            if (ends[i] in (from + 1)..t) from = ends[i]
+        }
+        return from
+    }
+
+    /** End (exclusive) of the stable interval holding [t]; `t + 1` while an animated event shows. */
+    fun stableUntil(t: Long): Long {
+        var until = Long.MAX_VALUE
+        for (i in starts.indices) {
+            if (animated[i] && starts[i] <= t && t < ends[i]) return t + 1
+            if (starts[i] > t && starts[i] < until) until = starts[i]
+            if (ends[i] > t && ends[i] < until) until = ends[i]
+        }
+        return until
+    }
+
+    companion object {
+        private val ANIMATION_TAG = Regex("""\\(?:t\(|move\(|fade?\(|k[fo]?\d|K\d)""")
+
+        fun isAnimated(text: String): Boolean = ANIMATION_TAG.containsMatchIn(text)
+    }
+}
