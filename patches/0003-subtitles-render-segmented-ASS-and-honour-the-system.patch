@@ -0,0 +1,66 @@
+package kr.dcmys.komorebi.platform
+
+import android.content.Context
+import android.graphics.Color
+import android.view.accessibility.CaptioningManager
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+
+/**
+ * Text colour, typeface and font scale are deliberately excluded: ARIB text colour carries meaning
+ * (speaker, emphasis), and resizing glyphs breaks the fixed caption layout and ruby placement.
+ */
+data class SystemCaptionStyle(
+    val transparentBackground: Boolean = false,
+    val edge: Edge = Edge.NONE,
+) {
+    enum class Edge { NONE, OUTLINE, DROP_SHADOW }
+
+    companion object {
+        val DEFAULT = SystemCaptionStyle()
+
+        fun from(style: CaptioningManager.CaptionStyle): SystemCaptionStyle {
+            val transparentBackground =
+                style.hasBackgroundColor() && Color.alpha(style.backgroundColor) == 0
+            val transparentWindow =
+                style.hasWindowColor() && Color.alpha(style.windowColor) == 0
+            val edge = when {
+                !style.hasEdgeType() -> Edge.NONE
+                style.edgeType == CaptioningManager.CaptionStyle.EDGE_TYPE_OUTLINE -> Edge.OUTLINE
+                style.edgeType == CaptioningManager.CaptionStyle.EDGE_TYPE_DROP_SHADOW -> Edge.DROP_SHADOW
+                else -> Edge.NONE
+            }
+            return SystemCaptionStyle(transparentBackground || transparentWindow, edge)
+        }
+
+        fun current(context: Context): SystemCaptionStyle = try {
+            val manager = context.getSystemService(Context.CAPTIONING_SERVICE) as? CaptioningManager
+            manager?.userStyle?.let(::from) ?: DEFAULT
+        } catch (e: RuntimeException) {
+            DEFAULT
+        }
+    }
+}
+
+@Composable
+fun rememberSystemCaptionStyle(): SystemCaptionStyle {
+    val context = LocalContext.current.applicationContext
+    var style by remember { mutableStateOf(SystemCaptionStyle.current(context)) }
+    DisposableEffect(context) {
+        val manager = context.getSystemService(Context.CAPTIONING_SERVICE) as? CaptioningManager
+        val listener = object : CaptioningManager.CaptioningChangeListener() {
+            override fun onUserStyleChanged(userStyle: CaptioningManager.CaptionStyle) {
+                style = SystemCaptionStyle.from(userStyle)
+            }
+        }
+        manager?.addCaptioningChangeListener(listener)
+        style = SystemCaptionStyle.current(context)
+        onDispose { manager?.removeCaptioningChangeListener(listener) }
+    }
+    return style
+}
