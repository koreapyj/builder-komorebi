@@ -0,0 +1,566 @@
+@file:OptIn(UnstableApi::class)
+
+package kr.dcmys.komorebi.ass
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import androidx.annotation.OptIn
+import androidx.media3.common.C
+import androidx.media3.common.MediaItem
+import androidx.media3.common.Player
+import androidx.media3.common.Timeline
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.hls.HlsManifest
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kr.dcmys.komorebi.platform.SystemCaptionStyle
+import okhttp3.CacheControl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.IOException
+import kotlin.coroutines.CoroutineContext
+
+/**
+ * The subtitle rendition comes from the player's [HlsManifest]: the media3 fork keeps a
+ * `TYPE=SUBTITLES` rendition in `multivariantPlaylist.subtitles`, typed text/vtt, so it is confirmed
+ * as ASS by fetching its playlist. Event time = segment EXT-X-PROGRAM-DATE-TIME + local Start;
+ * playback time = `Timeline.Window.windowStartTimeMs + currentPosition`.
+ *
+ * All state lives on the player's application thread; network I/O runs on [Dispatchers.IO];
+ * libass runs on its own thread ([AssLibassRenderer]).
+ */
+class AssSubtitleController(
+    context: Context,
+    private val player: ExoPlayer,
+    private val httpClient: OkHttpClient,
+) {
+    private val playerLooper: Looper = player.applicationLooper
+    private val playerHandler = Handler(playerLooper)
+    private val scope = CoroutineScope(SupervisorJob() + LooperDispatcher(playerHandler))
+    private val window = Timeline.Window()
+
+    private val _available = MutableStateFlow(false)
+
+    val available: StateFlow<Boolean> = _available.asStateFlow()
+
+    private val _frame = MutableStateFlow<AssRenderedFrame?>(null)
+    internal val frame: StateFlow<AssRenderedFrame?> = _frame.asStateFlow()
+
+    @Volatile
+    private var enabledFlag = true
+
+    /** Captions on/off. Off clears the screen and stops fetching. Any thread. */
+    var enabled: Boolean
+        get() = enabledFlag
+        set(value) {
+            if (enabledFlag == value) return
+            enabledFlag = value
+            runOnPlayerThread { onEnabledChanged() }
+        }
+
+    @Volatile
+    private var borderMode = AssBorderMode.AUTHORED
+
+    /** Set from the overlay (main thread); rebuilds the libass track on its thread, keeping the fetched captions. */
+    var captionStyle: SystemCaptionStyle = SystemCaptionStyle.DEFAULT
+        set(value) {
+            if (field == value) return
+            field = value
+            val mode = AssScript.borderModeFor(value)
+            if (mode == borderMode) return
+            borderMode = mode
+            renderer.setBorderMode(mode)
+            // Queued after the rebuild on the libass thread: force the next frame to render.
+            runOnPlayerThread { if (!released) contentVersion++ }
+        }
+
+    private val renderer = AssLibassRenderer(context) { picture ->
+        _frame.value = if (enabledFlag && !released) picture else null
+    }
+
+    // --- Player-thread state ---
+    private val index = AssSegmentIndex()
+    private val planner = AssFeedPlanner(index)
+    private val timeline = AssTimeline()
+    private var candidateUrls: List<String> = emptyList()
+    private var assConfirmed = false
+    private var windowStartTimeMs = NO_TIME
+    private var headerUri: String? = null
+    private var headerText: String? = null
+    private var headerJob: Job? = null
+    private var pollJob: Job? = null
+    private var feedJob: Job? = null
+    private var submittedVersion = -1L
+    private var submittedHeader: String? = null
+    private var failedUri: String? = null
+    private var failedCount = 0
+
+    private var pendingBoundary: AssSegmentLink? = null
+    private var pendingHeaderText: String? = null
+    private var pendingHeaderJob: Job? = null
+
+    private var active = true
+
+    @Volatile
+    private var released = false
+
+    /** Bumped by every drop; fetches started before it are discarded. Read from I/O threads. */
+    @Volatile
+    private var generation = 0
+
+    // --- Published to the display thread ---
+    @Volatile
+    private var schedule: AssRenderSchedule? = null
+
+    @Volatile
+    private var contentVersion = 0L
+
+    @Volatile
+    private var snapshotWallMs = NO_TIME
+
+    @Volatile
+    private var snapshotElapsedMs = 0L
+
+    @Volatile
+    private var snapshotSpeed = 0f
+
+    // --- Display-thread state (the overlay's frame loop) ---
+    private var renderedVersion = -1L
+    private var stableFrom = 0L
+    private var stableUntil = 0L
+    private var viewportWidth = 0
+    private var viewportHeight = 0
+
+    private val listener = object : Player.Listener {
+        override fun onTimelineChanged(timeline: Timeline, reason: Int) {
+            onTimelineUpdated()
+        }
+
+        override fun onMediaItemTransition(mediaItem: MediaItem?, reason: Int) {
+            resetStream()
+            onTimelineUpdated()
+        }
+    }
+
+    init {
+        runOnPlayerThread {
+            if (!released && !player.isReleased) {
+                player.addListener(listener)
+                onTimelineUpdated()
+            }
+        }
+    }
+
+    fun release() {
+        runOnPlayerThread {
+            if (released) return@runOnPlayerThread
+            released = true
+            if (!player.isReleased) player.removeListener(listener)
+            scope.cancel()
+            renderer.release()
+            _frame.value = null
+            _available.value = false
+        }
+    }
+
+    /** Pausing forgets the stream; resuming rediscovers it from the player's manifest. Any thread. */
+    fun setActive(active: Boolean) {
+        runOnPlayerThread {
+            if (released || this.active == active) return@runOnPlayerThread
+            this.active = active
+            resetStream()
+            if (active) onTimelineUpdated()
+        }
+    }
+
+    private fun onTimelineUpdated() {
+        if (released || player.isReleased) return
+        windowStartTimeMs = readWindowStartTimeMs()
+        val manifest = player.currentManifest as? HlsManifest
+        val urls = manifest?.multivariantPlaylist?.subtitles
+            ?.mapNotNull { rendition -> rendition.url?.toString() }
+            .orEmpty()
+        if (active && urls != candidateUrls) {
+            resetStream()
+            candidateUrls = urls
+            if (urls.isNotEmpty()) {
+                pollJob = scope.launch { pollPlaylist(urls) }
+                feedJob = scope.launch { feedLoop() }
+            }
+        }
+        updateAvailable()
+    }
+
+    /** Epoch ms of window position 0 (live HLS with PDT), or [NO_TIME]. Allocation-free. */
+    private fun readWindowStartTimeMs(): Long {
+        val tl = player.currentTimeline
+        if (tl.isEmpty) return NO_TIME
+        val i = player.currentMediaItemIndex
+        if (i < 0 || i >= tl.windowCount) return NO_TIME
+        tl.getWindow(i, window)
+        if (window.isPlaceholder) return NO_TIME
+        val start = window.windowStartTimeMs
+        return if (start == C.TIME_UNSET) NO_TIME else start
+    }
+
+    private fun updateAvailable() {
+        _available.value = !released && assConfirmed && windowStartTimeMs != NO_TIME
+    }
+
+    private fun resetStream() {
+        pollJob?.cancel()
+        feedJob?.cancel()
+        headerJob?.cancel()
+        pollJob = null
+        feedJob = null
+        headerJob = null
+        generation++
+        candidateUrls = emptyList()
+        assConfirmed = false
+        index.clear()
+        planner.reset()
+        timeline.clear()
+        headerUri = null
+        headerText = null
+        failedUri = null
+        failedCount = 0
+        clearPendingBoundary()
+        publish()
+        // Cleared on the libass thread, after any render already queued for the old stream.
+        renderer.clear()
+        updateAvailable()
+    }
+
+    private suspend fun pollPlaylist(candidates: List<String>) {
+        // Confirm which subtitle rendition (if any) is Segmented-ASS. Done even when captions are
+        // disabled, so [available] can drive the UI toggle.
+        var url: String? = null
+        while (url == null) {
+            var anyFailed = false
+            for (candidate in candidates) {
+                val playlist = fetchPlaylist(candidate)
+                if (playlist == null) {
+                    anyFailed = true
+                } else if (playlist.isAss) {
+                    url = candidate
+                    index.ingest(playlist)
+                    break
+                }
+            }
+            if (url == null) {
+                if (!anyFailed) return
+                delay(RETRY_MS)
+            }
+        }
+        val assUrl: String = url ?: return
+        assConfirmed = true
+        updateAvailable()
+
+        while (scope.isActive) {
+            delay(index.targetDurationMs.coerceIn(MIN_POLL_MS, MAX_POLL_MS))
+            // Polled even while captions are off, so the index stays complete for a later seek
+            // back; only segment fetching is gated by [enabled].
+            val playlist = fetchPlaylist(assUrl) ?: continue
+            index.ingest(playlist)
+            if (playlist.endList) return
+        }
+    }
+
+    private suspend fun fetchPlaylist(url: String): AssMediaPlaylist? {
+        val text = fetchText(url, noCache = true) ?: return null
+        return AssPlaylistParser.parse(text, url)
+    }
+
+    private suspend fun feedLoop() {
+        while (scope.isActive) {
+            if (enabledFlag && assConfirmed) {
+                try {
+                    feedStep()
+                } catch (e: IOException) {
+                    Log.w(TAG, "caption feed step failed", e)
+                }
+            }
+            delay(nextFeedDelayMs())
+        }
+    }
+
+    /** The feed tick, shortened so a pending programme boundary is applied when it is played. */
+    private fun nextFeedDelayMs(): Long {
+        val boundary = pendingBoundary ?: return FEED_TICK_MS
+        val now = snapshotWallMs
+        if (now == NO_TIME) return FEED_TICK_MS
+        return (boundary.startMs - now).coerceIn(MIN_FEED_DELAY_MS, FEED_TICK_MS)
+    }
+
+    private suspend fun feedStep() {
+        val now = playbackWallClockOnPlayerThread()
+        if (now == NO_TIME) return
+        pendingBoundary?.let { if (now >= it.startMs) applyBoundary(it) }
+        timeline.prune(now - KEEP_BEHIND_MS)
+        planner.trimRangeStart(now - KEEP_BEHIND_MS)
+
+        when (val step = planner.plan(now)) {
+            AssFeedStep.Idle -> Unit
+            AssFeedStep.Drop -> dropCaptions()
+            is AssFeedStep.Restart -> {
+                dropCaptions()
+                val gen = generation
+                val link = step.link
+                val text = fetchText(link.uri, noCache = false) ?: return
+                if (gen != generation || !enabledFlag) return
+                appendSegment(link, text, backfilled = false, nowMs = now)
+                planner.markAppended(link)
+                publish()
+                // A caption without an End that started earlier may be on screen here.
+                val chain = AssBackfill.chain(index, link.uri)
+                if (chain.isEmpty()) return
+                val found = withContext(Dispatchers.IO) {
+                    AssBackfill.collect(chain, { blockingFetch(it, noCache = false) }, { gen != generation })
+                } ?: return
+                if (gen != generation || !enabledFlag) return
+                for ((l, t) in found) appendSegment(l, t, backfilled = true, nowMs = now)
+            }
+            is AssFeedStep.Append -> {
+                val gen = generation
+                val link = step.link
+                val text = fetchText(link.uri, noCache = false)
+                if (gen != generation || !enabledFlag) return
+                if (text == null) {
+                    // Retry on the next tick; give up on a segment that keeps failing.
+                    if (failedUri == link.uri) failedCount++ else { failedUri = link.uri; failedCount = 1 }
+                    if (failedCount < MAX_SEGMENT_FAILURES) return
+                    planner.markAppended(link)
+                    return
+                }
+                appendSegment(link, text, backfilled = false, nowMs = now)
+                planner.markAppended(link)
+            }
+        }
+        publish()
+    }
+
+    /**
+     * A programme's first segment resets the captions and reloads init.ass, but only once it is played:
+     * it is fetched up to two segments ahead, and resetting then would wipe the outgoing programme's
+     * caption early. Its events are added now and its header prefetched.
+     */
+    private fun appendSegment(link: AssSegmentLink, text: String, backfilled: Boolean, nowMs: Long) {
+        val map = link.mapUri
+        if (!backfilled && map != null) {
+            if (link.boundary) {
+                if (link.startMs <= nowMs) applyBoundary(link) else scheduleBoundary(link)
+            } else if (pendingBoundary == null) {
+                loadHeader(map, force = false)
+            }
+        }
+        timeline.addSegment(AssSegmentParser.parseDialogueLines(text, link.startMs))
+    }
+
+    private fun scheduleBoundary(link: AssSegmentLink) {
+        val map = link.mapUri ?: return
+        clearPendingBoundary()
+        pendingBoundary = link
+        pendingHeaderJob = scope.launch {
+            while (scope.isActive && pendingBoundary === link) {
+                val text = fetchText(map, noCache = true)
+                if (text != null) {
+                    if (pendingBoundary === link) pendingHeaderText = text
+                    return@launch
+                }
+                delay(RETRY_MS)
+            }
+        }
+    }
+
+    private fun applyBoundary(link: AssSegmentLink) {
+        val map = link.mapUri ?: return
+        val prefetched = if (pendingBoundary === link) pendingHeaderText else null
+        clearPendingBoundary()
+        timeline.resetAt(link.startMs)
+        if (prefetched != null) {
+            headerJob?.cancel()
+            headerUri = map
+            headerText = prefetched
+        } else {
+            loadHeader(map, force = true)
+        }
+        publish()
+    }
+
+    private fun clearPendingBoundary() {
+        pendingHeaderJob?.cancel()
+        pendingHeaderJob = null
+        pendingBoundary = null
+        pendingHeaderText = null
+    }
+
+    /**
+     * Fetch init.ass. Non-forced loads are de-duplicated by URL; a forced load (discontinuity)
+     * re-fetches, as the next program may reuse the same name with new content.
+     */
+    private fun loadHeader(uri: String, force: Boolean) {
+        if (!force && uri == headerUri) return
+        headerUri = uri
+        if (force) headerText = null // nothing renders until the new header arrives
+        headerJob?.cancel()
+        headerJob = scope.launch {
+            while (scope.isActive && headerUri == uri) {
+                val text = fetchText(uri, noCache = true)
+                if (text != null) {
+                    if (headerUri == uri) {
+                        headerText = text
+                        publish()
+                    }
+                    return@launch
+                }
+                delay(RETRY_MS)
+            }
+        }
+    }
+
+    private fun dropCaptions() {
+        generation++
+        clearPendingBoundary()
+        timeline.clear()
+        planner.reset()
+        failedUri = null
+        failedCount = 0
+        publish()
+    }
+
+    private fun onEnabledChanged() {
+        if (released) return
+        if (!enabledFlag) {
+            dropCaptions()
+            renderer.clear()
+            _frame.value = null
+        }
+    }
+
+    private fun publish() {
+        val header = headerText
+        if (timeline.version == submittedVersion && header === submittedHeader) return
+        submittedVersion = timeline.version
+        submittedHeader = header
+        val resolved = if (header == null) emptyList() else timeline.resolve()
+        renderer.submit(header, resolved)
+        schedule = AssRenderSchedule(resolved)
+        contentVersion++
+    }
+
+    /** Wall-clock (epoch ms) of the playback position, or [NO_TIME]. Player thread only. */
+    private fun playbackWallClockOnPlayerThread(): Long {
+        // The owner releases the player before it disposes this controller; never read it then.
+        if (player.isReleased) return NO_TIME
+        val start = readWindowStartTimeMs()
+        if (start == NO_TIME) return NO_TIME
+        val wall = AssScript.playbackWallClockMs(start, player.currentPosition, GLOBAL_OFFSET_MS)
+        snapshotWallMs = wall
+        snapshotElapsedMs = SystemClock.elapsedRealtime()
+        snapshotSpeed = if (player.isPlaying) player.playbackParameters.speed else 0f
+        return wall
+    }
+
+    /** Same, from another thread: extrapolated from the last player-thread reading. */
+    private fun extrapolatedWallClock(): Long {
+        val wall = snapshotWallMs
+        if (wall == NO_TIME) return NO_TIME
+        return wall + ((SystemClock.elapsedRealtime() - snapshotElapsedMs) * snapshotSpeed).toLong()
+    }
+
+    internal fun onDisplayFrame() {
+        if (!enabledFlag || viewportWidth <= 0) return
+        val version = contentVersion // read before the schedule (see publish order)
+        val sched = schedule ?: return
+        val now = if (Looper.myLooper() == playerLooper) {
+            playbackWallClockOnPlayerThread()
+        } else {
+            extrapolatedWallClock()
+        }
+        if (now == NO_TIME) return
+        if (version == renderedVersion && now >= stableFrom && now < stableUntil) return
+        renderedVersion = version
+        stableFrom = sched.stableFrom(now)
+        stableUntil = sched.stableUntil(now)
+        renderer.requestRender(now)
+    }
+
+    /** Size in pixels of the overlay; captions are rendered at it (capped) and scaled to fit. */
+    internal fun setViewportSize(width: Int, height: Int) {
+        if (width <= 0 || height <= 0) return
+        var w = width
+        var h = height
+        if (w > MAX_RENDER_WIDTH) {
+            h = (h.toLong() * MAX_RENDER_WIDTH / w).toInt().coerceAtLeast(1)
+            w = MAX_RENDER_WIDTH
+        }
+        if (w == viewportWidth && h == viewportHeight) return
+        viewportWidth = w
+        viewportHeight = h
+        renderer.setFrameSize(w, h)
+        renderedVersion = -1L // force a render at the new size
+    }
+
+    private suspend fun fetchText(url: String, noCache: Boolean): String? =
+        withContext(Dispatchers.IO) { blockingFetch(url, noCache) }
+
+    private fun blockingFetch(url: String, noCache: Boolean): String? = try {
+        val builder = Request.Builder().url(url)
+        if (noCache) builder.cacheControl(CacheControl.FORCE_NETWORK)
+        httpClient.newCall(builder.build()).execute().use { response ->
+            if (response.isSuccessful) response.body?.string() else null
+        }
+    } catch (e: IOException) {
+        null
+    } catch (e: IllegalArgumentException) {
+        null
+    }
+
+    private fun runOnPlayerThread(block: () -> Unit) {
+        if (Looper.myLooper() == playerLooper) block() else playerHandler.post { block() }
+    }
+
+    private class LooperDispatcher(private val handler: Handler) : CoroutineDispatcher() {
+        override fun isDispatchNeeded(context: CoroutineContext): Boolean =
+            Looper.myLooper() != handler.looper
+
+        override fun dispatch(context: CoroutineContext, block: Runnable) {
+            handler.post(block)
+        }
+    }
+
+    companion object {
+        private const val TAG = "AssSubtitleController"
+
+        /**
+         * Global caption offset in ms, applied to the playback wall clock. Positive shows captions
+         * later. Tune here if the subtitle PDT and the video PDT anchors turn out to differ.
+         */
+        const val GLOBAL_OFFSET_MS = 0L
+
+        private const val NO_TIME = Long.MIN_VALUE
+        private const val FEED_TICK_MS = 500L
+        private const val MIN_FEED_DELAY_MS = 10L
+        private const val RETRY_MS = 5_000L
+        private const val MIN_POLL_MS = 1_000L
+        private const val MAX_POLL_MS = 10_000L
+        private const val KEEP_BEHIND_MS = 60_000L
+        private const val MAX_SEGMENT_FAILURES = 3
+        private const val MAX_RENDER_WIDTH = 1920
+    }
+}
