+package kr.dcmys.komorebi.ass
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssPlaylistTest {
+
+    private val base = "https://cdn.example.com/ch/arib_ass/stream.m3u8"
+
+    private val live = """
+        #EXTM3U
+        #EXT-X-VERSION:3
+        #EXT-X-TARGETDURATION:5
+        #EXT-X-MAP:URI="https://cache.example.com/abc/arib_ass/init.ass"
+        #EXT-X-MEDIA-SEQUENCE:358620286
+        #EXT-X-DISCONTINUITY-SEQUENCE:168
+        #EXTINF:5.000000,
+        #EXT-X-PROGRAM-DATE-TIME:2026-11-24T16:33:43.791+0000
+        https://cache.example.com/abc/arib_ass/20261124-163341.ass
+        #EXTINF:5.000000,
+        #EXT-X-PROGRAM-DATE-TIME:2026-11-24T16:33:48.791+0000
+        https://cache.example.com/abc/arib_ass/20261124-163346.ass
+        #EXT-X-DISCONTINUITY
+        #EXT-X-MAP:URI="https://cache.example.com/abc/arib_ass/init.ass"
+        #EXTINF:5.000000,
+        #EXT-X-PROGRAM-DATE-TIME:2026-11-24T16:33:53.791+0000
+        https://cache.example.com/abc/arib_ass/20261124-163351.ass
+    """.trimIndent()
+
+    @Test
+    fun parsesMeasuredLivePlaylist() {
+        val p = AssPlaylistParser.parse(live, base)
+        assertEquals(5_000L, p.targetDurationMs)
+        assertTrue(p.isAss)
+        assertFalse(p.endList)
+        assertEquals(3, p.segments.size)
+        val first = p.segments[0]
+        assertEquals("https://cache.example.com/abc/arib_ass/20261124-163341.ass", first.uri)
+        assertEquals(5_000L, first.durationMs)
+        assertEquals(1_795_538_023_791L, first.startMs)
+        assertEquals("https://cache.example.com/abc/arib_ass/init.ass", first.mapUri)
+        assertFalse(first.discontinuity)
+        assertFalse(p.segments[1].discontinuity)
+        assertTrue(p.segments[2].discontinuity)
+        assertEquals(first.startMs!! + 10_000L, p.segments[2].startMs)
+    }
+
+    @Test
+    fun relativeUrisResolveAgainstThePlaylist() {
+        val text = "#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-MAP:URI=\"init.ass\"\n" +
+            "#EXT-X-PROGRAM-DATE-TIME:2026-01-01T00:00:00Z\n#EXTINF:6.0,\nseg1.ass\n" +
+            "#EXTINF:6.0,\n/root/seg2.ass?x=1\n#EXT-X-ENDLIST\n"
+        val p = AssPlaylistParser.parse(text, base)
+        assertEquals(6_000L, p.targetDurationMs)
+        assertEquals("https://cdn.example.com/ch/arib_ass/init.ass", p.segments[0].mapUri)
+        assertEquals("https://cdn.example.com/ch/arib_ass/seg1.ass", p.segments[0].uri)
+        assertEquals("https://cdn.example.com/root/seg2.ass?x=1", p.segments[1].uri)
+        assertEquals(p.segments[0].startMs!! + 6_000L, p.segments[1].startMs)
+        assertTrue(p.endList)
+        assertTrue(p.isAss)
+    }
+
+    @Test
+    fun missingLeadingPdtIsExtrapolatedBackwards() {
+        val text = "#EXTM3U\n#EXTINF:5,\na.ass\n#EXTINF:5,\n#EXT-X-PROGRAM-DATE-TIME:2026-01-01T00:00:10Z\nb.ass\n"
+        val p = AssPlaylistParser.parse(text, base)
+        assertEquals(p.segments[1].startMs!! - 5_000L, p.segments[0].startMs)
+    }
+
+    @Test
+    fun noPdtAtAllLeavesStartsUnknownAndVttIsNotAss() {
+        val text = "#EXTM3U\n#EXTINF:5,\na.vtt\n"
+        val p = AssPlaylistParser.parse(text, base)
+        assertNull(p.segments[0].startMs)
+        assertFalse(p.isAss)
+    }
+
+    @Test
+    fun programDateTimeOffsets() {
+        val utc = AssPlaylistParser.parseProgramDateTimeMs("2026-11-24T16:33:43.791Z")!!
+        assertEquals(1_795_538_023_791L, utc)
+        assertEquals(utc, AssPlaylistParser.parseProgramDateTimeMs("2026-11-24T16:33:43.791+0000"))
+        assertEquals(utc, AssPlaylistParser.parseProgramDateTimeMs("2026-11-25T01:33:43.791+09:00"))
+        assertEquals(utc, AssPlaylistParser.parseProgramDateTimeMs("2026-11-24T16:33:43.791"))
+        assertEquals(utc - 791, AssPlaylistParser.parseProgramDateTimeMs("2026-11-24T11:33:43-05"))
+        assertEquals(0L, AssPlaylistParser.parseProgramDateTimeMs("1970-01-01T00:00:00Z"))
+        assertEquals(951_782_400_000L, AssPlaylistParser.parseProgramDateTimeMs("2000-02-29T00:00:00Z"))
+        assertNull(AssPlaylistParser.parseProgramDateTimeMs("not a date"))
+    }
+}
