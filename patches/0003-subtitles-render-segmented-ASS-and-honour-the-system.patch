+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kr.dcmys.komorebi.iptv.IptvHttp
+import kr.dcmys.komorebi.platform.rememberSystemCaptionStyle
+import okhttp3.OkHttpClient
+import kotlin.math.abs
+
+/** Gives composables the plain IPTV HTTP client (the app's default client rewrites hosts). */
+@EntryPoint
+@InstallIn(SingletonComponent::class)
+interface AssHttpEntryPoint {
+    @IptvHttp
+    fun iptvHttpClient(): OkHttpClient
+}
+
+/**
+ * One [AssSubtitleController] per player instance, released when the player changes or this leaves
+ * the composition. Keep it composed while captions are hidden so the controller (and its subtitle
+ * index) survives UI toggles; [visible] only decides whether the picture is drawn.
+ *
+ * @param modifier must size this overlay to the displayed video rectangle.
+ */
+@Composable
+fun IptvAssOverlay(
+    player: ExoPlayer?,
+    enabled: Boolean,
+    visible: Boolean,
+    modifier: Modifier = Modifier,
+) {
+    if (player == null) return
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    val httpClient = remember {
+        EntryPointAccessors.fromApplication(context.applicationContext, AssHttpEntryPoint::class.java)
+            .iptvHttpClient()
+    }
+    val currentEnabled by rememberUpdatedState(enabled)
+    val captionStyle = rememberSystemCaptionStyle()
+    val currentCaptionStyle by rememberUpdatedState(captionStyle)
+    var controller by remember(player) { mutableStateOf<AssSubtitleController?>(null) }
+
+    // Created in an effect (not during composition) so an abandoned composition leaks nothing.
+    DisposableEffect(player, lifecycleOwner) {
+        if (player.isReleased) return@DisposableEffect onDispose {}
+        val c = AssSubtitleController(context, player, httpClient)
+        c.enabled = currentEnabled
+        c.captionStyle = currentCaptionStyle
+        controller = c
+        // The screen releases its players on ON_STOP; pausing here too keeps the controller
+        // from touching the network (or the player) while the app is in the background.
+        val observer = LifecycleEventObserver { _, event ->
+            when (event) {
+                Lifecycle.Event.ON_STOP -> c.setActive(false)
+                Lifecycle.Event.ON_START -> c.setActive(true)
+                else -> Unit
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        onDispose {
+            lifecycleOwner.lifecycle.removeObserver(observer)
+            c.release()
+        }
+    }
+
+    val c = controller ?: return
+    SideEffect {
+        c.enabled = enabled
+        c.captionStyle = captionStyle
+    }
+    if (visible) AssSubtitleOverlay(c, modifier)
+}
+
+/**
+ * Mirrors LivePlayerScreen's resize-mode choice (FILL for 1440x1080 with square pixels or any
+ * ratio >= 1.7, else FIT) and AspectRatioFrameLayout's FIT measurement (display aspect
+ * `width * pixelWidthHeightRatio / height`, 1% tolerance, centred).
+ */
+fun Modifier.liveVideoRect(
+    state: LivePlayerState,
+    videoWidth: Int,
+    videoHeight: Int,
+    pixelWidthHeightRatio: Float,
+): Modifier = this
+    .fillMaxSize()
+    .graphicsLayer {
+        if (state.lCropEnabled) {
+            scaleX = state.lCropZoom / 100f
+            scaleY = state.lCropZoom / 100f
+            translationX = size.width * (state.lCropX / 100f)
+            translationY = size.height * (state.lCropY / 100f)
+            transformOrigin = when (state.lCropOrigin) {
+                ZoomOrigin.TopLeft -> TransformOrigin(0f, 0f)
+                ZoomOrigin.TopRight -> TransformOrigin(1f, 0f)
+                ZoomOrigin.BottomLeft -> TransformOrigin(0f, 1f)
+                ZoomOrigin.BottomRight -> TransformOrigin(1f, 1f)
+            }
+        } else {
+            scaleX = 1f
+            scaleY = 1f
+            translationX = 0f
+            translationY = 0f
+            transformOrigin = TransformOrigin.Center
+        }
+    }
+    .layout { measurable, constraints ->
+        val width = constraints.maxWidth
+        val height = constraints.maxHeight
+        val (w, h) = if (constraints.hasBoundedWidth && constraints.hasBoundedHeight) {
+            fitVideoRect(width, height, videoWidth, videoHeight, pixelWidthHeightRatio)
+        } else {
+            constraints.minWidth to constraints.minHeight
+        }
+        val placeable = measurable.measure(constraints.copy(minWidth = w, maxWidth = w, minHeight = h, maxHeight = h))
+        layout(width, height) { placeable.place((width - w) / 2, (height - h) / 2) }
+    }
+
+internal fun fitVideoRect(
+    viewWidth: Int,
+    viewHeight: Int,
+    videoWidth: Int,
+    videoHeight: Int,
+    pixelWidthHeightRatio: Float,
+): Pair<Int, Int> {
+    if (viewWidth <= 0 || viewHeight <= 0 || videoWidth <= 0 || videoHeight <= 0) return viewWidth to viewHeight
+    val isAnamorphic = videoWidth == 1440 && videoHeight == 1080 && pixelWidthHeightRatio == 1.0f
+    val storageRatio = videoWidth.toFloat() / videoHeight.toFloat()
+    if (isAnamorphic || storageRatio >= FILL_MIN_RATIO) return viewWidth to viewHeight
+    val videoAspect = videoWidth * pixelWidthHeightRatio / videoHeight
+    if (!(videoAspect > 0f) || !videoAspect.isFinite()) return viewWidth to viewHeight
+    val deformation = videoAspect / (viewWidth.toFloat() / viewHeight) - 1
+    if (abs(deformation) <= MAX_ASPECT_DEFORMATION) return viewWidth to viewHeight
+    return if (deformation > 0) {
+        viewWidth to (viewWidth / videoAspect).toInt()
+    } else {
+        (viewHeight * videoAspect).toInt() to viewHeight
+    }
+}
+
+/** LivePlayerScreen switches the PlayerView to RESIZE_MODE_FILL at or above this ratio. */
+private const val FILL_MIN_RATIO = 1.7f
+
+/** AspectRatioFrameLayout.MAX_ASPECT_RATIO_DEFORMATION_FRACTION. */
+private const val MAX_ASPECT_DEFORMATION = 0.01f
