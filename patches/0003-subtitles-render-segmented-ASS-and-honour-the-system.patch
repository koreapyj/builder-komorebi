+package kr.dcmys.komorebi.ass
+
+import kr.dcmys.komorebi.platform.SystemCaptionStyle
+import kr.dcmys.komorebi.platform.SystemCaptionStyle.Edge
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AssCaptionStyleTest {
+
+    // The server's real init.ass style (BorderStyle 4 box, Outline 0, Shadow 4).
+    private val initAss = "[Script Info]\r\nScriptType: v4.00+\r\nPlayResX: 960\r\nPlayResY: 540\r\n\r\n" +
+        "[V4+ Styles]\r\n" +
+        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, " +
+        "Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, " +
+        "MarginR, MarginV, Encoding\r\n" +
+        "Style: Default,WadaLabChuMaruGo2004ARIB,36,&Hffffff,&Hffffff,&H0,&H0,0,0,0,0,100,100,0,0,4,0,4,2,10,10,10,0\r\n\r\n"
+
+    private fun styleLine(header: String): String = header.lines().single { it.startsWith("Style:") }
+
+    private fun line(borderStyle: String, outline: String, shadow: String) =
+        "Style: Default,WadaLabChuMaruGo2004ARIB,36,&Hffffff,&Hffffff,&H00000000,&H00000000,0,0,0,0,100,100,0,0," +
+            "$borderStyle,$outline,$shadow,2,10,10,10,0"
+
+    @Test
+    fun mapping() {
+        assertEquals(AssBorderMode.AUTHORED, AssScript.borderModeFor(SystemCaptionStyle.DEFAULT))
+        assertEquals(AssBorderMode.AUTHORED, AssScript.borderModeFor(SystemCaptionStyle(false, Edge.DROP_SHADOW)))
+        assertEquals(AssBorderMode.BOX_OUTLINE, AssScript.borderModeFor(SystemCaptionStyle(false, Edge.OUTLINE)))
+        assertEquals(AssBorderMode.OUTLINE, AssScript.borderModeFor(SystemCaptionStyle(true, Edge.NONE)))
+        assertEquals(AssBorderMode.OUTLINE, AssScript.borderModeFor(SystemCaptionStyle(true, Edge.OUTLINE)))
+        assertEquals(AssBorderMode.SHADOW, AssScript.borderModeFor(SystemCaptionStyle(true, Edge.DROP_SHADOW)))
+    }
+
+    @Test
+    fun defaultIsByteForByteTheExistingRewrite() {
+        val font = AssLibassRenderer.ARIB_FONT_FAMILY
+        val before = "[Script Info]\nScriptType: v4.00+\nPlayResX: 960\nPlayResY: 540\n\n[V4+ Styles]\n" +
+            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, " +
+            "Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, " +
+            "MarginR, MarginV, Encoding\n" + line("4", "0", "4") + "\n\n[Events]\n" + AssScript.EVENTS_FORMAT + "\n"
+        assertEquals(before, AssScript.prepareHeader(initAss, font, AssBorderMode.AUTHORED))
+        assertEquals(before, AssScript.prepareHeader(initAss, font))
+    }
+
+    @Test
+    fun transparentBackgroundUsesMediaFeOutline() {
+        assertEquals(line("1", "2", "0"), styleLine(AssScript.prepareHeader(initAss, null, AssBorderMode.OUTLINE)))
+    }
+
+    @Test
+    fun transparentBackgroundWithDropShadowUsesMediaFeShadow() {
+        assertEquals(line("1", "0", "1"), styleLine(AssScript.prepareHeader(initAss, null, AssBorderMode.SHADOW)))
+    }
+
+    @Test
+    fun boxKeptWithOutlineAddsGlyphOutline() {
+        assertEquals(line("4", "2", "4"), styleLine(AssScript.prepareHeader(initAss, null, AssBorderMode.BOX_OUTLINE)))
+        val bs1 = initAss.replace(",4,0,4,2,", ",1,0,4,2,")
+        assertEquals(line("1", "2", "0"), styleLine(AssScript.prepareHeader(bs1, null, AssBorderMode.BOX_OUTLINE)))
+        val bs3 = initAss.replace(",4,0,4,2,", ",3,0,4,2,")
+        assertEquals(line("3", "0", "4"), styleLine(AssScript.prepareHeader(bs3, null, AssBorderMode.BOX_OUTLINE)))
+    }
+
+    @Test
+    fun onlyBorderFieldsChange() {
+        val authored = styleLine(AssScript.prepareHeader(initAss, null)).split(',')
+        for (mode in AssBorderMode.values()) {
+            val v = styleLine(AssScript.prepareHeader(initAss, null, mode)).split(',')
+            for (i in authored.indices) if (i !in 15..17) assertEquals("$mode field $i", authored[i], v[i])
+        }
+    }
+}
