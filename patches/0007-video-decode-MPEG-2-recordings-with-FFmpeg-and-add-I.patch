+package kr.dcmys.komorebi.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class Mpeg2SequenceInfoTest {
+
+    private fun bytes(vararg values: Int) = ByteArray(values.size) { values[it].toByte() }
+
+    // 1440x1080, 16:9, 29.97 fps
+    private val sequenceHeader = intArrayOf(0x00, 0x00, 0x01, 0xB3, 0x5A, 0x04, 0x38, 0x34, 0xFF, 0xFF, 0xE0, 0x18)
+
+    private fun sequenceExtension(progressive: Boolean, n: Int = 0, d: Int = 0) = intArrayOf(
+        0x00, 0x00, 0x01, 0xB5,
+        0x14, if (progressive) 0x8A else 0x82, 0x00, 0x01, 0x00, (n shl 5) or d,
+    )
+
+    @Test
+    fun parsesInterlacedHeaderWithExtension() {
+        val info = Mpeg2SequenceInfo.parse(bytes(*sequenceHeader, *sequenceExtension(progressive = false)))!!
+        assertEquals(1440, info.width)
+        assertEquals(1080, info.height)
+        assertEquals(30000, info.frameRateNum)
+        assertEquals(1001, info.frameRateDen)
+        assertEquals(false, info.progressiveSequence)
+        assertEquals(2, info.avFieldOrder)
+    }
+
+    @Test
+    fun parsesProgressiveAndFrameRateExtension() {
+        val info = Mpeg2SequenceInfo.parse(bytes(*sequenceHeader, *sequenceExtension(progressive = true, n = 1, d = 0)))!!
+        assertEquals(true, info.progressiveSequence)
+        assertEquals(1, info.avFieldOrder)
+        assertEquals(60000, info.frameRateNum)
+        assertEquals(1001, info.frameRateDen)
+    }
+
+    @Test
+    fun headerWithoutExtensionHasUnknownFieldOrder() {
+        val info = Mpeg2SequenceInfo.parse(bytes(*sequenceHeader))!!
+        assertNull(info.progressiveSequence)
+        assertEquals(0, info.avFieldOrder)
+    }
+
+    @Test
+    fun rejectsDataWithoutSequenceHeader() {
+        assertNull(Mpeg2SequenceInfo.parse(bytes(0, 0, 1, 0x00, 1, 2, 3, 4, 5)))
+        assertNull(Mpeg2SequenceInfo.parse(null))
+    }
+}
+
+class InputAccountingTest {
+
+    @Test
+    fun oneOutputPerInputConsumesOne() {
+        val accounting = InputAccounting()
+        listOf(0L, 33_366L, 66_733L).forEach(accounting::add)
+        assertEquals(1, accounting.consumedBy(0L))
+        assertEquals(1, accounting.consumedBy(33_366L))
+        assertEquals(1, accounting.consumedBy(66_733L))
+    }
+
+    @Test
+    fun fieldRateOutputConsumesNothingForTheSecondField() {
+        val accounting = InputAccounting()
+        listOf(0L, 33_366L).forEach(accounting::add)
+        assertEquals(1, accounting.consumedBy(0L))
+        assertEquals(0, accounting.consumedBy(16_683L))
+        assertEquals(1, accounting.consumedBy(33_366L))
+        assertEquals(0, accounting.size)
+    }
+
+    @Test
+    fun droppedFramesAreConsumedByTheNextOutput() {
+        val accounting = InputAccounting()
+        // Reordered (decode-order) input timestamps.
+        listOf(100L, 0L, 33L, 66L, 200L).forEach(accounting::add)
+        assertEquals(4, accounting.consumedBy(100L))
+        assertEquals(1, accounting.size)
+    }
+}
