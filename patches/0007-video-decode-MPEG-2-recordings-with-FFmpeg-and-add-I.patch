+package kr.dcmys.komorebi.video
+
+import android.util.Log
+import android.view.Surface
+import java.nio.ByteBuffer
+
+internal object NativeVideo {
+    private const val TAG = "KomorebiVideo"
+
+    const val QUEUE_OK = 0
+    const val QUEUE_FULL = 1
+
+    const val DEQUEUE_NONE = 0
+    const val DEQUEUE_FRAME = 1
+    const val DEQUEUE_END_OF_STREAM = 2
+
+    val isAvailable: Boolean by lazy {
+        try {
+            System.loadLibrary("komorebi-video")
+            nativeHasDecoder()
+        } catch (e: Throwable) {
+            Log.w(TAG, "ffmpeg video renderer unavailable", e)
+            false
+        }
+    }
+
+    external fun nativeHasDecoder(): Boolean
+
+    external fun nativeOpen(
+        extradata: ByteArray?,
+        width: Int,
+        height: Int,
+        pixelWidthHeightRatio: Float,
+        frameRateNum: Int,
+        frameRateDen: Int,
+        fieldOrder: Int,
+        mode: Int,
+        preferMediaCodec: Boolean,
+    ): Long
+
+    external fun nativeQueuePacket(
+        handle: Long, buffer: ByteBuffer, offset: Int, size: Int, timeUs: Long, keyFrame: Boolean, serial: Int,
+    ): Int
+
+    external fun nativeQueueEndOfStream(handle: Long, serial: Int): Int
+
+    external fun nativeFlush(handle: Long, serial: Int, hasStartTime: Boolean, startTimeUs: Long)
+
+    /** Fills [out] with {AVFrame*, timeUs, width, height} when returning [DEQUEUE_FRAME]. */
+    external fun nativeDequeueFrame(handle: Long, serial: Int, out: LongArray): Int
+
+    external fun nativeReleaseFrame(handle: Long, frame: Long)
+
+    external fun nativeSetMode(handle: Long, mode: Int)
+
+    /** 0 while the decode thread runs, otherwise the AVERROR that stopped it. */
+    external fun nativeLastError(handle: Long): Int
+
+    external fun nativeInfoVersion(handle: Long): Int
+
+    /** "decoderName\thardware(0|1)\teffectiveMode\tbackend" */
+    external fun nativeInfo(handle: Long): String?
+
+    external fun nativeClose(handle: Long)
+
+    external fun nativeSurfaceCreate(): Long
+
+    external fun nativeSurfaceRender(output: Long, surface: Surface, handle: Long, frame: Long): Boolean
+
+    external fun nativeSurfaceDrain(output: Long)
+
+    external fun nativeSurfaceDetach(output: Long)
+
+    external fun nativeSurfaceRelease(output: Long)
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/video/VideoFilterMode.kt b/app/src/main/java/kr/dcmys/komorebi/video/VideoFilterMode.kt
