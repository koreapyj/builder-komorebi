+package kr.dcmys.komorebi.video
+
+import android.content.Context
+import android.os.Handler
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.Renderer
+import androidx.media3.exoplayer.mediacodec.MediaCodecSelector
+import androidx.media3.exoplayer.video.VideoRendererEventListener
+import kotlinx.coroutines.flow.StateFlow
+
+/** [DefaultRenderersFactory] that tries [FfmpegMpeg2VideoRenderer] before the MediaCodec video renderer. */
+@UnstableApi
+class KomorebiRenderersFactory(
+    context: Context,
+    private val initialFilterMode: VideoFilterMode = VideoFilterMode.AUTO,
+) : DefaultRenderersFactory(context) {
+
+    override fun buildVideoRenderers(
+        context: Context,
+        extensionRendererMode: Int,
+        mediaCodecSelector: MediaCodecSelector,
+        enableDecoderFallback: Boolean,
+        eventHandler: Handler,
+        eventListener: VideoRendererEventListener,
+        allowedVideoJoiningTimeMs: Long,
+        out: ArrayList<Renderer>,
+    ) {
+        out.add(
+            FfmpegMpeg2VideoRenderer(
+                allowedVideoJoiningTimeMs, eventHandler, eventListener,
+                MAX_DROPPED_VIDEO_FRAME_COUNT_TO_NOTIFY, initialFilterMode,
+            ),
+        )
+        super.buildVideoRenderers(
+            context, extensionRendererMode, mediaCodecSelector, enableDecoderFallback,
+            eventHandler, eventListener, allowedVideoJoiningTimeMs, out,
+        )
+    }
+}
+
+@UnstableApi
+private fun ExoPlayer.ffmpegVideoRenderer(): FfmpegMpeg2VideoRenderer? =
+    (0 until rendererCount).firstNotNullOfOrNull { getRenderer(it) as? FfmpegMpeg2VideoRenderer }
+
+/** Switches the ffmpeg renderer's filter mode; also used for decoders created after later seeks. No-op without that renderer. */
+@UnstableApi
+fun ExoPlayer.setVideoFilterMode(mode: VideoFilterMode) {
+    val renderer = ffmpegVideoRenderer() ?: return
+    createMessage(renderer).setType(FfmpegMpeg2VideoRenderer.MSG_SET_FILTER_MODE).setPayload(mode).send()
+}
+
+/** What the ffmpeg renderer is running, or null when this player has no such renderer. */
+@UnstableApi
+fun ExoPlayer.videoPipelineInfo(): StateFlow<VideoPipelineInfo?>? = ffmpegVideoRenderer()?.pipelineInfo
