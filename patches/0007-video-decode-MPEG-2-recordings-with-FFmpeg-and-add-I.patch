@@ -0,0 +1,25 @@
+package kr.dcmys.komorebi.video
+
+enum class VideoFilterMode(val nativeValue: Int) {
+    AUTO(1),
+    IVTC(2),
+    DEINTERLACE(3),
+    OFF(0);
+
+    companion object {
+        fun fromNative(value: Int): VideoFilterMode? = entries.firstOrNull { it.nativeValue == value }
+    }
+}
+
+/**
+ * What the ffmpeg video pipeline is actually running.
+ * [hardware] means the decoder is MediaCodec-backed (`mpeg2_mediacodec`).
+ * [filterBackend] is "opencl", "cpu" or "none" (no filter, or the filter graph failed and frames bypass it).
+ */
+data class VideoPipelineInfo(
+    val decoderName: String,
+    val hardware: Boolean,
+    val requestedMode: VideoFilterMode,
+    val effectiveMode: VideoFilterMode?,
+    val filterBackend: String,
+)
