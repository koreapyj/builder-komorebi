@@ -0,0 +1,205 @@
+package kr.dcmys.komorebi.video
+
+import android.os.Handler
+import android.util.Log
+import android.view.Surface
+import androidx.media3.common.C
+import androidx.media3.common.Format
+import androidx.media3.common.MimeTypes
+import androidx.media3.common.VideoSize
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.decoder.CryptoConfig
+import androidx.media3.decoder.Decoder
+import androidx.media3.decoder.DecoderInputBuffer
+import androidx.media3.decoder.VideoDecoderOutputBuffer
+import androidx.media3.exoplayer.DecoderCounters
+import androidx.media3.exoplayer.DecoderReuseEvaluation
+import androidx.media3.exoplayer.FormatHolder
+import androidx.media3.exoplayer.Renderer
+import androidx.media3.exoplayer.RendererCapabilities
+import androidx.media3.exoplayer.video.DecoderVideoRenderer
+import androidx.media3.exoplayer.video.VideoRendererEventListener
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Decodes `video/mpeg2` with ffmpeg (MediaCodec first, software fallback) and runs aribplayer's
+ * IVTC / deinterlace filter graph, rendering YV12 into the output Surface.
+ */
+@UnstableApi
+class FfmpegMpeg2VideoRenderer private constructor(
+    allowedJoiningTimeMs: Long,
+    eventHandler: Handler?,
+    eventListener: VideoRendererEventListener?,
+    maxDroppedFramesToNotify: Int,
+    initialMode: VideoFilterMode,
+    private val aspect: AspectState,
+) : DecoderVideoRenderer(
+    allowedJoiningTimeMs,
+    eventHandler,
+    eventListener?.let { AspectFixingListener(it, aspect) },
+    maxDroppedFramesToNotify,
+) {
+    constructor(
+        allowedJoiningTimeMs: Long,
+        eventHandler: Handler?,
+        eventListener: VideoRendererEventListener?,
+        maxDroppedFramesToNotify: Int,
+        initialMode: VideoFilterMode = VideoFilterMode.AUTO,
+    ) : this(allowedJoiningTimeMs, eventHandler, eventListener, maxDroppedFramesToNotify, initialMode, AspectState())
+
+    @Volatile private var filterMode = initialMode
+    private var decoder: FfmpegMpeg2Decoder? = null
+    private var surfaceOutput = 0L
+    private var loggedRenderFailure = false
+
+    private val _pipelineInfo = MutableStateFlow<VideoPipelineInfo?>(null)
+    val pipelineInfo: StateFlow<VideoPipelineInfo?> = _pipelineInfo.asStateFlow()
+
+    override fun getName(): String = TAG
+
+    override fun supportsFormat(format: Format): Int {
+        if (!MimeTypes.VIDEO_MPEG2.equals(format.sampleMimeType, ignoreCase = true)) {
+            return RendererCapabilities.create(C.FORMAT_UNSUPPORTED_TYPE)
+        }
+        if (!NativeVideo.isAvailable) return RendererCapabilities.create(C.FORMAT_UNSUPPORTED_SUBTYPE)
+        return RendererCapabilities.create(
+            C.FORMAT_HANDLED,
+            RendererCapabilities.ADAPTIVE_SEAMLESS,
+            RendererCapabilities.TUNNELING_NOT_SUPPORTED,
+        )
+    }
+
+    override fun createDecoder(
+        format: Format,
+        cryptoConfig: CryptoConfig?,
+    ): Decoder<DecoderInputBuffer, VideoDecoderOutputBuffer, FfmpegVideoDecoderException> {
+        val created = FfmpegMpeg2Decoder(format, filterMode) { decoderCounters }
+        Log.i(TAG, "decoder created ${format.width}x${format.height} par=${format.pixelWidthHeightRatio} " +
+            "sequence=${created.sequenceInfo} mode=$filterMode")
+        decoder = created
+        return created
+    }
+
+    override fun renderOutputBufferToSurface(outputBuffer: VideoDecoderOutputBuffer, surface: Surface) {
+        val frame = (outputBuffer as NativeFrameBuffer).nativeFrame
+        if (surfaceOutput == 0L) surfaceOutput = NativeVideo.nativeSurfaceCreate()
+        val handle = decoder?.handle ?: 0L
+        if (!NativeVideo.nativeSurfaceRender(surfaceOutput, surface, handle, frame) && !loggedRenderFailure) {
+            loggedRenderFailure = true
+            Log.w(TAG, "failed to render a frame to the surface")
+        }
+        outputBuffer.release()
+        pollPipelineInfo()
+    }
+
+    override fun setDecoderOutputMode(outputMode: Int) {
+        decoder?.outputMode = outputMode
+    }
+
+    override fun canReuseDecoder(decoderName: String, oldFormat: Format, newFormat: Format): DecoderReuseEvaluation =
+        DecoderReuseEvaluation(
+            decoderName, oldFormat, newFormat,
+            DecoderReuseEvaluation.REUSE_RESULT_YES_WITHOUT_RECONFIGURATION, 0,
+        )
+
+    override fun onInputFormatChanged(formatHolder: FormatHolder) {
+        formatHolder.format?.let { aspect.pixelWidthHeightRatio = it.pixelWidthHeightRatio }
+        super.onInputFormatChanged(formatHolder)
+    }
+
+    override fun onQueueInputBuffer(buffer: DecoderInputBuffer) {
+        super.onQueueInputBuffer(buffer)
+        pollPipelineInfo()
+    }
+
+    override fun releaseDecoder() {
+        decoder?.let { logCounters("released", decoderCounters) }
+        if (surfaceOutput != 0L) NativeVideo.nativeSurfaceDrain(surfaceOutput)
+        super.releaseDecoder()
+        decoder = null
+    }
+
+    override fun onDisabled() {
+        super.onDisabled()
+        if (surfaceOutput != 0L) {
+            NativeVideo.nativeSurfaceRelease(surfaceOutput)
+            surfaceOutput = 0L
+        }
+    }
+
+    override fun handleMessage(messageType: Int, message: Any?) {
+        when (messageType) {
+            MSG_SET_FILTER_MODE -> {
+                val mode = message as? VideoFilterMode ?: return
+                filterMode = mode
+                decoder?.setFilterMode(mode)
+                _pipelineInfo.value = _pipelineInfo.value?.copy(requestedMode = mode)
+            }
+            Renderer.MSG_SET_VIDEO_OUTPUT -> {
+                super.handleMessage(messageType, message)
+                if (message !is Surface && surfaceOutput != 0L) NativeVideo.nativeSurfaceDetach(surfaceOutput)
+            }
+            else -> super.handleMessage(messageType, message)
+        }
+    }
+
+    private fun pollPipelineInfo() {
+        val fields = decoder?.pollInfo() ?: return
+        val backend = when (fields[3]) {
+            "opencl" -> "opencl"
+            "software" -> "cpu"
+            else -> "none"
+        }
+        val info = VideoPipelineInfo(
+            decoderName = fields[0],
+            hardware = fields[1] == "1",
+            requestedMode = filterMode,
+            effectiveMode = fields[2].toIntOrNull()?.let { VideoFilterMode.fromNative(it) },
+            filterBackend = backend,
+        )
+        if (info != _pipelineInfo.value) {
+            Log.i(TAG, "pipeline decoder=${info.decoderName} hw=${info.hardware} requested=${info.requestedMode} " +
+                "effective=${info.effectiveMode} filter=${info.filterBackend}")
+            _pipelineInfo.value = info
+        }
+    }
+
+    private fun logCounters(event: String, c: DecoderCounters) {
+        c.ensureUpdated()
+        Log.i(TAG, "$event: queued=${c.queuedInputBufferCount} rendered=${c.renderedOutputBufferCount} " +
+            "skipped=${c.skippedOutputBufferCount} dropped=${c.droppedBufferCount} " +
+            "droppedToKeyframe=${c.droppedToKeyframeCount} maxConsecutiveDropped=${c.maxConsecutiveDroppedBufferCount}")
+    }
+
+    internal class AspectState {
+        @Volatile var pixelWidthHeightRatio = 1f
+    }
+
+    /** DecoderVideoRenderer reports VideoSize without the pixel aspect ratio; restore the Format's like MediaCodecVideoRenderer does. */
+    private class AspectFixingListener(
+        private val delegate: VideoRendererEventListener,
+        private val aspect: AspectState,
+    ) : VideoRendererEventListener {
+        override fun onVideoEnabled(counters: DecoderCounters) = delegate.onVideoEnabled(counters)
+        override fun onVideoDecoderInitialized(decoderName: String, initializedTimestampMs: Long, initializationDurationMs: Long) =
+            delegate.onVideoDecoderInitialized(decoderName, initializedTimestampMs, initializationDurationMs)
+        override fun onVideoInputFormatChanged(format: Format, decoderReuseEvaluation: DecoderReuseEvaluation?) =
+            delegate.onVideoInputFormatChanged(format, decoderReuseEvaluation)
+        override fun onDroppedFrames(count: Int, elapsedMs: Long) = delegate.onDroppedFrames(count, elapsedMs)
+        override fun onVideoFrameProcessingOffset(totalProcessingOffsetUs: Long, frameCount: Int) =
+            delegate.onVideoFrameProcessingOffset(totalProcessingOffsetUs, frameCount)
+        override fun onVideoSizeChanged(videoSize: VideoSize) =
+            delegate.onVideoSizeChanged(VideoSize(videoSize.width, videoSize.height, aspect.pixelWidthHeightRatio))
+        override fun onRenderedFirstFrame(output: Any, renderTimeMs: Long) = delegate.onRenderedFirstFrame(output, renderTimeMs)
+        override fun onVideoDecoderReleased(decoderName: String) = delegate.onVideoDecoderReleased(decoderName)
+        override fun onVideoDisabled(counters: DecoderCounters) = delegate.onVideoDisabled(counters)
+        override fun onVideoCodecError(videoCodecError: Exception) = delegate.onVideoCodecError(videoCodecError)
+    }
+
+    companion object {
+        private const val TAG = "FfmpegMpeg2Renderer"
+        internal const val MSG_SET_FILTER_MODE = Renderer.MSG_CUSTOM_BASE + 0x4b56
+    }
+}
