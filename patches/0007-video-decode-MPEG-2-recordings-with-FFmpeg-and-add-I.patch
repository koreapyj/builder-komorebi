@@ -0,0 +1,63 @@
+package kr.dcmys.komorebi.video
+
+/** Fields of an MPEG-2 sequence header (+ sequence extension) as found in media3's `video/mpeg2` initialization data. */
+data class Mpeg2SequenceInfo(
+    val width: Int,
+    val height: Int,
+    val frameRateNum: Int,
+    val frameRateDen: Int,
+    /** `progressive_sequence`, or null when there is no sequence extension (MPEG-1 style header). */
+    val progressiveSequence: Boolean?,
+) {
+    /** libavutil AVFieldOrder: AV_FIELD_UNKNOWN(0), AV_FIELD_PROGRESSIVE(1), AV_FIELD_TT(2). */
+    val avFieldOrder: Int
+        get() = when (progressiveSequence) {
+            true -> 1
+            false -> 2
+            null -> 0
+        }
+
+    companion object {
+        private val FRAME_RATES = arrayOf(
+            24000 to 1001, 24 to 1, 25 to 1, 30000 to 1001, 30 to 1, 50 to 1, 60000 to 1001, 60 to 1,
+        )
+
+        fun parse(data: ByteArray?): Mpeg2SequenceInfo? {
+            if (data == null) return null
+            val header = findStartCode(data, 0xB3, 0) ?: return null
+            if (header + 8 > data.size) return null
+            val b = { i: Int -> data[header + i].toInt() and 0xFF }
+            val width = (b(4) shl 4) or (b(5) shr 4)
+            val height = ((b(5) and 0x0F) shl 8) or b(6)
+            var (num, den) = FRAME_RATES.getOrNull((b(7) and 0x0F) - 1) ?: (0 to 0)
+
+            var progressive: Boolean? = null
+            var search = header + 4
+            while (true) {
+                val ext = findStartCode(data, 0xB5, search) ?: break
+                if (ext + 10 <= data.size && (data[ext + 4].toInt() and 0xF0) == 0x10) {
+                    val e = { i: Int -> data[ext + i].toInt() and 0xFF }
+                    progressive = (e(5) and 0x08) != 0
+                    val n = (e(9) shr 5) and 0x03
+                    val d = e(9) and 0x1F
+                    if (num > 0) {
+                        num *= n + 1
+                        den *= d + 1
+                    }
+                    break
+                }
+                search = ext + 4
+            }
+            return Mpeg2SequenceInfo(width, height, num, den, progressive)
+        }
+
+        private fun findStartCode(data: ByteArray, code: Int, from: Int): Int? {
+            for (i in from until data.size - 3) {
+                if (data[i].toInt() == 0 && data[i + 1].toInt() == 0 && data[i + 2].toInt() == 1 &&
+                    (data[i + 3].toInt() and 0xFF) == code
+                ) return i
+            }
+            return null
+        }
+    }
+}
