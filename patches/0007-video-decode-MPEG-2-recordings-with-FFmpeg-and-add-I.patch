+package kr.dcmys.komorebi.video
+
+import androidx.media3.common.C
+import androidx.media3.common.Format
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.decoder.Decoder
+import androidx.media3.decoder.DecoderException
+import androidx.media3.decoder.DecoderInputBuffer
+import androidx.media3.decoder.VideoDecoderOutputBuffer
+import androidx.media3.exoplayer.DecoderCounters
+
+@UnstableApi
+class FfmpegVideoDecoderException(message: String) : DecoderException(message)
+
+@UnstableApi
+internal class NativeFrameBuffer(owner: Owner<VideoDecoderOutputBuffer>) : VideoDecoderOutputBuffer(owner) {
+    var nativeFrame = 0L
+}
+
+/**
+ * media3 [Decoder] over the native ffmpeg decoder + filter graph. The native side owns the decode
+ * thread and bounded packet/frame queues, so every method here is non-blocking.
+ *
+ * Output is N:M with respect to input (bwdif emits one frame per field, IVTC drops frames), while
+ * DecoderVideoRenderer assumes one output per queued input when it counts buffers in the codec.
+ * [InputAccounting] maps each output to the inputs it consumed and reports the difference through
+ * [VideoDecoderOutputBuffer.skippedOutputBufferCount].
+ */
+@UnstableApi
+internal class FfmpegMpeg2Decoder(
+    format: Format,
+    mode: VideoFilterMode,
+    private val counters: () -> DecoderCounters,
+) : Decoder<DecoderInputBuffer, VideoDecoderOutputBuffer, FfmpegVideoDecoderException> {
+
+    val handle: Long
+    private val inputBuffer = DecoderInputBuffer(DecoderInputBuffer.BUFFER_REPLACEMENT_MODE_DIRECT)
+    private var pendingInput = false
+    private var serial = 0
+    private var flushPending = true
+    private var outputStartTimeUs = C.TIME_UNSET
+    private val accounting = InputAccounting()
+    private var carriedSkips = 0
+    private val frameInfo = LongArray(4)
+    private val lock = Any()
+    private val outstanding = HashSet<NativeFrameBuffer>()
+    private val pool = ArrayDeque<NativeFrameBuffer>()
+    private var released = false
+    private var infoVersion = Int.MIN_VALUE
+
+    @Volatile var outputMode: Int = C.VIDEO_OUTPUT_MODE_NONE
+
+    val sequenceInfo: Mpeg2SequenceInfo? = Mpeg2SequenceInfo.parse(format.initializationData.firstOrNull())
+
+    init {
+        val info = sequenceInfo
+        handle = NativeVideo.nativeOpen(
+            format.initializationData.firstOrNull(),
+            info?.width ?: format.width.coerceAtLeast(0),
+            info?.height ?: format.height.coerceAtLeast(0),
+            format.pixelWidthHeightRatio,
+            info?.frameRateNum ?: 0,
+            info?.frameRateDen ?: 0,
+            info?.avFieldOrder ?: 0,
+            mode.nativeValue,
+            true,
+        )
+        if (handle == 0L) throw FfmpegVideoDecoderException("Failed to open the ffmpeg MPEG-2 decoder")
+    }
+
+    override fun getName(): String = "ffmpeg-mpeg2"
+
+    override fun setOutputStartTimeUs(outputStartTimeUs: Long) {
+        this.outputStartTimeUs = outputStartTimeUs
+        applyPendingFlush()
+    }
+
+    override fun dequeueInputBuffer(): DecoderInputBuffer? {
+        applyPendingFlush()
+        if (pendingInput && !pushPendingInput()) return null
+        inputBuffer.clear()
+        return inputBuffer
+    }
+
+    override fun queueInputBuffer(inputBuffer: DecoderInputBuffer) {
+        check(inputBuffer === this.inputBuffer)
+        applyPendingFlush()
+        pendingInput = true
+        pushPendingInput()
+    }
+
+    override fun dequeueOutputBuffer(): VideoDecoderOutputBuffer? {
+        applyPendingFlush()
+        if (pendingInput) pushPendingInput()
+        while (true) {
+            when (NativeVideo.nativeDequeueFrame(handle, serial, frameInfo)) {
+                NativeVideo.DEQUEUE_FRAME -> {
+                    val frame = frameInfo[0]
+                    val timeUs = frameInfo[1]
+                    val consumed = accounting.consumedBy(timeUs)
+                    if (outputStartTimeUs != C.TIME_UNSET && timeUs < outputStartTimeUs) {
+                        NativeVideo.nativeReleaseFrame(handle, frame)
+                        carriedSkips += consumed
+                        continue
+                    }
+                    val buffer = obtainBuffer()
+                    buffer.init(timeUs, if (outputMode == C.VIDEO_OUTPUT_MODE_SURFACE_YUV) outputMode else C.VIDEO_OUTPUT_MODE_NONE, null)
+                    buffer.initForPrivateFrame(frameInfo[2].toInt(), frameInfo[3].toInt())
+                    buffer.nativeFrame = frame
+                    // The renderer subtracts skipped + 1 from its in-codec count for this buffer.
+                    val skipped = carriedSkips + consumed - 1
+                    carriedSkips = 0
+                    buffer.skippedOutputBufferCount = skipped
+                    // An extra output (e.g. the second field) yields -1; the renderer adds it to
+                    // its skipped counter, so cancel that out to keep the statistic meaningful.
+                    if (skipped < 0) counters().skippedOutputBufferCount -= skipped
+                    return buffer
+                }
+                NativeVideo.DEQUEUE_END_OF_STREAM -> {
+                    val buffer = obtainBuffer()
+                    buffer.addFlag(C.BUFFER_FLAG_END_OF_STREAM)
+                    return buffer
+                }
+                else -> {
+                    val error = NativeVideo.nativeLastError(handle)
+                    if (error != 0) throw FfmpegVideoDecoderException("ffmpeg video decode thread stopped: $error")
+                    return null
+                }
+            }
+        }
+    }
+
+    override fun flush() {
+        serial++
+        flushPending = true
+        pendingInput = false
+        accounting.clear()
+        carriedSkips = 0
+    }
+
+    override fun release() {
+        synchronized(lock) {
+            released = true
+            outstanding.forEach { freeFrame(it) }
+            outstanding.clear()
+            pool.clear()
+        }
+        NativeVideo.nativeClose(handle)
+    }
+
+    fun setFilterMode(mode: VideoFilterMode) {
+        NativeVideo.nativeSetMode(handle, mode.nativeValue)
+    }
+
+    /** Returns (decoderName, hardware, effectiveNativeMode, backend) when it changed since the last call. */
+    fun pollInfo(): List<String>? {
+        val version = NativeVideo.nativeInfoVersion(handle)
+        if (version == infoVersion) return null
+        infoVersion = version
+        return NativeVideo.nativeInfo(handle)?.split('\t')?.takeIf { it.size == 4 }
+    }
+
+    private fun applyPendingFlush() {
+        if (!flushPending) return
+        flushPending = false
+        NativeVideo.nativeFlush(handle, serial, outputStartTimeUs != C.TIME_UNSET, outputStartTimeUs)
+    }
+
+    private fun pushPendingInput(): Boolean {
+        val buffer = inputBuffer
+        val result = if (buffer.isEndOfStream) {
+            NativeVideo.nativeQueueEndOfStream(handle, serial)
+        } else {
+            val data = checkNotNull(buffer.data)
+            NativeVideo.nativeQueuePacket(
+                handle, data, data.position(), data.remaining(), buffer.timeUs, buffer.isKeyFrame, serial,
+            )
+        }
+        return when (result) {
+            NativeVideo.QUEUE_OK -> {
+                if (!buffer.isEndOfStream) accounting.add(buffer.timeUs)
+                pendingInput = false
+                true
+            }
+            NativeVideo.QUEUE_FULL -> false
+            else -> throw FfmpegVideoDecoderException("Failed to queue video packet")
+        }
+    }
+
+    private fun obtainBuffer(): NativeFrameBuffer = synchronized(lock) {
+        val buffer = pool.removeLastOrNull() ?: NativeFrameBuffer(::releaseOutputBuffer)
+        outstanding.add(buffer)
+        buffer
+    }
+
+    private fun releaseOutputBuffer(buffer: VideoDecoderOutputBuffer) {
+        buffer as NativeFrameBuffer
+        synchronized(lock) {
+            if (!outstanding.remove(buffer)) return
+            freeFrame(buffer)
+            buffer.clear()
+            if (!released) pool.addLast(buffer)
+        }
+    }
+
+    private fun freeFrame(buffer: NativeFrameBuffer) {
+        if (buffer.nativeFrame != 0L) NativeVideo.nativeReleaseFrame(handle, buffer.nativeFrame)
+        buffer.nativeFrame = 0L
+    }
+}
+
+/** Timestamps of queued inputs not yet represented by an output frame. */
+internal class InputAccounting {
+    private val pending = java.util.PriorityQueue<Long>()
+
+    fun add(timeUs: Long) {
+        pending.add(timeUs)
+    }
+
+    /** Number of queued inputs presented at or before [outputTimeUs]; they are consumed by that output. */
+    fun consumedBy(outputTimeUs: Long): Int {
+        var count = 0
+        while (pending.isNotEmpty() && pending.peek()!! <= outputTimeUs) {
+            pending.poll()
+            count++
+        }
+        return count
+    }
+
+    fun clear() = pending.clear()
+
+    val size: Int get() = pending.size
+}
