+namespace aribplayer {
+namespace {
+constexpr char kTag[] = "aribplayer-decoder";
+
+constexpr std::size_t kDecodedFrameQueueCapacity = 2;
+// Bounds how long returned frames stay mapped while the filter thread has no input.
+constexpr std::chrono::milliseconds kReturnedFrameReleaseInterval{100};
+
+std::string AvError(int error) {
+    char text[AV_ERROR_MAX_STRING_SIZE]{};
+    av_strerror(error, text, sizeof(text));
+    return text;
