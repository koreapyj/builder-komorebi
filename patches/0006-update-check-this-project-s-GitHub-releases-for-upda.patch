+++ b/app/src/main/java/kr/dcmys/komorebi/update/ReleaseSelection.kt
@@ -0,0 +1,169 @@
+package kr.dcmys.komorebi.update
+
+import com.google.gson.JsonArray
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.Gson
+
+/*
+ * Release contract (shared with the CI workflow):
+ *  - stable: tag v<X.Y.Z>-<n>,        prerelease=false
+ *  - beta:   tag v<X.Y.Z-beta<k>>-<n>, prerelease=true
+ *  - main:   one rolling prerelease on the fixed tag "nightly"
+ *  - assets: komorebi-<label>-<abi>.apk, label = tag (stable/beta) or main-<n> (main),
+ *            abi in {arm64-v8a, armeabi-v7a, universal}; n = CI run number.
+ */
+
+const val MAIN_TAG = "nightly"
+const val UNIVERSAL_ABI = "universal"
+val SPLIT_ABIS = listOf("arm64-v8a", "armeabi-v7a")
+
+data class GithubAsset(val name: String, val downloadUrl: String)
+
+data class GithubRelease(
+    val tagName: String,
+    val draft: Boolean,
+    val prerelease: Boolean,
+    val body: String,
+    val assets: List<GithubAsset>,
+)
+
+data class UpdateOffer(val versionName: String, val releaseNotes: String, val apkUrl: String)
+
+/** Ordering: X.Y.Z numerically, a beta below the same X.Y.Z without suffix (betas by k), then n. */
+data class ReleaseTag(
+    val major: Int,
+    val minor: Int,
+    val patch: Int,
+    val beta: Int?,
+    val build: Long,
+) : Comparable<ReleaseTag> {
+    override fun compareTo(other: ReleaseTag): Int = COMPARATOR.compare(this, other)
+
+    companion object {
+        private val COMPARATOR = compareBy<ReleaseTag>(
+            { it.major }, { it.minor }, { it.patch },
+            { if (it.beta == null) 1 else 0 }, { it.beta ?: 0 }, { it.build },
+        )
+        private val TAG_RE = Regex("""^v(\d{1,6})\.(\d{1,6})\.(\d{1,6})(?:-beta(\d{1,6}))?-(\d{1,12})$""")
+
+        /** Returns null for anything that is not exactly a stable/beta CI tag (incl. "nightly"). */
+        fun parse(tag: String?): ReleaseTag? {
+            val m = TAG_RE.matchEntire(tag?.trim() ?: return null) ?: return null
+            val g = m.groupValues
+            return ReleaseTag(
+                g[1].toInt(), g[2].toInt(), g[3].toInt(),
+                g[4].takeIf { it.isNotEmpty() }?.toInt(), g[5].toLong(),
+            )
+        }
+    }
+}
+
+/** First asset `komorebi-<label>-<abi>.apk` matching [supportedAbis] in order, else universal. */
+fun chooseApk(assets: List<GithubAsset>, label: String, supportedAbis: List<String>): GithubAsset? {
+    fun find(abi: String) = assets.firstOrNull { it.name == "komorebi-$label-$abi.apk" }
+    for (abi in supportedAbis) {
+        if (abi in SPLIT_ABIS) find(abi)?.let { return it }
+    }
+    return find(UNIVERSAL_ABI)
+}
+
+/**
+ * stable/beta channel: the greatest non-draft CI-tagged release (prereleases only when
+ * [includePrerelease]) that has an APK for this device and is strictly newer than [installedTag].
+ * An unparsable [installedTag] (misconfigured build) never offers anything.
+ */
+fun selectTaggedUpdate(
+    releases: List<GithubRelease>,
+    installedTag: String,
+    includePrerelease: Boolean,
+    supportedAbis: List<String>,
+): UpdateOffer? {
+    val installed = ReleaseTag.parse(installedTag) ?: return null
+    return releases.asSequence()
+        .filter { !it.draft && (includePrerelease || !it.prerelease) }
+        .mapNotNull { r -> ReleaseTag.parse(r.tagName)?.let { it to r } }
+        .filter { (tag, _) -> tag > installed }
+        .sortedByDescending { (tag, _) -> tag }
+        .firstNotNullOfOrNull { (_, r) ->
+            val tagName = r.tagName.trim()
+            chooseApk(r.assets, tagName, supportedAbis)?.let {
+                UpdateOffer(tagName.removePrefix("v"), formatReleaseNotes(r.body), it.downloadUrl)
+            }
+        }
+}
+
+private val MAIN_ASSET_RE = Regex("""^komorebi-main-(\d{1,12})-(arm64-v8a|armeabi-v7a|universal)\.apk$""")
+
+/**
+ * main channel: the rolling "nightly" release; the newest build number n among its assets that has an
+ * APK for this device, offered when n > [installedBuild]. No (usable) assets -> null.
+ */
+fun selectMainUpdate(release: GithubRelease, installedBuild: Long, supportedAbis: List<String>): UpdateOffer? {
+    if (release.draft || release.tagName.trim() != MAIN_TAG) return null
+    val builds = release.assets
+        .mapNotNull { MAIN_ASSET_RE.matchEntire(it.name)?.groupValues?.get(1)?.toLongOrNull() }
+        .distinct()
+        .sortedDescending()
+    for (n in builds) {
+        if (n <= installedBuild) break
+        val apk = chooseApk(release.assets, "main-$n", supportedAbis) ?: continue
+        return UpdateOffer("main-$n", formatReleaseNotes(release.body), apk.downloadUrl)
+    }
+    return null
+}
+
+const val MAX_NOTES_CHARS = 600
+
+/** The update dialog shows plain text in a small fixed-height box: strip the noisiest Markdown and truncate. */
+fun formatReleaseNotes(body: String?, maxChars: Int = MAX_NOTES_CHARS): String {
+    val text = (body ?: "")
+        .replace("\r\n", "\n")
+        .replace(Regex("""<!--.*?-->""", RegexOption.DOT_MATCHES_ALL), "")
+        .lines()
+        .joinToString("\n") { line ->
+            line.trimEnd()
+                .replace(Regex("""^\s{0,3}#{1,6}\s+"""), "")
+                .replace(Regex("""^(\s*)[*+]\s+"""), "$1・")
+                .replace(Regex("""^(\s*)-\s+"""), "$1・")
+                .replace(Regex("""\[([^\]]*)]\((https?://[^)]*)\)"""), "$1")
+                .replace("**", "")
+                .replace("`", "")
+        }
+        .replace(Regex("""\n{3,}"""), "\n\n")
+        .trim()
+    if (text.isEmpty()) return "リリースノートはありません。"
+    if (text.length <= maxChars) return text
+    return text.take(maxChars).trimEnd() + "…"
+}
+
+// Gson.fromJson works on every Gson version on the classpath (JsonParser.parseString needs 2.8.6+).
+private fun parseJson(json: String): JsonElement =
+    Gson().fromJson(json, JsonElement::class.java) ?: throw IllegalArgumentException("empty JSON")
+
+private fun JsonObject.str(name: String): String? =
+    get(name)?.takeIf { it.isJsonPrimitive }?.asString
+
+private fun JsonObject.bool(name: String): Boolean =
+    get(name)?.takeIf { it.isJsonPrimitive }?.let { runCatching { it.asBoolean }.getOrNull() } ?: false
+
+private fun releaseFrom(e: JsonElement): GithubRelease? {
+    if (!e.isJsonObject) return null
+    val o = e.asJsonObject
+    val tag = o.str("tag_name") ?: return null
+    val assets = (o.get("assets") as? JsonArray)?.mapNotNull { a ->
+        if (!a.isJsonObject) return@mapNotNull null
+        val ao = a.asJsonObject
+        val name = ao.str("name") ?: return@mapNotNull null
+        val url = ao.str("browser_download_url") ?: return@mapNotNull null
+        GithubAsset(name, url)
+    } ?: emptyList()
+    return GithubRelease(tag, o.bool("draft"), o.bool("prerelease"), o.str("body") ?: "", assets)
+}
+
+/** GET /repos/{repo}/releases body; throws on non-JSON / non-array. */
+fun parseReleaseList(json: String): List<GithubRelease> =
+    parseJson(json).asJsonArray.mapNotNull(::releaseFrom)
+
+/** GET /repos/{repo}/releases/tags/{tag} body; throws on non-JSON, null if not a release object. */
+fun parseRelease(json: String): GithubRelease? = releaseFrom(parseJson(json))
