+package kr.dcmys.komorebi.update
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ReleaseSelectionTest {
+
+    private val arm64 = listOf("arm64-v8a", "armeabi-v7a", "armeabi")
+    private val arm32 = listOf("armeabi-v7a", "armeabi")
+    private val x86 = listOf("x86_64", "x86")
+
+    private fun assets(label: String, vararg abis: String = arrayOf("arm64-v8a", "armeabi-v7a", "universal")) =
+        abis.map { GithubAsset("komorebi-$label-$it.apk", "https://dl/$label/$it") }
+
+    private fun rel(tag: String, pre: Boolean = false, draft: Boolean = false, body: String = "notes $tag",
+                    assets: List<GithubAsset> = assets(tag)) =
+        GithubRelease(tag, draft, pre, body, assets)
+
+    @Test
+    fun orderingTable() {
+        val ordered = listOf(
+            "v0.9.0-beta2-1", "v1.1.0-beta7-2", "v1.1.0-1", "v1.1.1-3", "v1.1.1-4",
+            "v1.2.0-beta1-5", "v1.2.0-beta2-6", "v1.2.0-7", "v1.10.0-8",
+        ).map { ReleaseTag.parse(it)!! }
+        for (i in ordered.indices) for (j in ordered.indices) {
+            assertEquals("${ordered[i]} vs ${ordered[j]}", i.compareTo(j).coerceIn(-1, 1),
+                ordered[i].compareTo(ordered[j]).coerceIn(-1, 1))
+        }
+        assertTrue(ReleaseTag.parse("v1.1.1-1")!! > ReleaseTag.parse("v1.1.0-999")!!)
+        assertTrue(ReleaseTag.parse("v1.2.0-beta10-1")!! > ReleaseTag.parse("v1.2.0-beta9-2")!!)
+    }
+
+    @Test
+    fun parsesFields() {
+        assertEquals(ReleaseTag(1, 2, 0, 1, 124), ReleaseTag.parse("v1.2.0-beta1-124"))
+        assertEquals(ReleaseTag(1, 1, 1, null, 123), ReleaseTag.parse("v1.1.1-123"))
+    }
+
+    @Test
+    fun malformedTagsRejected() {
+        listOf(
+            null, "", "main", "nightly", "1.1.1-123", "v1.1.1", "v1.1-5", "v1.1.1-beta-5", "v1.1.1-beta1",
+            "v1.1.1-rc1-5", "v1.1.1-5-extra", "V1.1.1-5", "v1.1.1--5", "va.b.c-1", "v1.1.1-Stable",
+            "v1.1.1-99999999999999999",
+        ).forEach { assertNull(it, ReleaseTag.parse(it)) }
+    }
+
+    private val list = listOf(
+        rel("nightly", pre = true, assets = assets("main-130")),
+        rel("v1.2.0-beta2-129", pre = true),
+        rel("v1.2.0-beta1-125", pre = true),
+        rel("v1.1.1-124"),
+        rel("v1.1.1-120"),
+        rel("v1.1.0-100"),
+        rel("v1.3.0-140", draft = true),
+        rel("garbage"),
+    )
+
+    @Test
+    fun stableOnlyWhenBetaOff() {
+        val offer = selectTaggedUpdate(list, "v1.1.0-100", includePrerelease = false, supportedAbis = arm64)!!
+        assertEquals("1.1.1-124", offer.versionName)
+        assertEquals("https://dl/v1.1.1-124/arm64-v8a", offer.apkUrl)
+        assertEquals("notes v1.1.1-124", offer.releaseNotes)
+    }
+
+    @Test
+    fun betaIncludedWhenOn() {
+        val offer = selectTaggedUpdate(list, "v1.1.0-100", includePrerelease = true, supportedAbis = arm64)!!
+        assertEquals("1.2.0-beta2-129", offer.versionName)
+    }
+
+    @Test
+    fun draftsIgnored() {
+        val offer = selectTaggedUpdate(list, "v1.2.0-beta2-129", includePrerelease = true, supportedAbis = arm64)
+        assertNull(offer)
+    }
+
+    @Test
+    fun sameVersionNewerBuildIsUpdate() {
+        val offer = selectTaggedUpdate(list, "v1.1.1-120", includePrerelease = false, supportedAbis = arm64)!!
+        assertEquals("1.1.1-124", offer.versionName)
+    }
+
+    @Test
+    fun notOfferedWhenInstalledIsNewestOrNewer() {
+        assertNull(selectTaggedUpdate(list, "v1.1.1-124", false, arm64))
+        // installed beta, beta setting off: stable 1.1.1 is older than 1.2.0-beta1 -> nothing
+        assertNull(selectTaggedUpdate(list, "v1.2.0-beta1-125", false, arm64))
+    }
+
+    @Test
+    fun betaInstalledGetsFinalStable() {
+        val l = list + rel("v1.2.0-131")
+        assertEquals("1.2.0-131", selectTaggedUpdate(l, "v1.2.0-beta2-129", false, arm64)!!.versionName)
+    }
+
+    @Test
+    fun unparsableInstalledTagOffersNothing() {
+        assertNull(selectTaggedUpdate(list, "", true, arm64))
+        assertNull(selectTaggedUpdate(list, "main", true, arm64))
+    }
+
+    @Test
+    fun releaseWithoutUsableAssetFallsBackToNextBest() {
+        val l = listOf(
+            rel("v1.1.2-130", assets = emptyList()), // assets still uploading
+            rel("v1.1.1-124"),
+        )
