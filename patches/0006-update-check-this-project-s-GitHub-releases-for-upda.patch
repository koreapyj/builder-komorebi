+    @Test
+    fun notesFormattedAndTruncated() {
+        assertEquals("リリースノートはありません。", formatReleaseNotes(null))
+        assertEquals("リリースノートはありません。", formatReleaseNotes("  \r\n "))
+        val md = "## What's Changed\r\n* **fix** `x` by @a in [#1](https://github.com/a/b/pull/1)\r\n<!-- c -->"
+        assertEquals("What's Changed\n・fix x by @a in #1", formatReleaseNotes(md))
+        val long = formatReleaseNotes("a".repeat(5000))
+        assertEquals(MAX_NOTES_CHARS + 1, long.length)
+        assertTrue(long.endsWith("…"))
+        assertNotNull(formatReleaseNotes("- item"))
+        assertEquals("・item", formatReleaseNotes("- item"))
+    }
