+    @Test
+    fun parsesGithubJson() {
+        val json = """
+            [{"tag_name":"v1.1.1-123","draft":false,"prerelease":false,"body":null,
+              "assets":[{"name":"komorebi-v1.1.1-123-universal.apk","browser_download_url":"https://x/u.apk","size":1}]},
+             {"tag_name":"nightly","draft":false,"prerelease":true,"body":"b","assets":[]},
+             {"no_tag":true}, 5]
+        """.trimIndent()
+        val l = parseReleaseList(json)
+        assertEquals(2, l.size)
+        assertEquals(GithubRelease("v1.1.1-123", false, false, "",
+            listOf(GithubAsset("komorebi-v1.1.1-123-universal.apk", "https://x/u.apk"))), l[0])
+        assertTrue(l[1].prerelease)
+        val one = parseRelease("""{"tag_name":"nightly","prerelease":true,"body":"x","assets":[{"name":"n"}]}""")!!
+        assertEquals(0, one.assets.size)
+        assertNull(parseRelease("""{"message":"Not Found"}"""))
+    }
