diff --git a/app/src/main/java/kr/dcmys/komorebi/update/GithubReleaseUpdater.kt b/app/src/main/java/kr/dcmys/komorebi/update/GithubReleaseUpdater.kt
new file mode 100644
index 0000000..9ef1a9e
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/update/GithubReleaseUpdater.kt
@@ -0,0 +1,80 @@
+package kr.dcmys.komorebi.update
+
+import android.os.Build
+import android.util.Log
+import com.beeregg2001.komorebi.BuildConfig
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.IOException
+
+/** Configured at build time through BuildConfig.UPDATE_* (Gradle properties komorebiUpdate*). */
+object GithubReleaseUpdater {
+
+    sealed class Result {
+        object Disabled : Result()
+        object UpToDate : Result()
+        data class Available(val offer: UpdateOffer) : Result()
+        data class Failed(val message: String) : Result()
+    }
+
+    private const val TAG = "GithubReleaseUpdater"
+    private const val API = "https://api.github.com"
+
+    val isConfigured: Boolean
+        get() = BuildConfig.UPDATE_REPO.isNotBlank() && BuildConfig.UPDATE_CHANNEL.isNotBlank()
+
+    /** Blocking; call on an IO dispatcher. Never throws. */
+    fun check(client: OkHttpClient, receiveBetaUpdates: Boolean): Result {
+        val repo = BuildConfig.UPDATE_REPO.trim()
+        val channel = BuildConfig.UPDATE_CHANNEL.trim()
+        if (repo.isEmpty() || channel.isEmpty()) return Result.Disabled
+        val abis = Build.SUPPORTED_ABIS?.toList() ?: emptyList()
+        return try {
+            when (channel) {
+                "main" -> {
+                    val json = get(client, "$API/repos/$repo/releases/tags/$MAIN_TAG")
+                        ?: return Result.UpToDate
+                    val release = parseRelease(json) ?: return Result.UpToDate
+                    selectMainUpdate(release, BuildConfig.UPDATE_BUILD_NUMBER.toLong(), abis)
+                }
+                "stable", "beta" -> {
+                    val json = get(client, "$API/repos/$repo/releases?per_page=30")
+                        ?: throw HttpFailure(404)
+                    selectTaggedUpdate(parseReleaseList(json), BuildConfig.UPDATE_TAG, receiveBetaUpdates, abis)
+                }
+                else -> return Result.Disabled
+            }?.let { Result.Available(it) } ?: Result.UpToDate
+        } catch (e: RateLimited) {
+            Result.Failed("アップデート確認の回数制限に達しました。しばらくしてから再度お試しください")
+        } catch (e: HttpFailure) {
+            Result.Failed("アップデート情報の取得に失敗しました (HTTP ${e.code})")
+        } catch (e: IOException) {
+            Log.w(TAG, "Update check failed", e)
+            Result.Failed("ネットワークエラーが発生しました")
+        } catch (e: Exception) {
+            Log.e(TAG, "Update check failed", e)
+            Result.Failed("アップデート情報の解析に失敗しました")
+        }
+    }
+
+    private class RateLimited : Exception()
+    private class HttpFailure(val code: Int) : Exception()
+
+    /** Body of a successful GET; null on 404; throws on other failures. */
+    private fun get(client: OkHttpClient, url: String): String? {
+        val request = Request.Builder()
+            .url(url)
+            .header("Accept", "application/vnd.github+json")
+            .header("X-GitHub-Api-Version", "2022-11-28")
+            .header("User-Agent", "Komorebi/${BuildConfig.VERSION_NAME} (Android)")
+            .build()
+        client.newCall(request).execute().use { response ->
+            when {
+                response.isSuccessful -> return response.body?.string() ?: throw IOException("empty body")
+                response.code == 404 -> return null
+                response.code == 403 || response.code == 429 -> throw RateLimited()
+                else -> throw HttpFailure(response.code)
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/update/ReleaseSelection.kt b/app/src/main/java/kr/dcmys/komorebi/update/ReleaseSelection.kt
