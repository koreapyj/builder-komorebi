From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yoonji Park <koreapyj@dcmys.kr>
Date: Wed, 25 Nov 2026 04:51:18 +0900
Subject: [PATCH] build: add libass binding and unit-test dependencies

Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index e3e4f64..2bfc423 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -70,6 +70,7 @@ android {
         // java.time などの Java 8+ API を Android 7.0(API 24)以降で利用する。
         isCoreLibraryDesugaringEnabled = true
     }
+    packaging { jniLibs { pickFirsts += "**/libc++_shared.so" } }
     buildFeatures {
         compose = true
         buildConfig = true // ★ BuildConfigクラスの生成を有効化
@@ -215,4 +216,7 @@ dependencies {
 
 //    implementation("org.videolan.android:libvlc-all:3.7.0")
     implementation(fileTree(mapOf("dir" to "libs", "include" to listOf("*.aar"))))
+    implementation("io.github.peerless2012:ass-kt:0.5.1")
+    testImplementation("junit:junit:4.13.2")
+    testImplementation("net.sf.kxml:kxml2:2.3.0")
 }
