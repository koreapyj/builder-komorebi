+package kr.dcmys.komorebi.iptv
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import org.kxml2.io.KXmlParser
+import java.io.StringReader
+import java.util.concurrent.atomic.AtomicInteger
+
+class IptvStoreLogicTest {
+
+    @Test
+    fun concurrentCallersShareOneFetchButLaterCallsFetchAgain() = runBlocking {
+        val flight = SingleFlight<Int>(CoroutineScope(SupervisorJob() + Dispatchers.Default))
+        val calls = AtomicInteger()
+        val gate = CompletableDeferred<Unit>()
+        val block: suspend () -> Int = { gate.await(); calls.incrementAndGet() }
+
+        val waiters = (1..5).map { async(Dispatchers.Default) { flight.run(block) } }
+        Thread.sleep(100)
+        gate.complete(Unit)
+        assertEquals(listOf(1, 1, 1, 1, 1), waiters.awaitAll())
+        assertEquals(1, calls.get())
+
+        assertEquals(2, flight.run(block))
+    }
+
+    @Test
+    fun sharedFailureReachesEveryCallerAndDoesNotStick() = runBlocking {
+        val flight = SingleFlight<Int>(CoroutineScope(SupervisorJob() + Dispatchers.Default))
+        val gate = CompletableDeferred<Unit>()
+        val waiters = (1..3).map {
+            async(Dispatchers.Default) {
+                runCatching { flight.run { gate.await(); throw IllegalStateException("boom") } }
+            }
+        }
+        Thread.sleep(100)
+        gate.complete(Unit)
+        waiters.awaitAll().forEach { assertEquals("boom", it.exceptionOrNull()?.message) }
+        assertEquals(7, flight.run { 7 })
+    }
+
+    @Test
+    fun smallerChannelSetIsCoveredLargerIsNot() {
+        val urls = setOf("u1", "u2")
+        val ids = setOf("a", "b", "c")
+        assertTrue(IptvEpgIndex.covers(urls, ids, listOf("u1"), setOf("a")))
+        assertTrue(IptvEpgIndex.covers(urls, ids, listOf("u1", "u2"), ids))
+        assertFalse(IptvEpgIndex.covers(urls, ids, listOf("u1", "u3"), setOf("a")))
+        assertFalse(IptvEpgIndex.covers(urls, ids, listOf("u1"), setOf("a", "d")))
+    }
+
+    @Test
+    fun reparseOnlyForNewIdsAndKeepTheUnion() {
+        assertTrue(IptvEpgIndex.needsParse(null, setOf("a")))
+        assertFalse(IptvEpgIndex.needsParse(setOf("a", "b"), setOf("a")))
+        assertTrue(IptvEpgIndex.needsParse(setOf("a", "b"), setOf("a", "c")))
+        assertEquals(setOf("a", "b", "c"), IptvEpgIndex.parseSet(setOf("a", "b"), setOf("a", "c")))
+        assertEquals(setOf("a"), IptvEpgIndex.parseSet(null, setOf("a")))
+    }
+
+    @Test
+    fun xmltvCheckpointCanAbortAParse() {
+        val n = XmltvParser.CHECKPOINT_INTERVAL * 3
+        val xml = buildString {
+            append("<tv>")
+            repeat(n) { append("<programme channel=\"c\" start=\"20261124000000\" stop=\"20261124010000\"><title>t</title></programme>") }
+            append("</tv>")
+        }
+        val parser = KXmlParser().apply { setInput(StringReader(xml)) }
+        var seen = 0
+        var checks = 0
+        try {
+            XmltvParser.parse(parser, checkpoint = { if (++checks == 2) throw IllegalStateException("stop") }) { seen++ }
+            fail("expected abort")
+        } catch (e: IllegalStateException) {
+            assertEquals("stop", e.message)
+        }
+        assertTrue(seen < n)
+        assertEquals(XmltvParser.CHECKPOINT_INTERVAL * 2 - 1, seen)
+    }
+}
