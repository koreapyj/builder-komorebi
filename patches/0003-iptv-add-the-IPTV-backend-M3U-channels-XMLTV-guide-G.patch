+package kr.dcmys.komorebi.iptv
+
+import com.beeregg2001.komorebi.util.TitleNormalizer
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZoneOffset
+
+class IptvDvrMapperTest {
+
+    private val tokyo = ZoneId.of("Asia/Tokyo")
+
+    @Test
+    fun parsesRealFileNames() {
+        val mx = IptvDvrMapper.parseFileName(
+            "ＴＯＫＹＯ　ＭＸ１ - 凶乱令嬢ニア・リストン　病弱令嬢に転生した神殺しの武人の華麗なる無双録　＃８.ts"
+        )
+        assertEquals("TOKYO MX1", mx.channel)
+        assertEquals("凶乱令嬢ニア・リストン 病弱令嬢に転生した神殺しの武人の華麗なる無双録 #8", mx.title)
+
+        val atx = IptvDvrMapper.parseFileName("ＡＴ－Ｘ - 千歳くんはラムネ瓶のなか　＃２０　🈑.ts")
+        assertEquals("AT-X", atx.channel)
+        assertEquals("千歳くんはラムネ瓶のなか #20 [字]", atx.title)
+
+        val ntv = IptvDvrMapper.parseFileName(
+            "日テレ１ - 「劇場版　薬屋のひとりごと　亡妃の秘宝」公開記念！ＴＶシリーズ傑作選　　＃３.ts"
+        )
