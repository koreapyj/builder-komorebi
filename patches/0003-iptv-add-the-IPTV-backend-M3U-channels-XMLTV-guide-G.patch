index 0000000..5d9d787
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvEpgIndex.kt
@@ -0,0 +1,72 @@
+package kr.dcmys.komorebi.iptv
+
+internal object IptvEpgIndex {
+
+    /**
+     * Duplicates of the same start are dropped (first source wins); a programme without a usable
+     * stop time ends where the next one starts (dropped if it is last).
+     */
+    fun build(sources: Collection<Map<String, List<IptvProgramme>>>): Map<String, List<IptvProgramme>> {
+        val merged = HashMap<String, MutableList<IptvProgramme>>()
+        for (bySource in sources) {
+            for ((ch, list) in bySource) merged.getOrPut(ch) { ArrayList() }.addAll(list)
+        }
+        val result = HashMap<String, List<IptvProgramme>>(merged.size)
+        for ((ch, list) in merged) {
+            // sortedBy is stable, so the first source wins among equal start times.
+            val sorted = list.sortedBy { it.startMs }
+            val out = ArrayList<IptvProgramme>(sorted.size)
+            for (i in sorted.indices) {
+                val p = sorted[i]
+                if (out.isNotEmpty() && out.last().startMs == p.startMs) continue
+                if (p.stopMs > p.startMs) {
+                    out += p
+                } else {
+                    val next = sorted.subList(i + 1, sorted.size).firstOrNull { it.startMs > p.startMs }
+                    if (next != null) out += p.copy(stopMs = next.startMs)
+                }
+            }
+            if (out.isNotEmpty()) result[ch] = out
+        }
+        return result
+    }
+
+    fun covers(coveredUrls: Set<String>, coveredIds: Set<String>, urls: Collection<String>, ids: Set<String>): Boolean =
+        coveredUrls.containsAll(urls) && coveredIds.containsAll(ids)
+
+    fun needsParse(parsedFor: Set<String>?, desired: Set<String>): Boolean =
+        parsedFor == null || !parsedFor.containsAll(desired)
+
+    /** Union, so ids of a playlist that is only temporarily missing are not dropped. */
+    fun parseSet(parsedFor: Set<String>?, desired: Set<String>): Set<String> =
+        if (parsedFor == null) desired else parsedFor + desired
+
+    /** [list] must be sorted by start. */
+    fun nowNext(list: List<IptvProgramme>, atMs: Long): Pair<IptvProgramme?, IptvProgramme?> {
+        val nextIdx = upperBound(list, atMs)
+        val now = list.getOrNull(nextIdx - 1)?.takeIf { it.stopMs > atMs }
+        return now to list.getOrNull(nextIdx)
+    }
+
+    /** [list] must be sorted by start. */
+    fun range(list: List<IptvProgramme>, fromMs: Long, toMs: Long): List<IptvProgramme> {
+        if (fromMs >= toMs) return emptyList()
+        val end = upperBound(list, toMs - 1)
+        val result = ArrayList<IptvProgramme>()
+        for (i in 0 until end) {
+            val p = list[i]
+            if (p.stopMs > fromMs) result += p
+        }
+        return result
+    }
+
+    private fun upperBound(list: List<IptvProgramme>, atMs: Long): Int {
+        var lo = 0
+        var hi = list.size
+        while (lo < hi) {
+            val mid = (lo + hi) ushr 1
+            if (list[mid].startMs <= atMs) lo = mid + 1 else hi = mid
+        }
+        return lo
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/IptvEpgRepository.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvEpgRepository.kt
