+package kr.dcmys.komorebi.iptv
+
+val FIXED_EPG_TABS: List<Pair<String, String>> = listOf(
+    "地デジ" to "GR", "BS" to "BS", "CS" to "CS", "BS4K" to "BS4K", "SKY" to "SKY"
+)
+
+fun epgGuideTabs(availableTypes: Collection<String>): List<Pair<String, String>> {
+    // 空 = チャンネル一覧が未読み込み
+    if (availableTypes.isEmpty()) return FIXED_EPG_TABS
+    val fixedTypes = FIXED_EPG_TABS.map { it.second }.toSet()
+    val fixed = FIXED_EPG_TABS.filter { it.second in availableTypes }
+    val others = availableTypes.filter { it !in fixedTypes }.distinct().map { it to it }
+    return fixed + others
+}
+
+fun hasNonFixedEpgTypes(availableTypes: Collection<String>): Boolean =
+    availableTypes.any { type -> FIXED_EPG_TABS.none { it.second == type } }
