diff --git a/app/src/main/java/com/beeregg2001/komorebi/data/repository/EpgRepository.kt b/app/src/main/java/com/beeregg2001/komorebi/data/repository/EpgRepository.kt
index 1bea6dc..7319de0 100644
--- a/app/src/main/java/com/beeregg2001/komorebi/data/repository/EpgRepository.kt
+++ b/app/src/main/java/com/beeregg2001/komorebi/data/repository/EpgRepository.kt
@@ -54,6 +54,15 @@ class EpgRepository @Inject constructor(
 ) {
     private val memoryCache = ConcurrentHashMap<String, List<EpgChannelWrapper>>()
 
+    // バックエンド切替時に呼ぶ(ファイルキャッシュは Room の消去で無効になる)
+    fun clearMemoryCache() = memoryCache.clear()
+
+    // 種別名をファイル名に安全な形へ(固定種別は従来どおり。IPTV のグループ名はハッシュ化)
+    private fun cacheFileName(channelType: String): String =
+        if (channelType.matches(Regex("[A-Za-z0-9_-]+"))) "epg_cache_${channelType}.json.gz"
+        else "epg_cache_h" + java.security.MessageDigest.getInstance("SHA-256")
+            .digest(channelType.toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) } + ".json.gz"
+
     // ==========================================
     // ★ 高速ファイルキャッシュ処理
     // ==========================================
@@ -61,7 +70,7 @@ class EpgRepository @Inject constructor(
     @OptIn(UnstableApi::class)
     private suspend fun saveToFileCache(channelType: String, channels: List<EpgChannelWrapper>) = withContext(Dispatchers.IO) {
         try {
-            val cacheFile = java.io.File(context.cacheDir, "epg_cache_${channelType}.json.gz")
+            val cacheFile = java.io.File(context.cacheDir, cacheFileName(channelType))
             // 直接GZIP圧縮しながらファイルへ書き込む（Base64のオーバーヘッドを削減）
             java.io.FileOutputStream(cacheFile).use { fos ->
                 GZIPOutputStream(fos).use { gzip ->
@@ -96,7 +105,7 @@ class EpgRepository @Inject constructor(
 
             if (entity == null) return@withContext null
 
-            val cacheFile = java.io.File(context.cacheDir, "epg_cache_${channelType}.json.gz")
+            val cacheFile = java.io.File(context.cacheDir, cacheFileName(channelType))
             if (!cacheFile.exists()) return@withContext null
 
             // ファイルから解凍しながら直接文字列として読み込む
