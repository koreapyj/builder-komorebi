+        assertEquals((1..100).toList(), IptvDvrMapper.page(items, 1, 100))
+        assertEquals((201..250).toList(), IptvDvrMapper.page(items, 3, 100))
+        assertTrue(IptvDvrMapper.page(items, 4, 100).isEmpty())
+        assertTrue(IptvDvrMapper.page(items, 0, 100).isEmpty())
+        assertTrue(IptvDvrMapper.page(emptyList<Int>(), 1, 100).isEmpty())
+        assertTrue(IptvDvrMapper.page(items, Int.MAX_VALUE, 100).isEmpty())
+    }
