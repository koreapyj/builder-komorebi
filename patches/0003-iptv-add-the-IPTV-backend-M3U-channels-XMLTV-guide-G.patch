+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class EpgGuideTabsTest {
+
+    @Test
+    fun emptyAvailableYieldsAllFixedTabs() {
+        assertEquals(FIXED_EPG_TABS, epgGuideTabs(emptyList()))
+    }
+
+    @Test
+    fun fixedTypesKeepUpstreamLabelsAndOrder() {
+        assertEquals(
+            listOf("地デジ" to "GR", "BS" to "BS", "SKY" to "SKY"),
+            epgGuideTabs(listOf("SKY", "BS", "GR"))
+        )
+    }
+
+    @Test
+    fun otherTypesFollowInGivenOrderWithRawLabels() {
+        assertEquals(
+            listOf("地デジ･ＢＳ･ＣＳ" to "地デジ･ＢＳ･ＣＳ", "abema" to "abema", "laftel" to "laftel"),
+            epgGuideTabs(listOf("地デジ･ＢＳ･ＣＳ", "abema", "laftel", "abema"))
+        )
+        assertEquals(
+            listOf("BS" to "BS", "abema" to "abema"),
+            epgGuideTabs(listOf("abema", "BS"))
+        )
+    }
+
+    @Test
+    fun detectsNonFixedTypes() {
+        assertFalse(hasNonFixedEpgTypes(listOf("GR", "BS", "CS", "BS4K", "SKY")))
+        assertTrue(hasNonFixedEpgTypes(listOf("GR", "abema")))
+    }
+
+    @Test
+    fun capabilitiesOnlyDropFeaturesForIptv() {
+        for (type in listOf("KONOMITV", "EDCB", "EPGSTATION")) {
+            assertTrue(backendSupportsReservations(type))
+            assertTrue(backendSupportsLiveRecording(type))
+            assertTrue(backendSupportsJikkyo(type))
+            assertTrue(backendSupportsStreamSourceSelection(type))
+        }
+        assertFalse(backendSupportsReservations("IPTV"))
+        assertFalse(backendSupportsLiveRecording("IPTV"))
+        assertFalse(backendSupportsJikkyo("IPTV"))
+        assertFalse(backendSupportsStreamSourceSelection("IPTV"))
+    }
+}
