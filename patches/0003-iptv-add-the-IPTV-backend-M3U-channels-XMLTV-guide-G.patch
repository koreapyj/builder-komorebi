+package kr.dcmys.komorebi.iptv
+
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import okhttp3.OkHttpClient
+import java.util.concurrent.TimeUnit
+import javax.inject.Qualifier
+import javax.inject.Singleton
+
+/**
+ * Upstream's unqualified OkHttpClient rewrites every request to the KonomiTV host and trusts
+ * every certificate, so it must never be used for this backend.
+ */
+@Qualifier
+@Retention(AnnotationRetention.BINARY)
+annotation class IptvHttp
+
+@Module
+@InstallIn(SingletonComponent::class)
+object IptvModule {
+
+    @Provides
+    @Singleton
+    @IptvHttp
+    fun provideIptvHttpClient(): OkHttpClient =
+        OkHttpClient.Builder()
+            .connectTimeout(15, TimeUnit.SECONDS)
+            .readTimeout(30, TimeUnit.SECONDS)
+            .writeTimeout(30, TimeUnit.SECONDS)
+            .followRedirects(true)
+            .followSslRedirects(true)
+            .retryOnConnectionFailure(true)
+            .build()
+}
