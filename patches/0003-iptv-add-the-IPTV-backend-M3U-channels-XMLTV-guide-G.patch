+package kr.dcmys.komorebi.iptv
+
+import com.beeregg2001.komorebi.data.model.ChannelApiResponse
+import com.beeregg2001.komorebi.data.repository.LiveProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class IptvLiveRepository @Inject constructor(
+    private val store: IptvStore,
+) : LiveProvider {
+
+    private companion object {
+        const val FIRST_EPG_WAIT_MS = 5_000L
+    }
+
+    override suspend fun getChannels(): ChannelApiResponse {
+        val channels = store.loadChannels()
+        // The first poll after a cold start would otherwise race the guide load
+        // and show every channel as off the air until the next poll a minute later.
+        store.awaitEpg(FIRST_EPG_WAIT_MS)
+        val now = System.currentTimeMillis()
+        // Mapping (ISO formatting, detail sections) is CPU work; keep it off the caller's (Main) thread.
+        return withContext(Dispatchers.Default) {
+            IptvMapper.toChannelApiResponse(channels, { tvgId -> store.nowNext(tvgId, now) })
+        }
+    }
+
+    override suspend fun getLiveStreamUrl(channelId: String, quality: String, streamNumber: Int): String {
+        val channel = store.channel(channelId)
+            ?: (if (store.channels.isEmpty()) { store.loadChannels(); store.channel(channelId) } else null)
+            ?: throw IllegalStateException("チャンネルが見つかりません ($channelId)。\nチャンネル一覧を更新してください。")
+        return channel.streamUrl
+    }
+
+    /** Never triggers a load: the guide resolves logos one channel at a time and an unreachable server would stall it for minutes. */
+    override suspend fun getChannelLogoUrl(channelId: String): String =
+        store.channel(channelId)?.logo.orEmpty()
+}
