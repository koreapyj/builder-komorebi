+import java.io.IOException
+import java.time.Instant
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/** Messages are user-visible (Japanese); never include the token or key. */
+class IptvDvrException(message: String, cause: Throwable? = null) : IOException(message, cause)
+
+class DriveRange(val bytes: ByteArray, val totalSize: Long?)
+
+/** Never logs or persists the access token or the DVR key. */
+@Singleton
+class IptvDvrClient @Inject constructor(
+    @IptvHttp private val client: OkHttpClient,
+    private val store: IptvStore,
+    private val settingsRepository: SettingsRepository,
+) {
+    private class CachedConfig(val configUrl: String, val dvr: IptvDvrConfig?, val atMs: Long)
+
+    private class Token(
+        val dvr: IptvDvrConfig,
+        val accessToken: String,
+        /** Monotonic clock ([SystemClock.elapsedRealtime]); a TV box's wall clock may be wrong. */
+        val expiresAtMono: Long,
+        val rootFolderId: String,
+    )
+
+    private val configMutex = Mutex()
+    private val tokenMutex = Mutex()
+
+    @Volatile
+    private var config: CachedConfig? = null
+
+    @Volatile
+    private var token: Token? = null
+
+    suspend fun dvrConfig(): IptvDvrConfig? {
+        val url = settingsRepository.iptvConfigUrl.first().trim()
+        fresh(url)?.let { return it.dvr }
+        return configMutex.withLock {
+            fresh(url)?.let { return@withLock it.dvr }
+            val loaded = try {
+                store.loadConfig().dvr
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                val stale = config
+                if (stale != null && stale.configUrl == url) return@withLock stale.dvr
+                throw e
+            }
+            config = CachedConfig(url, loaded, SystemClock.elapsedRealtime())
+            loaded
+        }
+    }
+
+    private fun fresh(url: String): CachedConfig? =
+        config?.takeIf { it.configUrl == url && SystemClock.elapsedRealtime() - it.atMs < CONFIG_TTL_MS }
+
+    private fun Token.isUsable(dvr: IptvDvrConfig): Boolean =
+        this.dvr == dvr && SystemClock.elapsedRealtime() < expiresAtMono - EXPIRY_MARGIN_MS
+
+    /** With [forceRefresh], a token issued by another caller while waiting for the lock is reused. */
+    private suspend fun validToken(forceRefresh: Boolean = false): Token {
+        val dvr = dvrConfig() ?: throw IptvDvrException("DVR が設定されていません。")
+        val seen = token
+        if (!forceRefresh && seen != null && seen.isUsable(dvr)) return seen
+        return tokenMutex.withLock {
+            val current = token
+            if (current != null && current.isUsable(dvr) && (!forceRefresh || current !== seen)) {
+                current
+            } else {
+                fetchToken(dvr).also { token = it }
+            }
+        }
+    }
+
+    fun invalidateToken() {
+        token = null
+    }
+
+    /** BLOCKING on a token miss: call from ExoPlayer's loader thread (DataSource.open()), never the main thread. */
+    fun authHeadersBlocking(): Map<String, String> = try {
+        runBlocking(Dispatchers.IO) { mapOf("Authorization" to "Bearer ${validToken().accessToken}") }
+    } catch (e: IOException) {
+        throw e
+    } catch (e: InterruptedException) {
+        throw IOException("interrupted", e)
+    } catch (e: Exception) {
+        throw IOException(e.message ?: e.javaClass.simpleName, e)
+    }
+
+    private suspend fun fetchToken(dvr: IptvDvrConfig): Token = withContext(Dispatchers.IO) {
+        val request = try {
+            Request.Builder()
+                .url(dvr.url)
+                .header("Authorization", "Bearer ${dvr.key}")
+                .header("Accept", "application/json")
+                .get()
+                .build()
+        } catch (e: IllegalArgumentException) {
+            throw IptvDvrException("DVR のトークン URL が不正です。", e)
+        }
+        try {
+            client.newCall(request).execute().use { response ->
+                if (!response.isSuccessful) {
+                    throw IptvDvrException("DVR のアクセストークンを取得できませんでした (HTTP ${response.code})。")
+                }
+                val json = parseObject(response.body?.string().orEmpty())
+                val accessToken = json.str("access_token")
+                val root = json.str("root_folder_id")
+                if (accessToken.isNullOrEmpty() || root.isNullOrEmpty()) {
+                    throw IptvDvrException("DVR のトークン応答が不正です。")
+                }
+                val expiresAtMono = tokenExpiryMono(
+                    nowMono = SystemClock.elapsedRealtime(),
+                    nowWallMs = System.currentTimeMillis(),
+                    expiresInSec = json.long("expires_in"),
+                    expiresAtEpochSec = json.long("expires_at"),
+                )
+                Token(dvr, accessToken, expiresAtMono, root)
+            }
+        } catch (e: IptvDvrException) {
+            throw e
+        } catch (e: JsonParseException) {
+            throw IptvDvrException("DVR のトークン応答が不正です。", e)
+        } catch (e: IllegalStateException) {
+            throw IptvDvrException("DVR のトークン応答が不正です。", e)
+        } catch (e: IOException) {
+            throw IptvDvrException("DVR のアクセストークンを取得できませんでした。\n[詳細]: ${e.message}", e)
+        }
+    }
+
+    private suspend fun <T> driveCall(request: Request, block: (Response) -> T): T {
+        var current = validToken()
+        repeat(2) { attempt ->
+            val result: Result<T>? = withContext(Dispatchers.IO) {
+                val authed = request.newBuilder().header("Authorization", "Bearer ${current.accessToken}").build()
+                try {
+                    client.newCall(authed).execute().use { response ->
+                        when {
+                            response.code == 401 && attempt == 0 -> null
+                            response.code == 404 -> throw IptvDvrException("Google Drive のファイルが見つかりません。")
+                            !response.isSuccessful ->
+                                throw IptvDvrException("Google Drive にアクセスできませんでした (HTTP ${response.code})。")
+                            else -> Result.success(block(response))
+                        }
+                    }
+                } catch (e: IptvDvrException) {
+                    throw e
+                } catch (e: JsonParseException) {
+                    throw IptvDvrException("Google Drive の応答が不正です。", e)
+                } catch (e: IllegalStateException) {
+                    throw IptvDvrException("Google Drive の応答が不正です。", e)
+                } catch (e: IOException) {
+                    throw IptvDvrException("Google Drive にアクセスできませんでした。\n[詳細]: ${e.message}", e)
+                }
+            }
+            if (result != null) return result.getOrThrow()
+            current = validToken(forceRefresh = true)
+        }
+        throw IptvDvrException("Google Drive にアクセスできませんでした (HTTP 401)。")
+    }
+
+    private suspend fun listAll(query: String, fields: String, onFile: (JsonObject) -> Unit): Int {
+        var calls = 0
+        var pageToken: String? = null
+        do {
+            val url = DRIVE_FILES.toHttpUrl().newBuilder()
+                .addQueryParameter("q", query)
+                .addQueryParameter("fields", "nextPageToken,files($fields)")
+                .addQueryParameter("pageSize", "1000")
+                .addQueryParameter("orderBy", "modifiedTime desc")
+                .addQueryParameter("supportsAllDrives", "true")
+                .addQueryParameter("includeItemsFromAllDrives", "true")
+                .apply { pageToken?.let { addQueryParameter("pageToken", it) } }
+                .build()
+            pageToken = driveCall(Request.Builder().url(url).get().build()) { response ->
+                val json = parseObject(response.body?.string().orEmpty())
+                json.getAsJsonArray("files")?.forEach { if (it.isJsonObject) onFile(it.asJsonObject) }
+                json.str("nextPageToken")?.takeIf { it.isNotEmpty() }
+            }
+            calls++
+        } while (pageToken != null)
+        return calls
+    }
+
+    /** Recordings listed under another source must not be reused. */
+    suspend fun sourceKey(): String? {
+        val dvr = dvrConfig() ?: return null
+        return dvr.url + "\n" + validToken().rootFolderId
+    }
+
+    /**
+     * One query for the date folders + one global paged query for every non-folder file, filtered
+     * here by parent and `.ts` name: 1 + 6 calls (~7 s) instead of one per folder (~125 s).
+     * mimeType cannot filter: older uploads are typed `text/vnd.trolltech.linguist`, not `video/mp2t`.
+     */
+    suspend fun listRecordings(): List<DriveRecording>? {
+        if (dvrConfig() == null) return null
+        val root = validToken().rootFolderId
+        val folders = HashMap<String, String>()
+        listAll(
+            "'${escape(root)}' in parents and mimeType='$FOLDER_MIME' and trashed=false",
+            "id,name",
+        ) { f -> f.str("id")?.let { folders[it] = f.str("name").orEmpty() } }
+
+        val out = ArrayList<DriveRecording>()
+        listAll(
+            "mimeType!='$FOLDER_MIME' and trashed=false",
+            "id,name,size,createdTime,modifiedTime,parents,videoMediaMetadata(durationMillis)",
+        ) { f ->
+            val id = f.str("id") ?: return@listAll
+            val name = f.str("name") ?: return@listAll
+            if (!name.endsWith(".ts", ignoreCase = true)) return@listAll
+            val parents = f.getAsJsonArray("parents")?.mapNotNull { p -> p.takeIf { it.isJsonPrimitive }?.asString }.orEmpty()
+            val folderName = when {
+                parents.contains(root) -> ""
+                else -> parents.firstNotNullOfOrNull { folders[it] } ?: return@listAll
+            }
+            val modifiedMs = f.str("modifiedTime")?.let { runCatching { Instant.parse(it).toEpochMilli() }.getOrNull() }
+                ?: return@listAll
+            val createdMs = f.str("createdTime")?.let { runCatching { Instant.parse(it).toEpochMilli() }.getOrNull() }
+            val duration = f.getAsJsonObject("videoMediaMetadata")?.str("durationMillis")?.toLongOrNull()
+            out += DriveRecording(
+                fileId = id,
+                name = name,
+                sizeBytes = f.str("size")?.toLongOrNull() ?: 0L,
+                modifiedMs = modifiedMs,
+                createdMs = createdMs ?: modifiedMs,
+                folderName = folderName,
+                driveDurationMs = duration?.takeIf { it > 0 },
+            )
+        }
+        return out
+    }
+
+    /** [DriveRange.totalSize] comes from Content-Range (or Content-Length on a plain 200). */
+    suspend fun readRange(fileId: String, offset: Long, length: Int): DriveRange {
+        val request = Request.Builder()
+            .url(mediaUrl(fileId))
+            .header("Range", "bytes=$offset-${offset + length - 1}")
+            .get()
+            .build()
+        return driveCall(request) { response ->
+            val body = response.body ?: throw IOException("empty body")
+            if (response.code == 206) {
+                val total = response.header("Content-Range")?.substringAfterLast('/')?.toLongOrNull()
+                DriveRange(body.bytes(), total)
+            } else {
+                // Range ignored: read only what was asked for from the start.
+                if (offset != 0L) throw IOException("Range not supported")
+                val total = body.contentLength().takeIf { it > 0 }
+                val bytes = body.byteStream().use { input ->
+                    val buf = ByteArray(length)
+                    var read = 0
+                    while (read < length) {
+                        val n = input.read(buf, read, length - read)
+                        if (n < 0) break
+                        read += n
+                    }
+                    buf.copyOf(read)
+                }
+                DriveRange(bytes, total)
+            }
+        }
+    }
+
+    companion object {
+        const val DRIVE_FILES = "https://www.googleapis.com/drive/v3/files"
+        private const val FOLDER_MIME = "application/vnd.google-apps.folder"
+        private const val EXPIRY_MARGIN_MS = 60_000L
+        private const val DEFAULT_LIFETIME_MS = 3_000_000L
+        private const val CONFIG_TTL_MS = 5 * 60_000L
+
+        /**
+         * Prefers the relative `expires_in`: the absolute `expires_at` depends on the device's wall
+         * clock, often wrong on TV boxes after boot.
+         */
+        internal fun tokenExpiryMono(nowMono: Long, nowWallMs: Long, expiresInSec: Long?, expiresAtEpochSec: Long?): Long =
+            when {
+                expiresInSec != null -> nowMono + expiresInSec * 1000L
+                expiresAtEpochSec != null -> nowMono + (expiresAtEpochSec * 1000L - nowWallMs)
+                else -> nowMono + DEFAULT_LIFETIME_MS
+            }
+
+        fun mediaUrl(fileId: String): String =
+            DRIVE_FILES.toHttpUrl().newBuilder()
+                .addPathSegment(fileId)
+                .addQueryParameter("alt", "media")
+                .addQueryParameter("supportsAllDrives", "true")
+                .build()
+                .toString()
+
+        fun isMediaUrl(url: String): Boolean {
+            val u: HttpUrl = url.toHttpUrlOrNull() ?: return false
+            return u.isHttps && u.host == "www.googleapis.com" &&
+                u.encodedPath.startsWith("/drive/v3/files/") && u.pathSize == 4 &&
+                u.queryParameter("alt") == "media"
+        }
+
+        fun fileIdOf(url: String): String? =
+            url.takeIf { isMediaUrl(it) }?.toHttpUrlOrNull()?.pathSegments?.get(3)
+
+        private val gson = Gson()
+
+        private fun parseObject(json: String): JsonObject =
+            gson.fromJson(json, JsonObject::class.java) ?: throw JsonParseException("empty response")
+
+        private fun escape(value: String): String = value.replace("\\", "\\\\").replace("'", "\\'")
+
+        private fun JsonObject.str(name: String): String? =
+            get(name)?.takeIf { it.isJsonPrimitive }?.asString
+
+        private fun JsonObject.long(name: String): Long? =
+            get(name)?.takeIf { it.isJsonPrimitive }?.let { runCatching { it.asLong }.getOrNull() }
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/IptvDvrMapper.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvDvrMapper.kt
