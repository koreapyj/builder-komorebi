+
+    @Test
+    fun normalisedTitlesWorkWithUpstreamEpisodeDetection() {
+        assertFalse(TitleNormalizer.hasEpisodeNumber("千歳くんはラムネ瓶のなか　＃２０　🈑"))
+        val title = IptvDvrMapper.parseFileName("ＡＴ－Ｘ - 千歳くんはラムネ瓶のなか　＃２０　🈑.ts").title
+        assertTrue(TitleNormalizer.hasEpisodeNumber(title))
