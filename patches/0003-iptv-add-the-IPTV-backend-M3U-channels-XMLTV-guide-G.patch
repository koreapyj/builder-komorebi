+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.kxml2.io.KXmlParser
+import org.xmlpull.v1.XmlPullParser
+import java.io.StringReader
+
+class XmltvParserTest {
+
+    @Test
+    fun utcWithExplicitOffset() {
+        assertEquals(1_795_539_360_000L, XmltvParser.parseDate("20261124165600 +0000"))
+    }
+
+    @Test
+    fun noOffsetMeansUtcAndSecondsAreOptional() {
+        assertEquals(XmltvParser.parseDate("20261124165600 +0000"), XmltvParser.parseDate("20261124165600"))
+        assertEquals(XmltvParser.parseDate("20261124165600"), XmltvParser.parseDate("202611241656"))
+    }
+
+    @Test
+    fun positiveAndNegativeOffsets() {
+        val utc = XmltvParser.parseDate("20261124165600")!!
+        // 01:56 JST on the 25th == 16:56 UTC on the 24th.
+        assertEquals(utc, XmltvParser.parseDate("20261125015600 +0900"))
+        assertEquals(utc, XmltvParser.parseDate("20261124115600 -0500"))
+        assertEquals(utc, XmltvParser.parseDate("20261125015600+0900"))
+    }
+
+    @Test
+    fun epochAndLeapDay() {
+        assertEquals(0L, XmltvParser.parseDate("19700101000000"))
+        assertEquals(1_709_208_000_000L, XmltvParser.parseDate("20240229120000"))
+        assertEquals(951_868_800_000L, XmltvParser.parseDate("20000301000000"))
+    }
+
+    @Test
+    fun rejectsGarbage() {
+        assertNull(XmltvParser.parseDate(null))
+        assertNull(XmltvParser.parseDate(""))
+        assertNull(XmltvParser.parseDate("2026-11-24"))
+        assertNull(XmltvParser.parseDate("20261324000000"))
+        assertNull(XmltvParser.parseDate("20261124165600 +09"))
+    }
+
+    @Test
+    fun streamsWantedProgrammesWithFirstTextElements() {
+        val xml = """
+            <?xml version="1.0" encoding="UTF-8"?>
+            <tv>
+              <channel id="ch-a"><display-name>A</display-name></channel>
+              <programme channel="ch-a" start="20261124163000 +0900" stop="20261124170000 +0900">
+                <title lang="ja">ニュース</title>
+                <title lang="en">News</title>
+                <sub-title>第1回 &amp; その他</sub-title>
+                <desc>説明</desc>
+                <category>ニュース／報道</category>
+              </programme>
+              <programme channel="ch-b" start="20261124163000 +0900" stop="20261124170000 +0900">
+                <title>skip me</title>
+              </programme>
+              <programme channel="ch-a" start="20261124170000 +0900">
+                <title><![CDATA[ドラマ]]></title>
+              </programme>
+            </tv>
+        """.trimIndent()
+        val parser = KXmlParser()
+        parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+        parser.setInput(StringReader(xml))
+
+        val out = ArrayList<IptvProgramme>()
+        XmltvParser.parse(parser, acceptChannel = { it == "ch-a" }) { out += it }
+
+        assertEquals(2, out.size)
+        val first = out[0]
+        assertEquals("ch-a", first.channel)
+        assertEquals(XmltvParser.parseDate("20261124073000"), first.startMs)
+        assertEquals(XmltvParser.parseDate("20261124080000"), first.stopMs)
+        assertEquals("ニュース", first.title)
+        assertEquals("第1回 & その他", first.subTitle)
+        assertEquals("説明", first.desc)
+        assertEquals("ニュース／報道", first.category)
+
+        val second = out[1]
+        assertEquals("ドラマ", second.title)
+        // Missing stop collapses to start; the index later stretches it to the next programme.
+        assertEquals(second.startMs, second.stopMs)
+        assertNull(second.subTitle)
+    }
+}
