+        assertFalse(IptvDvrClient.isMediaUrl("https://example.com/drive/v3/files/1?alt=media"))
+        assertFalse(IptvDvrClient.isMediaUrl("http://192.168.1.2:7000/api/videos/1/download"))
+    }
+}
