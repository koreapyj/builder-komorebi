+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class LogoBackingTest {
+    private val clear = 0x00000000
+    private val white = 0xFFFFFFFF.toInt()
+    private val black = 0xFF000000.toInt()
+    private val red = 0xFFFF1D1B.toInt()
+
+    @Test
+    fun opaqueImageNeedsNoBacking() {
+        assertNull(LogoBacking.choose(IntArray(100) { red }))
+        assertNull(LogoBacking.choose(IntArray(0)))
+        assertNull(LogoBacking.choose(IntArray(100) { clear }))
+    }
+
+    @Test
+    fun lightArtworkOnTransparencyGetsDarkBacking() {
+        val pixels = IntArray(100) { if (it < 30) white else clear }
+        assertEquals(LogoBacking.DARK, LogoBacking.choose(pixels))
+    }
+
+    @Test
+    fun darkArtworkOnTransparencyGetsLightBacking() {
+        val pixels = IntArray(100) { if (it < 30) black else clear }
+        assertEquals(LogoBacking.LIGHT, LogoBacking.choose(pixels))
+    }
+
+    @Test
+    fun aFewTransparentPixelsAreIgnored() {
+        val pixels = IntArray(100) { if (it == 0) clear else white }
+        assertNull(LogoBacking.choose(pixels))
+    }
+}
diff --git a/app/src/test/java/kr/dcmys/komorebi/iptv/M3uParserTest.kt b/app/src/test/java/kr/dcmys/komorebi/iptv/M3uParserTest.kt
