+    @Test
+    fun isoFormatIsFixedWidthWithOffset() {
+        val ms = Instant.parse("2026-11-24T14:59:59.965Z").toEpochMilli()
+        assertEquals("2026-11-24T23:59:59+09:00", IptvDvrMapper.toIso8601(ms, tokyo))
+        assertEquals("2026-11-25T00:00:00+09:00", IptvDvrMapper.toIso8601(ms + 35, tokyo))
+        assertEquals("2026-11-24T14:59:59Z", IptvDvrMapper.toIso8601(ms, ZoneOffset.UTC))
+        val a = IptvDvrMapper.toIso8601(ms, tokyo)
+        val b = IptvDvrMapper.toIso8601(ms + 3_600_000, tokyo)
+        assertEquals(a.length, b.length)
+        assertTrue(a < b)
+    }
+
+    @Test
+    fun sortsByUploadTimeSoLateUploadsAreOnPageOne() {
+        fun rec(id: String, folder: String, mod: Long, created: Long) =
+            DriveRecording(id, "$id.ts", 1, mod, created, folder, null)
+        val sorted = listOf(
+            rec("a", "2026-11-23", 500, 600), rec("b", "2026-11-24", 100, 700), rec("c", "2026-11-24", 200, 800),
+            // An old recording (old folder, old mtime) uploaded last must come first.
+            rec("late", "2026-01-01", 10, 900),
+            rec("tie2", "2026-11-20", 1, 50), rec("tie1", "2026-11-20", 2, 50),
+        ).sortedWith(IptvDvrMapper.NEWEST_FIRST)
+        assertEquals(listOf("late", "c", "b", "a", "tie1", "tie2"), sorted.map { it.fileId })
+        assertEquals(listOf("late"), IptvDvrMapper.page(sorted, 1, 1).map { it.fileId })
+    }
+
+    @Test
+    fun tokenExpiryPrefersRelativeLifetimeOnMonotonicClock() {
+        val mono = 1_000_000L
+        val wall = 1_800_000_000_000L
+        // Wall clock 2 h fast: expires_at would already look expired; expires_in is used.
+        val fastWall = wall + 2 * 3_600_000L
+        assertEquals(mono + 3_599_000L, IptvDvrClient.tokenExpiryMono(mono, fastWall, 3599L, wall / 1000 + 3599))
+        assertEquals(mono + 3_599_000L, IptvDvrClient.tokenExpiryMono(mono, wall, null, wall / 1000 + 3599))
+        assertTrue(IptvDvrClient.tokenExpiryMono(mono, wall, null, null) > mono)
+    }
+
+    @Test
+    fun mapsRecordedProgram() {
+        val end = Instant.parse("2026-11-24T15:00:00Z").toEpochMilli()
+        val rec = DriveRecording(
+            fileId = "1DriveFileId",
+            name = "ＡＴ－Ｘ - 千歳くんはラムネ瓶のなか　＃２０　🈑.ts",
+            sizeBytes = 2_000_000_000L,
+            modifiedMs = end,
+            createdMs = end + 600_000L,
+            folderName = "2026-11-24",
+            driveDurationMs = null,
+        )
+        val p = IptvDvrMapper.toRecordedProgram(rec, 42, 1800.0, "android.resource://x/drawable/y", tokyo)
+        assertEquals(42, p.id)
+        assertEquals(42, p.recordedVideo.id)
+        assertEquals("1DriveFileId", p.airType)
+        assertEquals("2026-11-24T23:30:00+09:00", p.startTime)
+        assertEquals("2026-11-25T00:00:00+09:00", p.endTime)
+        assertEquals(1800.0, p.recordedVideo.duration, 0.0)
+        assertEquals("AT-X", p.channel?.name)
+        assertEquals("CS", p.channel?.type)
+        assertNull(p.channel?.serviceId)
+        assertEquals("android.resource://x/drawable/y", p.apiThumbnailUrl)
+        assertTrue(p.recordedVideo.hasKeyFrames == true)
+        assertFalse(p.isRecording)
+        assertEquals("Recorded", p.recordedVideo.status)
+    }
+
+    @Test
+    fun estimatesDurationFromSize() {
+        assertEquals(1800.0, IptvDvrMapper.estimateDurationSec(2_700_000_000L), 0.0)
+        assertEquals(1.0, IptvDvrMapper.estimateDurationSec(0L), 0.0)
+    }
+
+    @Test
+    fun recognisesDriveMediaUrls() {
+        val url = IptvDvrClient.mediaUrl("1AbC-_x")
+        assertEquals("https://www.googleapis.com/drive/v3/files/1AbC-_x?alt=media&supportsAllDrives=true", url)
+        assertTrue(IptvDvrClient.isMediaUrl(url))
