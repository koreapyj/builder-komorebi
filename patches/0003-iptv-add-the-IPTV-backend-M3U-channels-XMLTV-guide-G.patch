+
+    @Test
+    fun idsAreStablePositiveAndUnique() {
+        val a = IptvDvrMapper.hash31("1AbCdEfGhIjKlMnOpQrStUvWxYz012345")
+        assertEquals(a, IptvDvrMapper.hash31("1AbCdEfGhIjKlMnOpQrStUvWxYz012345"))
+        assertTrue(a >= 0)
+        val files = (0 until 5000).map { "file$it" to it.toLong() }
+        val ids = IptvDvrMapper.assignIds(files)
+        assertEquals(5000, ids.size)
+        assertEquals(5000, ids.values.toSet().size)
+        assertTrue(ids.values.all { it > 0 })
+        assertEquals(ids, IptvDvrMapper.assignIds(files.reversed()))
+    }
+
+    @Test
+    fun collisionKeepsOlderFileIdAndRehashesNewer() {
+        // Every base key collides on 7; "#n" suffixed keys hash normally. "zero" hashes to 0.
+        val hash: (String) -> Int = { k -> if ('#' in k) IptvDvrMapper.hash31(k) else if (k == "zero") 0 else 7 }
+        val files = listOf("newer" to 2L, "older" to 1L, "newest" to 3L, "zero" to 0L)
+        val ids = IptvDvrMapper.assignIds(files, hash)
+        assertEquals(7, ids["older"])
+        assertEquals(IptvDvrMapper.hash31("newer#1"), ids["newer"])
+        assertEquals(IptvDvrMapper.hash31("newest#1"), ids["newest"])
+        assertEquals(IptvDvrMapper.hash31("zero#1"), ids["zero"])
+        assertEquals(4, ids.values.toSet().size)
+        assertEquals(ids, IptvDvrMapper.assignIds(files.shuffled(java.util.Random(1)), hash))
+        val tie = IptvDvrMapper.assignIds(listOf("b" to 5L, "a" to 5L), hash)
+        assertEquals(7, tie["a"])
+        assertNotEquals(7, tie["b"])
+    }
+
+    @Test
+    fun pagingSlices() {
