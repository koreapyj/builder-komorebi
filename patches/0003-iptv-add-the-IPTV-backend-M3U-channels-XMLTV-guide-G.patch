+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.text.SimpleDateFormat
+import java.time.OffsetDateTime
+import java.time.ZoneId
+import java.util.Locale
+import java.util.TimeZone
+
+class IptvMapperTest {
+
+    private val tokyo = ZoneId.of("Asia/Tokyo")
+
+    private fun ch(slug: String, group: String, tvgId: String? = "tvg-$slug", chno: String? = null) =
+        IptvChannel(
+            slug = slug, name = "Name $slug", chno = chno, logo = null, tvgId = tvgId,
+            streamUrl = "https://tv.example.com/$slug.m3u8", group = group,
+        )
+
+    private val t0 = XmltvParser.parseDate("20261124163000 +0900")!!
+
+    private fun prog(tvgId: String, startMin: Long, durMin: Long, title: String = "T$startMin", sub: String? = null) =
+        IptvProgramme(
+            channel = tvgId, startMs = t0 + startMin * 60_000, stopMs = t0 + (startMin + durMin) * 60_000,
+            title = title, subTitle = sub, desc = "desc", category = null,
+        )
+
+    @Test
+    fun isoFormatMatchesEveryReader() {
+        val iso = IptvMapper.toIso8601(t0, tokyo)
+        assertEquals("2026-11-24T16:30:00+09:00", iso)
+        assertEquals(t0, OffsetDateTime.parse(iso).toInstant().toEpochMilli())
+        val sdf = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssXXX", Locale.JAPAN)
+        sdf.timeZone = TimeZone.getTimeZone("UTC")
+        assertEquals(t0, sdf.parse(iso)!!.time)
+        assertEquals(t0, IptvMapper.fromIso8601(iso))
+    }
+
+    @Test
+    fun channelMapping() {
+        val channels = listOf(ch("nhkg1", "地デジ", chno = "1.1"), ch("aniplus", "laftel", tvgId = null))
+        val p = prog("tvg-nhkg1", 0, 30, sub = "第1話")
+        val next = prog("tvg-nhkg1", 30, 60)
+        val res = IptvMapper.toChannelApiResponse(channels, { id ->
+            if (id == "tvg-nhkg1") p to next else null to null
+        }, tokyo)
+
+        val list = res.terrestrial!!
+        assertEquals(2, list.size)
+        val a = list[0]
+        assertEquals("nhkg1", a.id)
+        assertEquals("nhkg1", a.displayChannelId)
+        assertEquals("1.1", a.channelNumber)
+        assertEquals("地デジ", a.type)
+        assertEquals(IptvMapper.NETWORK_ID, a.networkId)
+        assertTrue(a.serviceId > 0)
+        assertTrue(a.isDisplay && a.isWatchable && !a.is_subchannel)
+        assertNull(a.jikkyoForce)
+        val present = a.programPresent!!
+        assertEquals("nhkg1_${t0 / 1000}", present.id)
+        assertEquals("2026-11-24T16:30:00+09:00", present.startTime)
+        assertEquals("2026-11-24T17:00:00+09:00", present.endTime)
+        assertEquals(1800, present.duration)
+        assertEquals("第1話", present.description)
+        assertEquals(mapOf(IptvMapper.DETAIL_CONTENT to "desc"), present.detail)
+        assertEquals("T30", a.programFollowing!!.title)
+
+        val b = list[1]
+        assertEquals("", b.channelNumber)
+        assertNull(b.programPresent)
+        assertNotEquals(a.serviceId, b.serviceId)
+        assertTrue(listOf(res.bs, res.cs, res.sky, res.bs4k).all { it == null })
+    }
+
+    @Test
+    fun serviceIdsAreStablePositiveAndUnique() {
+        val channels = (1..500).map { ch("ch$it", "g") }
+        val ids = IptvMapper.serviceIds(channels)
+        assertEquals(500, ids.values.toSet().size)
+        assertTrue(ids.values.all { it in 1..Int.MAX_VALUE.toLong() })
+        assertEquals(ids["ch7"], IptvMapper.serviceIds(listOf(ch("ch7", "x")))["ch7"])
+        assertTrue(IptvMapper.NETWORK_ID > 0xFFFF)
+    }
+
+    @Test
+    fun epgFiltersByGroupAndIgnoresForeignTypes() {
+        val channels = listOf(ch("a", "地デジ"), ch("b", "laftel"), ch("c", "地デジ"))
+        val programmes = { tvgId: String?, from: Long, to: Long ->
+            IptvEpgIndex.range(listOf(prog(tvgId!!, 0, 30), prog(tvgId, 30, 30)), from, to)
+        }
+        val from = t0
+        val to = t0 + 3_600_000
+
+        val gr = IptvMapper.toEpgWrappers(channels, "地デジ", from, to, programmes, tokyo)
+        assertEquals(listOf("a", "c"), gr.map { it.channel.id })
+        assertTrue(gr.all { it.channel.type == "地デジ" })
+
+        assertTrue(IptvMapper.toEpgWrappers(channels, "GR", from, to, programmes, tokyo).isEmpty())
+        assertEquals(3, IptvMapper.toEpgWrappers(channels, null, from, to, programmes, tokyo).size)
+
+        val w = gr[0]
+        assertEquals("a", w.channel.display_channel_id)
+        assertEquals(IptvMapper.NETWORK_ID.toInt(), w.channel.network_id)
+        val ids = w.programs.map { it.id }
+        assertEquals(ids.size, ids.toSet().size)
+        assertTrue(ids.none { it.startsWith("empty_") })
+        w.programs.forEach {
+            assertEquals("a", it.channel_id)
+            assertEquals(w.channel.service_id, it.service_id)
+            assertTrue(it.is_free)
+            assertNull(it.genres)
+        }
+        // String order == time order (EpgDataConverter sorts by the raw start_time).
+        assertEquals(w.programs.sortedBy { it.start_time }, w.programs)
+    }
+
+    @Test
+    fun titlesNeverUseTheEmptySentinel() {
+        val untitled = IptvMapper.toEpgProgram("a", 1, prog("t", 0, 10, title = ""), tokyo)
+        assertEquals(IptvMapper.UNTITLED, untitled.title)
+        val sentinel = IptvMapper.toEpgProgram("a", 1, prog("t", 0, 10, title = "（番組情報なし）"), tokyo)
+        assertEquals(IptvMapper.UNTITLED, sentinel.title)
+        val emptySlug = IptvMapper.toEpgProgram("empty_x", 1, prog("t", 0, 10), tokyo)
+        assertFalse(emptySlug.id.startsWith("empty_"))
+    }
+
+    @Test
+    fun indexDedupesFillsMissingStopAndAnswersNowNext() {
+        val a = prog("x", 0, 30)
+        val noStop = prog("x", 30, 0, title = "open")
+        val c = prog("x", 60, 30)
+        val dupOfA = prog("x", 0, 45, title = "dup")
+        val index = IptvEpgIndex.build(listOf(mapOf("x" to listOf(c, noStop, a)), mapOf("x" to listOf(dupOfA))))
+        val list = index.getValue("x")
+        assertEquals(listOf("T0", "open", "T60"), list.map { it.title })
+        assertEquals(c.startMs, list[1].stopMs)
+
+        val (now, next) = IptvEpgIndex.nowNext(list, t0 + 10 * 60_000)
+        assertEquals("T0", now!!.title)
+        assertEquals("open", next!!.title)
+        val (gapNow, _) = IptvEpgIndex.nowNext(list, t0 + 200 * 60_000)
+        assertNull(gapNow)
+
+        assertEquals(listOf("open", "T60"), IptvEpgIndex.range(list, t0 + 30 * 60_000, t0 + 120 * 60_000).map { it.title })
+    }
+
+    @Test
+    fun descIsSplitIntoHeadedSections() {
+        val desc = "番組内容\n本文1\n本文2\n\n出演者\n【司会】A，B\n\n補足"
+        assertEquals(
+            linkedMapOf("番組内容" to "本文1\n本文2\n補足", "出演者" to "【司会】A，B"),
+            IptvMapper.detailSections(desc),
+        )
+        assertTrue(IptvMapper.detailSections("").isEmpty())
+    }
+}
