@@ -0,0 +1,77 @@
+package kr.dcmys.komorebi.iptv
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import coil.intercept.Interceptor
+import coil.request.ImageResult
+import coil.size.Size
+import coil.transform.Transformation
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Upstream draws channel logos on fixed backings because its own backends serve opaque logos;
+ * playlist logos may be transparent (e.g. white lettering) and would disappear. Adds an opaque
+ * backing chosen from the logo's brightness to every IPTV channel logo request.
+ */
+@Singleton
+class IptvLogoInterceptor @Inject constructor(
+    private val store: IptvStore,
+) : Interceptor {
+    override suspend fun intercept(chain: Interceptor.Chain): ImageResult {
+        val request = chain.request
+        val url = request.data as? String
+        if (url == null || !store.isLogoUrl(url)) return chain.proceed(request)
+        return chain.proceed(
+            request.newBuilder()
+                .transformations(request.transformations + LogoBackingTransformation)
+                .build()
+        )
+    }
+}
+
+internal object LogoBackingTransformation : Transformation {
+    override val cacheKey: String = "iptv-logo-backing-v1"
+
+    override suspend fun transform(input: Bitmap, size: Size): Bitmap {
+        if (!input.hasAlpha()) return input
+        val width = input.width
+        val height = input.height
+        val pixels = IntArray(width * height)
+        input.getPixels(pixels, 0, width, 0, 0, width, height)
+        val backing = LogoBacking.choose(pixels) ?: return input
+        val output = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        Canvas(output).apply {
+            drawColor(backing)
+            drawBitmap(input, 0f, 0f, null)
+        }
+        return output
+    }
+}
+
+internal object LogoBacking {
+    const val DARK = 0xFF202020.toInt()
+    const val LIGHT = 0xFFFFFFFF.toInt()
+
+    private const val OPAQUE_ALPHA = 128
+    private const val MIN_TRANSPARENT_FRACTION = 0.02
+    private const val LIGHT_LUMA = 150
+
+    /** Null when the image is effectively opaque (or empty). */
+    fun choose(pixels: IntArray): Int? {
+        if (pixels.isEmpty()) return null
+        var opaque = 0
+        var lumaSum = 0L
+        for (p in pixels) {
+            if ((p ushr 24) < OPAQUE_ALPHA) continue
+            opaque++
+            val r = (p shr 16) and 0xFF
+            val g = (p shr 8) and 0xFF
+            val b = p and 0xFF
+            lumaSum += (r * 299 + g * 587 + b * 114) / 1000
+        }
+        val transparent = pixels.size - opaque
+        if (opaque == 0 || transparent < pixels.size * MIN_TRANSPARENT_FRACTION) return null
+        return if (lumaSum / opaque >= LIGHT_LUMA) DARK else LIGHT
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/IptvMapper.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvMapper.kt
new file mode 100644
index 0000000..ec4d656
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvMapper.kt
@@ -0,0 +1,224 @@
+package kr.dcmys.komorebi.iptv
+
+import com.beeregg2001.komorebi.data.model.Channel
+import com.beeregg2001.komorebi.data.model.ChannelApiResponse
+import com.beeregg2001.komorebi.data.model.EpgChannel
+import com.beeregg2001.komorebi.data.model.EpgChannelWrapper
+import com.beeregg2001.komorebi.data.model.EpgProgram
+import com.beeregg2001.komorebi.data.model.Program
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+
+object IptvMapper {
+
+    /**
+     * network_id of every IPTV channel: just above the 16-bit ARIB range, so it never matches
+     * broadcast-specific handling (JikkyoChannelResolver, tsid fallbacks) while (networkId, serviceId)
+     * still identifies a channel for the last-watched list.
+     */
+    const val NETWORK_ID: Long = 0x10000L
+
+    const val DETAIL_CONTENT = "番組内容"
+
+    /** Shown when an XMLTV programme has no title (the EPG grid treats one title as "empty"). */
+    const val UNTITLED = "（タイトルなし）"
+    private const val EPG_EMPTY_SENTINEL = "（番組情報なし）"
+
+    private val ISO: DateTimeFormatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME
+    private val BLANK_LINE = Regex("\n\\s*\n")
+
+    fun toIso8601(epochMs: Long, zone: ZoneId = ZoneId.systemDefault()): String =
+        ISO.format(Instant.ofEpochMilli(epochMs).atZone(zone))
+
+    fun fromIso8601(iso: String?): Long? {
+        if (iso.isNullOrBlank()) return null
+        return try {
+            java.time.OffsetDateTime.parse(iso).toInstant().toEpochMilli()
+        } catch (_: Exception) {
+            try {
+                Instant.parse(iso).toEpochMilli()
+            } catch (_: Exception) {
+                null
+            }
+        }
+    }
+
+    fun serviceIds(channels: List<IptvChannel>): Map<String, Long> {
+        val used = HashSet<Long>()
+        val result = LinkedHashMap<String, Long>(channels.size)
+        for (ch in channels) {
+            if (ch.slug in result) continue
+            var id = hashSlug(ch.slug)
+            while (!used.add(id)) id = if (id >= Int.MAX_VALUE) 1L else id + 1
+            result[ch.slug] = id
+        }
+        return result
+    }
+
+    internal fun hashSlug(slug: String): Long {
+        var h = 0x811c9dc5.toInt()
+        for (b in slug.toByteArray(Charsets.UTF_8)) {
+            h = h xor (b.toInt() and 0xff)
+            h *= 0x01000193
+        }
+        val id = (h.toLong() and 0x7fffffffL)
+        return if (id == 0L) 1L else id
+    }
+
+    fun groups(channels: List<IptvChannel>): List<String> = channels.map { it.group }.distinct()
+
+    fun toChannelApiResponse(
+        channels: List<IptvChannel>,
+        nowNext: (String?) -> Pair<IptvProgramme?, IptvProgramme?>,
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): ChannelApiResponse {
+        val sids = serviceIds(channels)
+        // ChannelViewModel flattens every bucket and regroups by Channel.type, so one bucket is enough.
+        return ChannelApiResponse(
+            terrestrial = channels.map { ch ->
+                val (now, next) = nowNext(ch.tvgId)
+                toChannel(ch, sids.getValue(ch.slug), now, next, zone)
+            }
+        )
+    }
+
+    fun toChannel(
+        ch: IptvChannel,
+        serviceId: Long,
+        present: IptvProgramme?,
+        following: IptvProgramme?,
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): Channel = Channel(
+        id = ch.slug,
+        displayChannelId = ch.slug,
+        name = ch.name,
+        channelNumber = ch.chno ?: "",
+        networkId = NETWORK_ID,
+        serviceId = serviceId,
+        transportStreamId = 0L,
+        type = ch.group,
+        isWatchable = true,
+        is_subchannel = false,
+        isDisplay = true,
+        programPresent = present?.let { toProgram(ch.slug, it, zone) },
+        programFollowing = following?.let { toProgram(ch.slug, it, zone) },
+        remocon_Id = 0,
+        jikkyoForce = null,
+    )
+
+    fun toProgram(slug: String, p: IptvProgramme, zone: ZoneId = ZoneId.systemDefault()): Program =
+        Program(
+            id = programId(slug, p),
+            title = title(p),
+            description = description(p),
+            detail = detail(p),
+            startTime = toIso8601(p.startMs, zone),
+            endTime = toIso8601(p.stopMs, zone),
+            duration = durationSec(p),
+            genres = null,
+            videoResolution = null,
+        )
+
+    /** A type that is not one of our groups (the app also asks for "GR"/"BS"/"CS"/...) yields an empty list. */
+    fun toEpgWrappers(
+        channels: List<IptvChannel>,
+        channelType: String?,
+        fromMs: Long,
+        toMs: Long,
+        programmes: (tvgId: String?, fromMs: Long, toMs: Long) -> List<IptvProgramme>,
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): List<EpgChannelWrapper> {
+        val sids = serviceIds(channels)
+        val selected = if (channelType == null) channels else channels.filter { it.group == channelType }
+        val seen = HashSet<String>()
+        return selected.filter { seen.add(it.slug) }.map { ch ->
+            val sid = sids.getValue(ch.slug)
+            EpgChannelWrapper(
+                channel = toEpgChannel(ch, sid),
+                programs = programmes(ch.tvgId, fromMs, toMs).map { toEpgProgram(ch.slug, sid, it, zone) },
+            )
+        }
+    }
+
+    fun toEpgChannel(ch: IptvChannel, serviceId: Long): EpgChannel = EpgChannel(
+        id = ch.slug,
+        display_channel_id = ch.slug,
+        network_id = NETWORK_ID.toInt(),
+        service_id = serviceId.toInt(),
+        transport_stream_id = 0,
+        remocon_id = 0,
+        channel_number = ch.chno ?: "",
+        type = ch.group,
+        name = ch.name,
+        jikkyo_force = null,
+        is_subchannel = false,
+        is_radiochannel = false,
+        is_watchable = true,
+    )
+
+    fun toEpgProgram(
+        slug: String,
+        serviceId: Long,
+        p: IptvProgramme,
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): EpgProgram = EpgProgram(
+        id = programId(slug, p),
+        channel_id = slug,
+        network_id = NETWORK_ID.toInt(),
+        service_id = serviceId.toInt(),
+        event_id = 0,
+        title = title(p),
+        description = description(p),
+        extended = null,
+        detail = detail(p),
+        start_time = toIso8601(p.startMs, zone),
+        end_time = toIso8601(p.stopMs, zone),
+        duration = durationSec(p),
+        is_free = true,
+        genres = null,
+        video_type = null,
+        audio_type = null,
+        audio_sampling_rate = null,
+    )
+
+    /** `<slug>_<startEpochSec>`; never starts with the EPG grid's "empty_" filler prefix. */
+    fun programId(slug: String, p: IptvProgramme): String {
+        val id = "${slug}_${Math.floorDiv(p.startMs, 1000L)}"
+        return if (id.startsWith("empty_")) "iptv-$id" else id
+    }
+
+    private fun title(p: IptvProgramme): String =
+        p.title.trim().takeIf { it.isNotEmpty() && it != EPG_EMPTY_SENTINEL } ?: UNTITLED
+
+    /**
+     * Feeds that carry a `sub-title` use it for the short summary and keep the long,
+     * sectioned text in `desc`; feeds without one put the summary in `desc`.
+     */
+    private fun description(p: IptvProgramme): String =
+        p.subTitle?.trim()?.takeIf { it.isNotEmpty() } ?: p.desc?.trim().orEmpty()
+
+    private fun detail(p: IptvProgramme): Map<String, String>? {
+        if (p.subTitle.isNullOrBlank()) return null
+        return detailSections(p.desc.orEmpty()).takeIf { it.isNotEmpty() }
+    }
+
+    fun detailSections(desc: String): Map<String, String> {
+        val sections = LinkedHashMap<String, String>()
+        fun put(heading: String, body: String) {
+            sections[heading] = sections[heading]?.let { "$it\n$body" } ?: body
+        }
+        for (block in desc.replace("\r\n", "\n").split(BLANK_LINE)) {
+            val lines = block.trim().lines().map { it.trim() }.filter { it.isNotEmpty() }
+            when {
+                lines.isEmpty() -> Unit
+                lines.size == 1 -> put(DETAIL_CONTENT, lines[0])
+                else -> put(lines[0], lines.drop(1).joinToString("\n"))
+            }
+        }
+        return sections
+    }
+
+    private fun durationSec(p: IptvProgramme): Int =
+        ((p.stopMs - p.startMs) / 1000L).coerceIn(0L, Int.MAX_VALUE.toLong()).toInt()
+}
