--- /dev/null
+++ b/app/src/test/java/kr/dcmys/komorebi/iptv/TsTimestampScannerTest.kt
@@ -0,0 +1,131 @@
+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayOutputStream
+
+class TsTimestampScannerTest {
+
+    private fun pcrPacket(pid: Int, pcrBase: Long): ByteArray {
+        val p = ByteArray(188) { 0xFF.toByte() }
+        p[0] = 0x47
+        p[1] = ((pid shr 8) and 0x1F).toByte()
+        p[2] = (pid and 0xFF).toByte()
+        p[3] = 0x20
+        p[4] = 183.toByte()
+        p[5] = 0x10
+        p[6] = (pcrBase shr 25).toByte()
+        p[7] = (pcrBase shr 17).toByte()
+        p[8] = (pcrBase shr 9).toByte()
+        p[9] = (pcrBase shr 1).toByte()
+        p[10] = (((pcrBase and 1L) shl 7) or 0x7E).toByte()
+        p[11] = 0
+        return p
+    }
+
+    private fun ptsPacket(pid: Int, pts: Long): ByteArray {
+        val p = ByteArray(188) { 0xFF.toByte() }
+        p[0] = 0x47
+        p[1] = (0x40 or ((pid shr 8) and 0x1F)).toByte()
+        p[2] = (pid and 0xFF).toByte()
+        p[3] = 0x10
+        p[4] = 0; p[5] = 0; p[6] = 1; p[7] = 0xE0.toByte()
+        p[8] = 0; p[9] = 0
+        p[10] = 0x80.toByte(); p[11] = 0x80.toByte(); p[12] = 5
+        p[13] = (0x21 or (((pts shr 30) and 0x07).toInt() shl 1)).toByte()
+        p[14] = (pts shr 22).toByte()
+        p[15] = ((((pts shr 15) and 0x7F).toInt() shl 1) or 1).toByte()
+        p[16] = (pts shr 7).toByte()
+        p[17] = (((pts and 0x7F).toInt() shl 1) or 1).toByte()
+        return p
+    }
+
+    private fun nullPacket(): ByteArray {
+        val p = ByteArray(188) { 0xFF.toByte() }
+        p[0] = 0x47; p[1] = 0x1F; p[2] = 0xFF.toByte(); p[3] = 0x10
+        return p
+    }
+
+    private fun chunk(vararg packets: ByteArray, junkPrefix: Int = 0): ByteArray {
+        val out = ByteArrayOutputStream()
+        repeat(junkPrefix) { out.write(0x00) }
+        packets.forEach { out.write(it) }
+        return out.toByteArray()
+    }
+
+    @Test
+    fun parsesPcrAndPtsWithUnalignedStart() {
+        val data = chunk(
+            nullPacket(), pcrPacket(0x1FF, 123_456_789L), ptsPacket(0x111, 8_000_000_000L),
+            nullPacket(), pcrPacket(0x1FF, 123_466_789L), ptsPacket(0x111, 8_000_090_000L),
+            junkPrefix = 77,
+        )
+        val ts = TsTimestampScanner.scan(data)
+        assertEquals(TsTimestampScanner.PidClock(123_456_789L, 123_466_789L, 2), ts.pcr[0x1FF])
+        assertEquals(TsTimestampScanner.PidClock(8_000_000_000L, 8_000_090_000L, 2), ts.pts[0x111])
+    }
+
+    @Test
+    fun durationFromPcr() {
+        val head = TsTimestampScanner.scan(chunk(pcrPacket(0x100, 1_000_000L), nullPacket(), nullPacket()))
+        val tail = TsTimestampScanner.scan(chunk(nullPacket(), nullPacket(), pcrPacket(0x100, 1_000_000L + 30L * 60 * 90_000)))
+        assertEquals(30L * 60 * 1000, TsTimestampScanner.estimateDurationMs(head, tail))
+    }
+
+    @Test
+    fun durationAcrossWraparound() {
+        val wrap = TsTimestampScanner.CLOCK_WRAP
+        val start = wrap - 10L * 90_000
+        val end = 50L * 90_000
+        val head = TsTimestampScanner.scan(chunk(pcrPacket(0x1F0, start), nullPacket(), nullPacket()))
+        val tail = TsTimestampScanner.scan(chunk(nullPacket(), nullPacket(), pcrPacket(0x1F0, end)))
+        assertEquals(60_000L, TsTimestampScanner.estimateDurationMs(head, tail))
+    }
+
+    @Test
+    fun fallsBackToPtsWhenNoCommonPcrPid() {
+        val head = TsTimestampScanner.scan(chunk(pcrPacket(0x100, 0L), ptsPacket(0x111, 900_000L), nullPacket()))
+        val tail = TsTimestampScanner.scan(chunk(pcrPacket(0x200, 5L), ptsPacket(0x111, 900_000L + 90_000L * 120), nullPacket()))
+        assertEquals(120_000L, TsTimestampScanner.estimateDurationMs(head, tail))
+    }
+
+    @Test
+    fun prefersMostFrequentPcrPid() {
+        val head = TsTimestampScanner.scan(
+            chunk(pcrPacket(0x100, 0L), pcrPacket(0x200, 500_000L), pcrPacket(0x200, 500_100L), nullPacket())
+        )
+        val tail = TsTimestampScanner.scan(
+            chunk(pcrPacket(0x100, 90_000L * 7), pcrPacket(0x200, 500_000L + 90_000L * 60), nullPacket())
+        )
+        assertEquals(60_000L, TsTimestampScanner.estimateDurationMs(head, tail))
+    }
+
+    @Test
+    fun prefersGivenPcrPid() {
+        val head = TsTimestampScanner.scan(
+            chunk(pcrPacket(0x100, 0L), pcrPacket(0x200, 500_000L), pcrPacket(0x200, 500_100L), nullPacket())
+        )
+        val tail = TsTimestampScanner.scan(
+            chunk(pcrPacket(0x100, 90_000L * 7), pcrPacket(0x200, 500_000L + 90_000L * 60), nullPacket())
+        )
+        assertEquals(7_000L, TsTimestampScanner.estimateDurationMs(head, tail, pcrPid = 0x100))
+        // A PCR PID absent from the tail falls back to the most frequent common one.
+        assertEquals(60_000L, TsTimestampScanner.estimateDurationMs(head, tail, pcrPid = 0x300))
+    }
+
+    @Test
+    fun noSyncOrTimestampsYieldsNull() {
+        assertTrue(TsTimestampScanner.findSync(ByteArray(1000)) < 0)
+        val empty = TsTimestampScanner.scan(ByteArray(1000))
+        assertTrue(empty.pcr.isEmpty() && empty.pts.isEmpty())
+        assertNull(TsTimestampScanner.estimateDurationMs(empty, empty))
+    }
+
+    @Test
+    fun clockDiffWraps() {
+        assertEquals(5L, TsTimestampScanner.clockDiff(TsTimestampScanner.CLOCK_WRAP - 2, 3))
+        assertEquals(7L, TsTimestampScanner.clockDiff(3, 10))
+    }
+}
