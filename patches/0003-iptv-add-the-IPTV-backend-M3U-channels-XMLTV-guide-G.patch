index 0000000..31300ee
--- /dev/null
+++ b/app/src/test/java/kr/dcmys/komorebi/iptv/TsServiceDetectorTest.kt
@@ -0,0 +1,165 @@
+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.io.ByteArrayOutputStream
+
+class TsServiceDetectorTest {
+
+    private fun withCrc(body: ByteArray): ByteArray {
+        val withZero = body + ByteArray(4)
+        // CRC over body only; append big-endian.
+        var crc = -1
+        for (b in body) {
+            crc = crc xor ((b.toInt() and 0xFF) shl 24)
+            repeat(8) { crc = if (crc < 0) (crc shl 1) xor 0x04C11DB7 else crc shl 1 }
+        }
+        withZero[body.size] = (crc ushr 24).toByte()
+        withZero[body.size + 1] = (crc ushr 16).toByte()
+        withZero[body.size + 2] = (crc ushr 8).toByte()
+        withZero[body.size + 3] = crc.toByte()
+        return withZero
+    }
+
+    private fun section(tableId: Int, idExt: Int, payload: ByteArray): ByteArray {
+        val len = 5 + payload.size + 4
+        val head = byteArrayOf(
+            tableId.toByte(), (0xB0 or (len shr 8)).toByte(), len.toByte(),
+            (idExt shr 8).toByte(), idExt.toByte(), 0xC1.toByte(), 0, 0,
+        )
+        return withCrc(head + payload)
+    }
+
+    private fun pat(vararg programs: Pair<Int, Int>): ByteArray {
+        val out = ByteArrayOutputStream()
+        for ((pn, pid) in listOf(0 to 0x10) + programs) {
+            out.write(pn shr 8); out.write(pn); out.write(0xE0 or (pid shr 8)); out.write(pid)
+        }
+        return section(0x00, 1, out.toByteArray())
+    }
+
+    private fun pmt(pn: Int, pcrPid: Int, vararg streams: Pair<Int, Int>): ByteArray {
+        val out = ByteArrayOutputStream()
+        out.write(0xE0 or (pcrPid shr 8)); out.write(pcrPid); out.write(0xF0); out.write(0)
+        for ((type, pid) in streams) {
+            out.write(type); out.write(0xE0 or (pid shr 8)); out.write(pid); out.write(0xF0); out.write(0)
+        }
+        return section(0x02, pn, out.toByteArray())
+    }
+
+    private fun psiPacket(pid: Int, section: ByteArray): ByteArray {
+        val p = ByteArray(188) { 0xFF.toByte() }
+        p[0] = 0x47; p[1] = (0x40 or (pid shr 8)).toByte(); p[2] = pid.toByte(); p[3] = 0x10
+        p[4] = 0
+        section.copyInto(p, 5)
+        return p
+    }
+
+    private fun esPacket(pid: Int): ByteArray {
+        val p = ByteArray(188)
+        p[0] = 0x47; p[1] = (pid shr 8).toByte(); p[2] = pid.toByte(); p[3] = 0x10
+        return p
+    }
+
+    private fun ts(vararg packets: ByteArray, junk: Int = 0): ByteArray {
+        val out = ByteArrayOutputStream()
+        repeat(junk) { out.write(0x5A) }
+        packets.forEach { out.write(it) }
+        return out.toByteArray()
+    }
+
+    private fun repeat(n: Int, p: ByteArray) = Array(n) { p }
+
+    @Test
+    fun singleService() {
+        val data = ts(
+            psiPacket(0, pat(1040 to 0x1F0)),
+            psiPacket(0x1F0, pmt(1040, 0x100, 0x02 to 0x100, 0x0F to 0x110)),
+            *repeat(10, esPacket(0x100)), esPacket(0x110),
+            junk = 77,
+        )
+        assertEquals(TsServiceDetector.Service(1040, 0x100), TsServiceDetector.detect(data))
+    }
+
+    @Test
+    fun atxShapeOnlyFifthProgramPresent() {
+        val data = ts(
+            psiPacket(0, pat(290 to 0x40E, 311 to 0x401, 316 to 0x402, 321 to 0x404, 333 to 0x40F, 353 to 0x405)),
+            *repeat(3, esPacket(0x1FFF)),
+            psiPacket(0x40F, pmt(333, 0x100F, 0x02 to 0x100F, 0x0F to 0x104F, 0x06 to 0x120F)),
+            *repeat(20, esPacket(0x100F)), *repeat(5, esPacket(0x104F)),
+        )
+        assertEquals(TsServiceDetector.Service(333, 0x100F), TsServiceDetector.detect(data))
+    }
+
+    @Test
+    fun picksProgramWithMostVideoPackets() {
+        val data = ts(
+            psiPacket(0, pat(1040 to 0x1F0, 1041 to 0x1F1)),
+            psiPacket(0x1F0, pmt(1040, 0x100, 0x1B to 0x100)),
+            psiPacket(0x1F1, pmt(1041, 0x200, 0x02 to 0x200)),
+            *repeat(3, esPacket(0x100)), *repeat(9, esPacket(0x200)),
+        )
+        assertEquals(1041, TsServiceDetector.detect(data)?.programNumber)
+    }
+
+    @Test
+    fun audioOnlyProgramWhenNoVideo() {
+        val data = ts(
+            psiPacket(0, pat(1 to 0x1F0, 2 to 0x1F1)),
+            psiPacket(0x1F0, pmt(1, 0x1FFF, 0x0F to 0x110)),
+            psiPacket(0x1F1, pmt(2, 0x1FFF, 0x0F to 0x111)),
+            *repeat(2, esPacket(0x110)), *repeat(4, esPacket(0x111)),
+        )
+        assertEquals(TsServiceDetector.Service(2, null), TsServiceDetector.detect(data))
+    }
+
+    @Test
+    fun patOnlyGivesNull() {
+        val data = ts(psiPacket(0, pat(290 to 0x40E, 333 to 0x40F)), *repeat(10, esPacket(0x1FFF)))
+        assertNull(TsServiceDetector.detect(data))
+    }
+
+    @Test
+    fun corruptSectionIsIgnored() {
+        val bad = pmt(333, 0x100F, 0x02 to 0x100F).also { it[14] = 0x55 }
+        val data = ts(psiPacket(0, pat(333 to 0x40F)), psiPacket(0x40F, bad), *repeat(10, esPacket(0x100F)))
+        assertNull(TsServiceDetector.detect(data))
+    }
+
+    @Test
+    fun sectionSpanningTwoPackets() {
+        val streams = Array(40) { 0x06 to (0x300 + it) } + arrayOf(0x02 to 0x100)
+        val sec = pmt(7, 0x100, *streams) // > 183 bytes
+        val first = ByteArray(188) { 0xFF.toByte() }.also {
+            it[0] = 0x47; it[1] = 0x41; it[2] = 0xF0.toByte(); it[3] = 0x10; it[4] = 0
+            sec.copyInto(it, 5, 0, 183)
+        }
+        val second = ByteArray(188) { 0xFF.toByte() }.also {
+            it[0] = 0x47; it[1] = 0x01; it[2] = 0xF0.toByte(); it[3] = 0x11
+            sec.copyInto(it, 4, 183, sec.size)
+        }
+        val data = ts(psiPacket(0, pat(7 to 0x1F0)), first, second, *repeat(4, esPacket(0x100)))
+        assertEquals(7, TsServiceDetector.detect(data)?.programNumber)
+    }
+
+    @Test
+    fun garbageAndShortInput() {
+        assertNull(TsServiceDetector.detect(ByteArray(0)))
+        assertNull(TsServiceDetector.detect(ByteArray(500) { 0x47 }))
+        assertNull(TsServiceDetector.detect(ByteArray(100_000) { (it * 31).toByte() }))
+        assertNull(TsServiceDetector.detect(ts(psiPacket(0, pat(1 to 0x1F0))).copyOf(100)))
+    }
+
+    @Test
+    fun m2tsPackets() {
+        val packets = listOf(
+            psiPacket(0, pat(5 to 0x1F0)),
+            psiPacket(0x1F0, pmt(5, 0x100, 0x1B to 0x100)),
+        ) + List(6) { esPacket(0x100) }
+        val out = ByteArrayOutputStream()
+        packets.forEach { out.write(ByteArray(4)); out.write(it) }
+        assertEquals(5, TsServiceDetector.detect(out.toByteArray())?.programNumber)
+    }
+}
diff --git a/app/src/test/java/kr/dcmys/komorebi/iptv/TsTimestampScannerTest.kt b/app/src/test/java/kr/dcmys/komorebi/iptv/TsTimestampScannerTest.kt
new file mode 100644
