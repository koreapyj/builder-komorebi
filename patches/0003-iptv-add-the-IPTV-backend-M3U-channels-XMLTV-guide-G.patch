--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvUrls.kt
@@ -0,0 +1,32 @@
+package kr.dcmys.komorebi.iptv
+
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+
+internal object IptvUrls {
+    /** Malformed input is returned trimmed but otherwise untouched. */
+    fun resolve(value: String, base: String): String {
+        val v = value.trim()
+        if (v.isEmpty()) return v
+        val baseUrl = base.trim().toHttpUrlOrNull() ?: return v
+        return baseUrl.resolve(v)?.toString() ?: v
+    }
+
+    fun fileStem(url: String): String {
+        val path = url.split('?', '#').first()
+        var base = path.substring(path.lastIndexOf('/') + 1)
+        base = try {
+            java.net.URLDecoder.decode(base.replace("+", "%2B"), "UTF-8")
+        } catch (_: Exception) {
+            base
+        }
+        val dot = base.lastIndexOf('.')
+        val stem = if (dot > 0) base.substring(0, dot) else base
+        return stem.ifEmpty { url }
+    }
+
+    /** For logs: queries may carry tokens. */
+    fun forLog(url: String): String {
+        val u = url.toHttpUrlOrNull() ?: return url.substringBefore('?').substringBefore('#')
+        return "${u.scheme}://${u.host}${if (u.port != okhttp3.HttpUrl.defaultPort(u.scheme)) ":${u.port}" else ""}${u.encodedPath}"
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/M3uParser.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/M3uParser.kt
new file mode 100644
index 0000000..480617b
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/M3uParser.kt
@@ -0,0 +1,227 @@
+package kr.dcmys.komorebi.iptv
+
+object M3uParser {
+
+    data class Entry(
+        val name: String,
+        val xUrl: String,
+        val tvgId: String?,
+        val chno: String?,
+        val logo: String?,
+        val streamUrl: String,
+    )
+
+    data class Playlist(
+        val epgUrl: String?,
+        val name: String?,
+        val entries: List<Entry>,
+        /** False for HTML error / login pages etc. */
+        val hasHeader: Boolean = true,
+    )
+
+    data class Merged(
+        val channels: List<IptvChannel>,
+        val epgUrls: List<String>,
+        /** Identity (playlist + in-playlist slug) -> assigned slug; feed back as `previous` next time. */
+        val slugs: Map<String, String>,
+    )
+
+    private val ATTR_RE = Regex("""([A-Za-z0-9_-]+)=(?:"([^"]*)"|'([^']*)'|([^\s,]+))""")
+    private val EXTINF_PREFIX_RE = Regex("""^#EXTINF:\s*-?\d+(\.\d+)?""")
+
+    fun parse(text: String, baseUrl: String): Playlist {
+        var hasHeader = false
+        val entries = ArrayList<Entry>()
+        var epgUrl: String? = null
+        var name: String? = null
+        var pending: Entry? = null
+        val seen = HashSet<String>()
+
+        for (raw in text.lineSequence()) {
+            val line = raw.trim().removePrefix("\uFEFF")
+            if (line.isEmpty()) continue
+
+            if (line.startsWith("#EXTM3U")) {
+                hasHeader = true
+                val attrs = parseAttributes(line.substring("#EXTM3U".length))
+                epgUrl = (attrs["url-tvg"] ?: attrs["x-tvg-url"])?.takeIf { it.isNotBlank() } ?: epgUrl
+                continue
+            }
+
+            if (line.startsWith("#PLAYLIST:")) {
+                name = line.substring("#PLAYLIST:".length).trim().ifEmpty { null } ?: name
+                continue
+            }
+
+            if (line.startsWith("#EXTINF")) {
+                val comma = firstCommaOutsideQuotes(line)
+                val title = if (comma >= 0) line.substring(comma + 1).trim() else ""
+                val head = if (comma >= 0) line.substring(0, comma) else line
+                val attrs = parseAttributes(head.replace(EXTINF_PREFIX_RE, ""))
+                val chno = (attrs["tvg-chno"] ?: attrs["channel-number"]).orEmpty().trim()
+                pending = Entry(
+                    name = title.ifEmpty { attrs["tvg-name"].orEmpty() }.ifEmpty { "Unnamed" },
+                    xUrl = attrs["x-url"].orEmpty().trim(),
+                    tvgId = attrs["tvg-id"]?.trim()?.ifEmpty { null },
+                    chno = chno.ifEmpty { null },
+                    logo = attrs["tvg-logo"]?.ifEmpty { null }?.let { IptvUrls.resolve(it, baseUrl) },
+                    streamUrl = "",
+                )
+                continue
+            }
+
+            if (line.startsWith("#")) continue
+
+            val p = pending ?: continue
+            val slug = uniqueSlug(baseSlug(p), seen)
+            entries += p.copy(xUrl = slug, streamUrl = IptvUrls.resolve(line, baseUrl))
+            pending = null
+        }
+
+        return Playlist(
+            epgUrl = epgUrl?.let { IptvUrls.resolve(it, baseUrl) },
+            name = name,
+            entries = entries,
+            hasHeader = hasHeader,
+        )
+    }
+
+    /**
+     * Rejects a body that is not a usable playlist (no `#EXTM3U`, e.g. a captive-portal page, or no
+     * channels, e.g. a truncated file).
+     * @throws IllegalArgumentException with a readable message.
+     */
+    fun parseStrict(text: String, baseUrl: String): Playlist {
+        val playlist = parse(text, baseUrl)
+        require(playlist.hasHeader) { "M3U プレイリストではありません (#EXTM3U がありません)" }
+        require(playlist.entries.isNotEmpty()) { "プレイリストにチャンネルがありません" }
+        return playlist
+    }
+
+    /**
+     * Identifier of a channel before de-duplication, chosen so it does not depend on the
+     * channel's position: x-url, else tvg-id, else the ASCII slug of the name, else a short
+     * hash of the name (non-ASCII names would all collapse to the same slug).
+     */
+    internal fun baseSlug(e: Entry): String =
+        e.xUrl.ifEmpty { null }
+            ?: e.tvgId?.let { idSlug(it) }
+            ?: slugify(e.name).takeIf { it != FALLBACK_SLUG }
+            ?: "ch-" + shortHash(e.name)
+
+    internal fun idSlug(id: String): String? =
+        id.lowercase().trim()
+            .replace(Regex("[^a-z0-9._-]+"), "-")
+            .trim('-', '.')
+            .takeIf { s -> s.any { it in 'a'..'z' || it in '0'..'9' } }
+
+    internal fun shortHash(text: String): String {
+        var h = 0x811c9dc5.toInt()
+        for (b in text.toByteArray(Charsets.UTF_8)) {
+            h = h xor (b.toInt() and 0xff)
+            h *= 0x01000193
+        }
+        return "%08x".format(h)
+    }
+
+    /**
+     * Slugs are made unique across playlists (`-2`, `-3` suffixes). A channel in [previous] keeps its
+     * slug even when another playlist failed to load this time, so ids stay stable between polls.
+     */
+    fun merge(
+        loaded: List<Pair<IptvPlaylistSource, Playlist>>,
+        previous: Map<String, String> = emptyMap(),
+    ): Merged {
+        val epgUrls = loaded.mapNotNull { it.second.epgUrl }.distinct()
+
+        data class Item(val key: String, val group: String, val entry: Entry)
+        val items = loaded.flatMap { (source, playlist) ->
+            val group = playlist.name ?: IptvUrls.fileStem(source.url)
+            playlist.entries.map { Item(identity(source, it), group, it) }
+        }
+
+        // 1) Channels seen before keep their slug (first claimant wins).
+        val taken = HashSet<String>()
+        val assigned = HashMap<String, String>()
+        for (item in items) {
+            val old = previous[item.key] ?: continue
+            if (old !in taken) {
+                taken += old
+                assigned[item.key] = old
+            }
+        }
+        for (item in items) {
+            if (item.key in assigned) continue
+            assigned[item.key] = uniqueSlug(item.entry.xUrl, taken)
+        }
+
+        val channels = items.map { item ->
+            val e = item.entry
+            IptvChannel(
+                slug = assigned.getValue(item.key),
+                name = e.name,
+                chno = e.chno,
+                logo = e.logo,
+                tvgId = e.tvgId,
+                streamUrl = e.streamUrl,
+                group = item.group,
+            )
+        }
+        return Merged(channels = channels, epgUrls = epgUrls, slugs = assigned)
+    }
+
+    private fun identity(source: IptvPlaylistSource, entry: Entry): String =
+        source.raw + "\u0000" + entry.xUrl
+
+    /** Numeric, segment-wise channel number order (`11.2` < `11.10`); null sorts last. */
+    fun compareChno(a: String?, b: String?): Int {
+        if (a == null) return if (b == null) 0 else 1
+        if (b == null) return -1
+        val pa = a.split('.')
+        val pb = b.split('.')
+        for (i in 0 until maxOf(pa.size, pb.size)) {
+            val x = pa.getOrNull(i)?.trim()?.toDoubleOrNull() ?: 0.0
+            val y = pb.getOrNull(i)?.trim()?.toDoubleOrNull() ?: 0.0
+            if (x != y) return x.compareTo(y)
+        }
+        return 0
+    }
+
+    internal fun parseAttributes(input: String): Map<String, String> {
+        val attrs = HashMap<String, String>()
+        for (m in ATTR_RE.findAll(input)) {
+            val g = m.groups
+            attrs[m.groupValues[1].lowercase()] = g[2]?.value ?: g[3]?.value ?: g[4]?.value ?: ""
+        }
+        return attrs
+    }
+
+    internal fun slugify(name: String): String =
+        name.lowercase().trim()
+            .replace(Regex("[^a-z0-9]+"), "-")
+            .trim('-')
+            .ifEmpty { FALLBACK_SLUG }
+
+    private const val FALLBACK_SLUG = "channel"
+
+    private fun uniqueSlug(base: String, seen: MutableSet<String>): String {
+        var slug = base
+        var n = 2
+        while (slug in seen) slug = "$base-${n++}"
+        seen += slug
+        return slug
+    }
+
+    private fun firstCommaOutsideQuotes(line: String): Int {
+        var quote: Char? = null
+        for (i in line.indices) {
+            val c = line[i]
+            when {
+                quote != null -> if (c == quote) quote = null
+                c == '"' -> quote = c
+                c == ',' -> return i
+            }
+        }
+        return -1
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/TsServiceDetector.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/TsServiceDetector.kt
new file mode 100644
index 0000000..b36be83
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/TsServiceDetector.kt
@@ -0,0 +1,168 @@
+package kr.dcmys.komorebi.iptv
+
+/**
+ * Picks the service actually recorded in a TS: recorders may keep one service of a transponder
+ * but leave the full PAT, so "first program in the PAT" (tsreadex `-n -1`) can select nothing.
+ */
+object TsServiceDetector {
+
+    data class Service(val programNumber: Int, val pcrPid: Int?)
+
+    private class Pmt(val programNumber: Int, val pcrPid: Int, val streams: List<Pair<Int, Int>>)
+
+    private val VIDEO_STREAM_TYPES = setOf(0x01, 0x02, 0x1B, 0x24)
+    private const val MAX_SECTION = 4096
+
+    fun detect(data: ByteArray, length: Int = data.size): Service? {
+        val (start, stride) = findPackets(data, length) ?: return null
+
+        val asm = HashMap<Int, ByteArray>()
+        var pat: Map<Int, Int>? = null // program_number -> PMT PID
+        forEachPacket(data, length, start, stride) { pid, unitStart, payload, end ->
+            if (pid == 0 && pat == null) {
+                sectionsOf(asm, 0, unitStart, data, payload, end) { s -> pat = parsePat(s) }
+            }
+        }
+        val programs = pat?.takeIf { it.isNotEmpty() } ?: return null
+        val pmtPids = programs.values.toSet()
+        asm.clear()
+
+        val pmts = HashMap<Int, Pmt>()
+        val counts = HashMap<Int, Int>()
+        forEachPacket(data, length, start, stride) { pid, unitStart, payload, end ->
+            counts[pid] = (counts[pid] ?: 0) + 1
+            if (pid in pmtPids) {
+                sectionsOf(asm, pid, unitStart, data, payload, end) { s ->
+                    val pmt = parsePmt(s) ?: return@sectionsOf
+                    if (programs[pmt.programNumber] == pid) pmts.putIfAbsent(pmt.programNumber, pmt)
+                }
+            }
+        }
+
+        fun videoPackets(p: Pmt) = p.streams.filter { it.first in VIDEO_STREAM_TYPES }.sumOf { counts[it.second] ?: 0 }
+        fun allPackets(p: Pmt) = p.streams.sumOf { counts[it.second] ?: 0 }
+        val best = pmts.values.filter { videoPackets(it) > 0 }.maxWithOrNull(compareBy({ videoPackets(it) }, { -it.programNumber }))
+            ?: pmts.values.filter { allPackets(it) > 0 }.maxWithOrNull(compareBy({ allPackets(it) }, { -it.programNumber }))
+            ?: return null
+        return Service(best.programNumber, best.pcrPid.takeIf { it != 0x1FFF })
+    }
+
+    /** Sync offset and packet size (188 TS, 192 M2TS, 204 with FEC). */
+    private fun findPackets(data: ByteArray, length: Int): Pair<Int, Int>? {
+        for (stride in intArrayOf(188, 192, 204)) {
+            val runs = 5
+            for (start in 0 until minOf(stride, length - stride * (runs - 1))) {
+                if ((0 until runs).all { data[start + it * stride] == 0x47.toByte() }) return start to stride
+            }
+        }
+        return null
+    }
+
+    private inline fun forEachPacket(
+        d: ByteArray,
+        length: Int,
+        start: Int,
+        stride: Int,
+        block: (pid: Int, unitStart: Boolean, payload: Int, end: Int) -> Unit,
+    ) {
+        var p = start
+        while (p + 188 <= length) {
+            if (d[p] == 0x47.toByte()) {
+                val b1 = d[p + 1].toInt() and 0xFF
+                val afc = (d[p + 3].toInt() shr 4) and 0x03
+                if (b1 and 0x80 == 0 && afc and 0x01 != 0) {
+                    val pid = ((b1 and 0x1F) shl 8) or (d[p + 2].toInt() and 0xFF)
+                    val payload = if (afc and 0x02 != 0) p + 5 + (d[p + 4].toInt() and 0xFF) else p + 4
+                    if (payload < p + 188) block(pid, b1 and 0x40 != 0, payload, p + 188)
+                }
+            }
+            p += stride
+        }
+    }
+
+    /** Reassembles PSI sections on [pid]; delivers each complete section with a valid CRC. */
+    private inline fun sectionsOf(
+        reassembly: HashMap<Int, ByteArray>,
+        pid: Int,
+        unitStart: Boolean,
+        d: ByteArray,
+        payload: Int,
+        end: Int,
+        onSection: (ByteArray) -> Unit,
+    ) {
+        var pos = payload
+        var buf = reassembly[pid]
+        if (unitStart) {
+            val pointer = d[pos].toInt() and 0xFF
+            pos += 1
+            if (buf != null && pos + pointer <= end) buf += d.copyOfRange(pos, pos + pointer)
+            buf?.let { completeSection(it)?.let(onSection) }
+            pos += pointer
+            buf = if (pos < end) d.copyOfRange(pos, end) else null
+        } else {
+            buf = buf?.plus(d.copyOfRange(pos, end))
+        }
+        // Several sections may follow each other in one payload.
+        while (buf != null && buf.size >= 3 && buf[0] != 0xFF.toByte()) {
+            val total = 3 + (((buf[1].toInt() and 0x0F) shl 8) or (buf[2].toInt() and 0xFF))
+            if (total > MAX_SECTION) {
+                buf = null
+                break
+            }
+            if (buf.size < total) break
+            completeSection(buf.copyOfRange(0, total))?.let(onSection)
+            buf = buf.copyOfRange(total, buf.size)
+        }
+        if (buf == null || buf.isEmpty() || buf[0] == 0xFF.toByte() || buf.size > MAX_SECTION) reassembly.remove(pid)
+        else reassembly[pid] = buf
+    }
+
+    private fun completeSection(buf: ByteArray): ByteArray? {
+        if (buf.size < 3) return null
+        val total = 3 + (((buf[1].toInt() and 0x0F) shl 8) or (buf[2].toInt() and 0xFF))
+        if (total < 12 || buf.size < total) return null
+        val s = buf.copyOfRange(0, total)
+        return s.takeIf { crc32(it) == 0 }
+    }
+
+    private fun parsePat(s: ByteArray): Map<Int, Int>? {
+        if (s[0].toInt() != 0x00) return null
+        val out = LinkedHashMap<Int, Int>()
+        var i = 8
+        while (i + 4 <= s.size - 4) {
+            val pn = ((s[i].toInt() and 0xFF) shl 8) or (s[i + 1].toInt() and 0xFF)
+            val pid = ((s[i + 2].toInt() and 0x1F) shl 8) or (s[i + 3].toInt() and 0xFF)
+            if (pn != 0) out[pn] = pid
+            i += 4
+        }
+        return out
+    }
+
+    private fun parsePmt(s: ByteArray): Pmt? {
+        if (s[0].toInt() != 0x02 || s.size < 16) return null
+        val pn = ((s[3].toInt() and 0xFF) shl 8) or (s[4].toInt() and 0xFF)
+        val pcrPid = ((s[8].toInt() and 0x1F) shl 8) or (s[9].toInt() and 0xFF)
+        val infoLen = ((s[10].toInt() and 0x0F) shl 8) or (s[11].toInt() and 0xFF)
+        val streams = ArrayList<Pair<Int, Int>>()
+        var i = 12 + infoLen
+        val end = s.size - 4
+        while (i + 5 <= end) {
+            val type = s[i].toInt() and 0xFF
+            val pid = ((s[i + 1].toInt() and 0x1F) shl 8) or (s[i + 2].toInt() and 0xFF)
+            val esLen = ((s[i + 3].toInt() and 0x0F) shl 8) or (s[i + 4].toInt() and 0xFF)
+            streams += type to pid
+            i += 5 + esLen
+        }
+        return Pmt(pn, pcrPid, streams)
+    }
+
+    /** MPEG-2 CRC32 over a whole section including its CRC: 0 when intact. */
+    internal fun crc32(s: ByteArray): Int {
+        var crc = -1
+        for (b in s) {
+            crc = crc xor ((b.toInt() and 0xFF) shl 24)
+            repeat(8) { crc = if (crc < 0) (crc shl 1) xor 0x04C11DB7 else crc shl 1 }
+        }
+        return crc
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/TsTimestampScanner.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/TsTimestampScanner.kt
new file mode 100644
index 0000000..5623734
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/TsTimestampScanner.kt
@@ -0,0 +1,136 @@
+package kr.dcmys.komorebi.iptv
+
+/** All clock values are 33-bit, 90 kHz (the PCR base; the 27 MHz extension is ignored). */
+object TsTimestampScanner {
+    const val PACKET_SIZE = 188
+    private const val SYNC_BYTE = 0x47
+    const val CLOCK_WRAP = 1L shl 33
+    private const val CLOCK_HZ = 90_000L
+
+    data class PidClock(val first: Long, val last: Long, val count: Int)
+
+    data class ChunkTimestamps(
+        val pcr: Map<Int, PidClock>,
+        val pts: Map<Int, PidClock>,
+    )
+
+    /** The chunk may start in the middle of a packet. */
+    fun findSync(data: ByteArray, length: Int = data.size, minRun: Int = 3): Int {
+        val limit = length - PACKET_SIZE * (minRun - 1)
+        for (start in 0 until minOf(PACKET_SIZE, limit.coerceAtLeast(0))) {
+            var ok = true
+            for (k in 0 until minRun) {
+                if ((data[start + k * PACKET_SIZE].toInt() and 0xFF) != SYNC_BYTE) {
+                    ok = false
+                    break
+                }
+            }
+            if (ok) return start
+        }
+        return -1
+    }
+
+    fun scan(data: ByteArray, length: Int = data.size): ChunkTimestamps {
+        val pcr = LinkedHashMap<Int, PidClock>()
+        val pts = LinkedHashMap<Int, PidClock>()
+        var pos = findSync(data, length)
+        if (pos < 0) return ChunkTimestamps(pcr, pts)
+
+        while (pos + PACKET_SIZE <= length) {
+            if ((data[pos].toInt() and 0xFF) != SYNC_BYTE) {
+                val rel = findSync(data.copyOfRange(pos + 1, length), length - pos - 1)
+                if (rel < 0) break
+                pos += 1 + rel
+                continue
+            }
+            scanPacket(data, pos, pcr, pts)
+            pos += PACKET_SIZE
+        }
+        return ChunkTimestamps(pcr, pts)
+    }
+
+    private fun scanPacket(
+        d: ByteArray,
+        p: Int,
+        pcrOut: MutableMap<Int, PidClock>,
+        ptsOut: MutableMap<Int, PidClock>,
+    ) {
+        val b1 = d[p + 1].toInt() and 0xFF
+        val b2 = d[p + 2].toInt() and 0xFF
+        val b3 = d[p + 3].toInt() and 0xFF
+        if (b1 and 0x80 != 0) return
+        val pid = ((b1 and 0x1F) shl 8) or b2
+        if (pid == 0x1FFF) return
+        val unitStart = b1 and 0x40 != 0
+        val afc = (b3 shr 4) and 0x03
+        var payloadStart = p + 4
+
+        if (afc and 0x02 != 0) {
+            val afLen = d[p + 4].toInt() and 0xFF
+            if (afLen > 183) return
+            if (afLen >= 7) {
+                val flags = d[p + 5].toInt() and 0xFF
+                if (flags and 0x10 != 0) {
+                    val base = ((d[p + 6].toLong() and 0xFF) shl 25) or
+                        ((d[p + 7].toLong() and 0xFF) shl 17) or
+                        ((d[p + 8].toLong() and 0xFF) shl 9) or
+                        ((d[p + 9].toLong() and 0xFF) shl 1) or
+                        ((d[p + 10].toLong() and 0x80) shr 7)
+                    record(pcrOut, pid, base)
+                }
+            }
+            payloadStart = p + 5 + afLen
+        }
+        if (afc and 0x01 == 0 || !unitStart) return
+        val end = p + PACKET_SIZE
+        // PES header: 00 00 01 stream_id len(2) flags(2) hdr_len PTS(5)
+        if (payloadStart + 14 > end) return
+        if (d[payloadStart].toInt() != 0 || d[payloadStart + 1].toInt() != 0 ||
+            d[payloadStart + 2].toInt() != 1
+        ) return
+        val streamId = d[payloadStart + 3].toInt() and 0xFF
+        // Streams without the optional PES header (padding, private_stream_2, ECM, ...).
+        if (streamId == 0xBC || streamId == 0xBE || streamId == 0xBF || streamId == 0xF0 ||
+            streamId == 0xF1 || streamId == 0xF2 || streamId == 0xF8 || streamId == 0xFF
+        ) return
+        val ptsDtsFlags = (d[payloadStart + 7].toInt() and 0xFF) shr 6
+        if (ptsDtsFlags and 0x02 == 0) return
+        val q = payloadStart + 9
+        val ptsValue = (((d[q].toLong() and 0x0E) shr 1) shl 30) or
+            ((d[q + 1].toLong() and 0xFF) shl 22) or
+            (((d[q + 2].toLong() and 0xFE) shr 1) shl 15) or
+            ((d[q + 3].toLong() and 0xFF) shl 7) or
+            ((d[q + 4].toLong() and 0xFE) shr 1)
+        record(ptsOut, pid, ptsValue)
+    }
+
+    private fun record(map: MutableMap<Int, PidClock>, pid: Int, value: Long) {
+        val prev = map[pid]
+        map[pid] = if (prev == null) PidClock(value, value, 1) else prev.copy(last = value, count = prev.count + 1)
+    }
+
+    /** Handles one wraparound. */
+    fun clockDiff(from: Long, to: Long): Long = Math.floorMod(to - from, CLOCK_WRAP)
+
+    /**
+     * Uses [pcrPid] (the recorded service's) when it occurs in both chunks, else the head's most
+     * frequent PCR PID that also occurs in the tail, else PES PTS of a common PID.
+     */
+    fun estimateDurationMs(
+        head: ChunkTimestamps,
+        tail: ChunkTimestamps,
+        maxMs: Long = 24L * 3600_000L,
+        pcrPid: Int? = null,
+    ): Long? {
+        fun pick(h: Map<Int, PidClock>, t: Map<Int, PidClock>, preferred: Int?): Long? {
+            val pid = preferred?.takeIf { it in h && it in t } ?: h.entries
+                .filter { t.containsKey(it.key) }
+                .maxByOrNull { it.value.count }
+                ?.key ?: return null
+            val ticks = clockDiff(h.getValue(pid).first, t.getValue(pid).last)
+            return ticks * 1000L / CLOCK_HZ
+        }
+        val candidates = listOfNotNull(pick(head.pcr, tail.pcr, pcrPid), pick(head.pts, tail.pts, null))
+        return candidates.firstOrNull { it in 1000L..maxMs }
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/XmltvParser.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/XmltvParser.kt
