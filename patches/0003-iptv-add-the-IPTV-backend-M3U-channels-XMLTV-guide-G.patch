+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class IptvConfigParserTest {
+
+    private val configUrl = "https://tv.example.com/sub/config.json"
+
+    @Test
+    fun resolvesPlaylistsAndDvrAndIgnoresOverrides() {
+        val json = """
+            {
+              "playlists": [
+                "https://media.example.com/channels.m3u",
+                "/abema.m3u",
+                "laftel.m3u",
+                "",
+                42
+              ],
+              "overrides": {
+                "/abema.m3u": { "availabilityWindow": 1800 }
+              },
+              "dvr": { "url": "/dvr/token", "key": "secret" }
+            }
+        """.trimIndent()
+
+        val config = IptvConfigParser.parse(json, configUrl)
+
+        assertEquals(3, config.playlists.size)
+        val (a, b, c) = config.playlists
+        assertEquals("https://media.example.com/channels.m3u", a.url)
+        assertEquals("/abema.m3u", b.raw)
+        assertEquals("https://tv.example.com/abema.m3u", b.url)
+        assertEquals("https://tv.example.com/sub/laftel.m3u", c.url)
+
+        assertEquals(IptvDvrConfig("https://tv.example.com/dvr/token", "secret"), config.dvr)
+        assertFalse(config.dvr.toString().contains("secret"))
+    }
+
+    @Test
+    fun dvrIsNullWhenUrlOrKeyBlank() {
+        val noKey = """{"playlists":["a.m3u"],"dvr":{"url":"/dvr/token","key":""}}"""
+        assertNull(IptvConfigParser.parse(noKey, configUrl).dvr)
+        val noUrl = """{"playlists":["a.m3u"],"dvr":{"key":"k"}}"""
+        assertNull(IptvConfigParser.parse(noUrl, configUrl).dvr)
+        val none = """{"playlists":["a.m3u"]}"""
+        assertNull(IptvConfigParser.parse(none, configUrl).dvr)
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun failsWithoutPlaylists() {
+        IptvConfigParser.parse("""{"playlists":[]}""", configUrl)
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun failsOnInvalidJson() {
+        IptvConfigParser.parse("not json", configUrl)
+    }
+}
