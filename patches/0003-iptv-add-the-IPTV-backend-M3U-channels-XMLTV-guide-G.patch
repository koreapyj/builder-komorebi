+        val leading = IptvDvrMapper.parseFileName("テレビ朝日 - 🈡オタクに優しいギャルはいない⁉　＃１２.ts").title
+        assertEquals("[終]オタクに優しいギャルはいない!? #12", leading)
+        assertEquals("オタクに優しいギャルはいない", TitleNormalizer.extractDisplayTitle(leading))
+    }
+
+    @Test
+    fun aribSymbolsBecomeBrackets() {
+        assertEquals("LIAR GAME[字]", IptvDvrMapper.normalizeText("ＬＩＡＲ　ＧＡＭＥ🈑"))
+        assertEquals("[新]タイトル", IptvDvrMapper.normalizeText("🈟タイトル"))
+        assertEquals("番組[再]", IptvDvrMapper.normalizeText("番組🈞"))
