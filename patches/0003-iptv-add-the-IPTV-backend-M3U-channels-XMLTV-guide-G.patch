@@ -0,0 +1,42 @@
+package kr.dcmys.komorebi.iptv
+
+import com.beeregg2001.komorebi.data.model.EpgChannelWrapper
+import com.beeregg2001.komorebi.data.repository.EpgProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class IptvEpgRepository @Inject constructor(
+    private val store: IptvStore,
+) : EpgProvider {
+
+    /** A type that is not one of our groups (e.g. the fixed "GR"/"BS"/"CS") yields an empty list. */
+    override suspend fun getEpgPrograms(
+        startTime: String?,
+        endTime: String?,
+        channelType: String?,
+    ): List<EpgChannelWrapper> {
+        val channels = store.channels.ifEmpty { store.loadChannels() }
+        if (channelType != null && channels.none { it.group == channelType }) return emptyList()
+
+        // Give the first guide open a chance to see the cached / downloaded XMLTV.
+        store.awaitEpg(EPG_WAIT_MS)
+
+        val from = IptvMapper.fromIso8601(startTime) ?: System.currentTimeMillis()
+        val to = IptvMapper.fromIso8601(endTime)?.takeIf { it > from } ?: (from + DEFAULT_RANGE_MS)
+        // A 7-day guide is thousands of programmes; map them off the caller's (Main) thread.
+        return withContext(Dispatchers.Default) {
+            IptvMapper.toEpgWrappers(channels, channelType, from, to, store::programmes)
+        }
+    }
+
+    override suspend fun getPinnedEpgPrograms(pinnedChannelIds: String): List<EpgChannelWrapper> =
+        emptyList()
+
+    private companion object {
+        const val EPG_WAIT_MS = 10_000L
+        const val DEFAULT_RANGE_MS = 24 * 60 * 60 * 1000L
+    }
+}
