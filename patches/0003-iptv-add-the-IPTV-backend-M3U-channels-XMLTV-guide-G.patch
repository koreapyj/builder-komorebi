@@ -0,0 +1,192 @@
+package kr.dcmys.komorebi.iptv
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class M3uParserTest {
+
+    private val terrestrial = """
+        #EXTM3U url-tvg=epg.xml
+        #PLAYLIST:地デジ･ＢＳ･ＣＳ
+        #KODIPROP:mimetype=application/x-mpegURL
+        #EXTINF:-1 tvg-id="ch-b964" tvg-chno="1.1" x-url="nhkg1" tvg-logo="logos/tyo1/imagecache/4",ＮＨＫ総合１・東京
+        https://tv.example.com/hls/nhkg1/playlist.m3u8
+        #EXTINF:-1 tvg-id="ch-7bd0" tvg-chno="2.1" x-url="nhke1" tvg-logo="logos/tyo1/imagecache/42",ＮＨＫＥテレ１東京
+        hls/nhke1/playlist.m3u8
+    """.trimIndent()
+
+    private val laftel = """
+        #EXTM3U url-tvg=/laftel.xml
+        #EXTINF:-1 tvg-id="aniplus" x-url="aniplus" tvg-logo="https://img.example.net/aniplus.png",ANIPLUS
+        https://live.example.net/aniplus/main/live-hls.m3u8
+    """.trimIndent()
+
+    private val abema = "\uFEFF#EXTM3U url-tvg=https://cdn.example.net/abema.xml\r\n" +
+        "#EXTINF:-1 tvg-id=\"abema-anime\" x-url=\"abema-anime\" tvg-logo=\"https://cdn.example.net/static/logo/abema-anime\",ABEMA アニメチャンネル\r\n" +
+        "https://cdn.example.net/channel/abema-anime/1080/playlist.m3u8\r\n"
+
+    private fun src(raw: String, url: String) = IptvPlaylistSource(raw, url)
+
+    @Test
+    fun relativeUrlTvgAndLogoResolveAgainstPlaylist() {
+        val p = M3uParser.parse(terrestrial, "https://media.example.com/lists/channels.m3u")
+        assertEquals("https://media.example.com/lists/epg.xml", p.epgUrl)
+        assertEquals("地デジ･ＢＳ･ＣＳ", p.name)
+        assertEquals(2, p.entries.size)
+        val first = p.entries[0]
+        assertEquals("ＮＨＫ総合１・東京", first.name)
+        assertEquals("nhkg1", first.xUrl)
+        assertEquals("ch-b964", first.tvgId)
+        assertEquals("1.1", first.chno)
+        assertEquals("https://media.example.com/lists/logos/tyo1/imagecache/4", first.logo)
+        assertEquals("https://tv.example.com/hls/nhkg1/playlist.m3u8", first.streamUrl)
+        assertEquals("https://media.example.com/lists/hls/nhke1/playlist.m3u8", p.entries[1].streamUrl)
+    }
+
+    @Test
+    fun rootRelativeUrlTvg() {
+        val p = M3uParser.parse(laftel, "https://media.example.com/laftel.m3u")
+        assertEquals("https://media.example.com/laftel.xml", p.epgUrl)
+        assertNull(p.name)
+        val e = p.entries.single()
+        assertEquals("ANIPLUS", e.name)
+        assertEquals("https://img.example.net/aniplus.png", e.logo)
+        assertNull(e.chno)
+    }
+
+    @Test
+    fun absoluteUrlTvgCrlfAndBom() {
+        val p = M3uParser.parse(abema, "https://cdn.example.net/abema.m3u")
+        assertEquals("https://cdn.example.net/abema.xml", p.epgUrl)
+        val e = p.entries.single()
+        assertEquals("ABEMA アニメチャンネル", e.name)
+        assertEquals("https://cdn.example.net/channel/abema-anime/1080/playlist.m3u8", e.streamUrl)
+    }
+
+    @Test
+    fun slugsAreDerivedAndUnique() {
+        val text = """
+            #EXTM3U
+            #EXTINF:-1,Foo Bar!
+            http://a/1
+            #EXTINF:-1,Foo Bar
+            http://a/2
+            #EXTINF:-1,日本語
+            http://a/3
+            #EXTINF:-1 tvg-name="Named",
+            http://a/4
+        """.trimIndent()
+        val p = M3uParser.parse(text, "http://a/list.m3u")
+        assertEquals(
+            listOf("foo-bar", "foo-bar-2", "ch-" + M3uParser.shortHash("日本語"), "named"),
+            p.entries.map { it.xUrl },
+        )
+        assertEquals("Named", p.entries[3].name)
+        assertNull(p.epgUrl)
+    }
+
+    @Test
+    fun slugsWithoutXUrlDoNotDependOnPosition() {
+        val a = """
+            #EXTM3U
+            #EXTINF:-1 x-url="keep" tvg-id="ignored",ＮＨＫ
+            http://a/0
+            #EXTINF:-1 tvg-id="BS.NHK@JP",ＢＳ１
+            http://a/1
+            #EXTINF:-1,東京ＭＸ
+            http://a/2
+            #EXTINF:-1,テレビ東京
+            http://a/3
+        """.trimIndent()
+        val b = """
+            #EXTM3U
+            #EXTINF:-1,テレビ東京
+            http://a/3
+            #EXTINF:-1,東京ＭＸ
+            http://a/2
+            #EXTINF:-1 tvg-id="BS.NHK@JP",ＢＳ１
+            http://a/1
+            #EXTINF:-1 x-url="keep" tvg-id="ignored",ＮＨＫ
+            http://a/0
+        """.trimIndent()
+        val pa = M3uParser.parse(a, "http://a/list.m3u").entries.associate { it.streamUrl to it.xUrl }
+        val pb = M3uParser.parse(b, "http://a/list.m3u").entries.associate { it.streamUrl to it.xUrl }
+        assertEquals(pa, pb)
+        assertEquals("keep", pa["http://a/0"])
+        assertEquals("bs.nhk-jp", pa["http://a/1"])
+        assertEquals(4, pa.values.toSet().size)
+        assertTrue(pa.values.none { it.startsWith("channel") })
+    }
+
+    @Test
+    fun strictParseRejectsNonPlaylists() {
+        val html = "<!DOCTYPE html><html><body>Login required</body></html>"
+        assertFalse(M3uParser.parse(html, "http://a/list.m3u").hasHeader)
+        assertThrows(IllegalArgumentException::class.java) { M3uParser.parseStrict(html, "http://a/list.m3u") }
+        assertThrows(IllegalArgumentException::class.java) {
+            M3uParser.parseStrict("#EXTM3U url-tvg=epg.xml\n#EXTINF:-1,Cut off", "http://a/list.m3u")
+        }
+        assertEquals(2, M3uParser.parseStrict(terrestrial, "http://a/list.m3u").entries.size)
+    }
+
+    @Test
+    fun mergeKeepsOrderDedupesEpgAndSlugs() {
+        val a = M3uParser.parse(terrestrial, "https://media.example.com/channels.m3u")
+        val b = M3uParser.parse(laftel, "https://media.example.com/%E5%9C%B0%E4%B8%8A.m3u")
+        val dup = M3uParser.parse(terrestrial, "https://media.example.com/channels.m3u")
+        val srcA = src("channels.m3u", "https://media.example.com/channels.m3u")
+        val srcB = src("/地上.m3u", "https://media.example.com/%E5%9C%B0%E4%B8%8A.m3u")
+        val srcC = src("again.m3u", "https://media.example.com/again.m3u")
+
+        val merged = M3uParser.merge(listOf(srcA to a, srcB to b, srcC to dup))
+
+        assertEquals(
+            listOf("nhkg1", "nhke1", "aniplus", "nhkg1-2", "nhke1-2"),
+            merged.channels.map { it.slug },
+        )
+        assertEquals("地デジ･ＢＳ･ＣＳ", merged.channels[0].group)
+        assertEquals("地上", merged.channels[2].group)
+        assertEquals(
+            listOf("https://media.example.com/epg.xml", "https://media.example.com/laftel.xml"),
+            merged.epgUrls,
+        )
+    }
+
+    @Test
+    fun slugsStayStableWhenAPlaylistIsMissingForOnePoll() {
+        val a = M3uParser.parse(terrestrial, "https://media.example.com/channels.m3u")
+        val c = M3uParser.parse(terrestrial, "https://media.example.com/again.m3u")
+        val srcA = src("channels.m3u", "https://media.example.com/channels.m3u")
+        val srcC = src("again.m3u", "https://media.example.com/again.m3u")
+
+        val first = M3uParser.merge(listOf(srcA to a, srcC to c))
+        assertEquals(listOf("nhkg1", "nhke1", "nhkg1-2", "nhke1-2"), first.channels.map { it.slug })
+
+        // Playlist A failed this time: C keeps its "-2" slugs instead of taking over A's ids.
+        val second = M3uParser.merge(listOf(srcC to c), first.slugs)
+        assertEquals(listOf("nhkg1-2", "nhke1-2"), second.channels.map { it.slug })
+
+        val third = M3uParser.merge(listOf(srcA to a, srcC to c), first.slugs + second.slugs)
+        assertEquals(first.channels.map { it.slug }, third.channels.map { it.slug })
+    }
+
+    @Test
+    fun compareChnoIsNumericPerSegment() {
+        assertTrue(M3uParser.compareChno("11.2", "11.10") < 0)
+        assertEquals(0, M3uParser.compareChno("011", "11"))
+        assertTrue(M3uParser.compareChno("1.1", null) < 0)
+        assertTrue(M3uParser.compareChno(null, "1") > 0)
+    }
+
+    @Test
+    fun attributesAcceptQuotedAndBareValues() {
+        val attrs = M3uParser.parseAttributes(""" url-tvg=epg.xml X-TVG-URL='b.xml' tvg-id="a b"""")
+        assertEquals("epg.xml", attrs["url-tvg"])
+        assertEquals("b.xml", attrs["x-tvg-url"])
+        assertEquals("a b", attrs["tvg-id"])
+    }
+}
diff --git a/app/src/test/java/kr/dcmys/komorebi/iptv/TsServiceDetectorTest.kt b/app/src/test/java/kr/dcmys/komorebi/iptv/TsServiceDetectorTest.kt
