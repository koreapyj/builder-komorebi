+package kr.dcmys.komorebi.iptv
+
+import android.content.Context
+import android.os.SystemClock
+import android.util.Log
+import androidx.media3.common.util.UnstableApi
+import com.beeregg2001.komorebi.R
+import com.beeregg2001.komorebi.data.local.dao.RecordedProgramDao
+import com.beeregg2001.komorebi.data.local.entity.RecordedProgramEntity
+import com.beeregg2001.komorebi.data.mapper.RecordDataMapper
+import com.beeregg2001.komorebi.data.model.ArchivedComment
+import com.beeregg2001.komorebi.data.model.RecordedApiResponse
+import com.beeregg2001.komorebi.data.model.RecordedProgram
+import com.beeregg2001.komorebi.data.repository.RecordProvider
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withTimeoutOrNull
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.math.abs
+
+/**
+ * Program id = recordedVideo.id = 31-bit hash of the Drive file id ([IptvDvrMapper.assignIds]);
+ * the file id itself is stored in `airType`, which survives the Room round trip and is read by no screen.
+ *
+ * Duration, best first: PCR probe from this process > Drive's durationMillis > value probed
+ * earlier (found in Room) > size-based estimate. Inspection (head + tail Range reads: the recorded
+ * service and the duration) only happens for a recording the player opened ([getRecordStreamUrl] /
+ * [keepAlive], called only by the player); card-focus [getRecordedProgram] calls never touch the
+ * network for it. Durations are written to Room because the sync engine's REPLACE upserts would
+ * otherwise regress them.
+ */
+@Singleton
+class IptvRecordRepository @Inject constructor(
+    private val dvr: IptvDvrClient,
+    private val recordedProgramDao: RecordedProgramDao,
+    @ApplicationContext private val context: Context,
+) : RecordProvider {
+
+    private enum class DurationSource { PROBED, DRIVE, STORED, ESTIMATE }
+
+    private class Item(
+        val rec: DriveRecording,
+        val id: Int,
+        val durationSec: Double,
+        val source: DurationSource,
+    )
+
+    private class Snapshot(val key: String, val items: List<Item>, val byId: Map<Int, Item>, val builtAtMono: Long)
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val snapshotMutex = Mutex()
+
+    @Volatile
+    private var snapshot: Snapshot? = null
+
+    @Volatile
+    private var stateKey: String? = null
+
+    /** True once the source changed in this process: Room rows may then belong to the old one. */
+    @Volatile
+    private var sourceChanged = false
+
+    private val probed = ConcurrentHashMap<String, Double>()
+    private val inspections = ConcurrentHashMap<String, Deferred<Unit>>()
+
+    /** Drive file id -> program_number to play, or [NO_SERVICE] when the head showed none. */
+    private val services = ConcurrentHashMap<String, Int>()
+    private val pcrPids = ConcurrentHashMap<String, Int>()
+    private val serviceFailed = ConcurrentHashMap<String, Long>()
+
+    /** Drive file id -> monotonic time before which no new probe is tried (failed / timed out). */
+    private val probeFailed = ConcurrentHashMap<String, Long>()
+
+    /** Program id -> monotonic time the player last asked for it. */
+    private val playing = ConcurrentHashMap<Int, Long>()
+
+    /** Placeholder card image: an app resource, so no screen builds a KonomiTV thumbnail URL. */
+    private val thumbnailUrl: String by lazy {
+        val res = context.resources
+        val resId = R.drawable.iptv_record_thumbnail
+        "android.resource://${context.packageName}/${res.getResourceTypeName(resId)}/${res.getResourceEntryName(resId)}"
+    }
+
+    private fun now(): Long = SystemClock.elapsedRealtime()
+
+    /** Switching to another source drops everything learned about the previous one. */
+    private suspend fun sourceKey(): String? {
+        val key = dvr.sourceKey()
+        if (key != stateKey) {
+            synchronized(this) {
+                if (key != stateKey) {
+                    if (stateKey != null) sourceChanged = true
+                    stateKey = key
+                    snapshot = null
+                    probed.clear()
+                    inspections.clear()
+                    probeFailed.clear()
+                    services.clear()
+                    pcrPids.clear()
+                    serviceFailed.clear()
+                    playing.clear()
+                }
+            }
+        }
+        return key
+    }
+
+    private fun Snapshot.isFresh(key: String): Boolean = this.key == key && now() - builtAtMono < SNAPSHOT_TTL_MS
+
+    private suspend fun knownSnapshot(): Snapshot? {
+        val key = sourceKey() ?: return null
+        return snapshot?.takeIf { it.key == key }
+    }
+
+    private suspend fun currentSnapshot(): Snapshot? {
+        val key = sourceKey() ?: return null
+        snapshot?.takeIf { it.isFresh(key) }?.let { return it }
+        return snapshotMutex.withLock {
+            snapshot?.takeIf { it.isFresh(key) } ?: buildSnapshot(key)?.also { if (stateKey == key) snapshot = it }
+        }
+    }
+
+    private suspend fun buildSnapshot(key: String): Snapshot? {
+        val built = now()
+        val files = dvr.listRecordings() ?: return null // `dvr` removed meanwhile
+        val sorted = files.sortedWith(IptvDvrMapper.NEWEST_FIRST)
+        val ids = IptvDvrMapper.assignIds(sorted.map { it.fileId to it.modifiedMs })
+        val rows = ids.values.toList().chunked(900)
+            .flatMap { recordedProgramDao.getByIds(it) }
+            .associateBy { it.id }
+
+        val items = sorted.map { rec ->
+            val id = ids.getValue(rec.fileId)
+            val row = rows[id]?.takeIf { it.airType == rec.fileId }
+            val estimate = IptvDvrMapper.estimateDurationSec(rec.sizeBytes)
+            val probedSec = probed[rec.fileId]
+            when {
+                probedSec != null -> Item(rec, id, probedSec, DurationSource.PROBED)
+                rec.driveDurationMs != null -> Item(rec, id, rec.driveDurationMs / 1000.0, DurationSource.DRIVE)
+                // A stored value different from the estimate can only come from an earlier probe.
+                row != null && row.videoDuration > 0 && abs(row.videoDuration - estimate) > 1.0 ->
+                    Item(rec, id, row.videoDuration, DurationSource.STORED)
+                else -> Item(rec, id, estimate, DurationSource.ESTIMATE)
+            }
+        }
+
+        // Rows stored with a worse duration (e.g. Drive finished processing the file later):
+        // the incremental sync stops at known titles and would never rewrite them.
+        val outdated = items.mapNotNull { item ->
+            if (item.source != DurationSource.PROBED && item.source != DurationSource.DRIVE) return@mapNotNull null
+            val row = rows[item.id]?.takeIf { it.airType == item.rec.fileId } ?: return@mapNotNull null
+            if (abs(row.videoDuration - item.durationSec) <= 1.0) null else row.withDuration(item.rec, item.durationSec)
+        }
+        if (outdated.isNotEmpty()) recordedProgramDao.upsertAll(outdated)
+
+        return Snapshot(key, items, items.associateBy { it.id }, built)
+    }
+
+    private fun RecordedProgramEntity.withDuration(rec: DriveRecording, durationSec: Double): RecordedProgramEntity {
+        val endMs = rec.modifiedMs
+        return copy(
+            videoDuration = durationSec,
+            startTime = IptvDvrMapper.toIso8601(endMs - (durationSec * 1000).toLong()),
+            endTime = IptvDvrMapper.toIso8601(endMs),
+        )
+    }
+
+    private fun Item.toProgram(): RecordedProgram =
+        IptvDvrMapper.toRecordedProgram(rec, id, probed[rec.fileId] ?: durationSec, thumbnailUrl)
+
+    private fun isPlaying(videoId: Int): Boolean =
+        playing[videoId]?.let { now() - it < PLAYING_WINDOW_MS } == true
+
+    private fun Item.needsProbe(): Boolean =
+        source == DurationSource.ESTIMATE && !probed.containsKey(rec.fileId) &&
+            (probeFailed[rec.fileId]?.let { now() < it } != true)
+
+    private fun backOff(fileId: String, permanent: Boolean) {
+        probeFailed[fileId] = if (permanent) Long.MAX_VALUE else now() + PROBE_RETRY_MS
+    }
+
+    private fun needsService(fileId: String): Boolean =
+        !services.containsKey(fileId) && (serviceFailed[fileId]?.let { now() < it } != true)
+
+    /** A timeout counts as a transient duration failure; the inspection itself keeps running. */
+    private suspend fun awaitInspection(fileId: String, item: Item?, timeoutMs: Long) {
+        val done = withTimeoutOrNull(timeoutMs) { inspectAsync(fileId, item).await(); true }
+        if (done == null && item != null && !probed.containsKey(fileId)) backOff(fileId, permanent = false)
+    }
+
+    /**
+     * Single-flight per file, in the repository scope so a cancelled caller does not abort it.
+     * One head read serves both the service detection and the duration probe.
+     */
+    private fun inspectAsync(fileId: String, item: Item?): Deferred<Unit> {
+        val key = stateKey
+        val deferred = inspections.computeIfAbsent(fileId) {
+            scope.async(start = CoroutineStart.LAZY) {
+                try {
+                    inspect(fileId, item, key)
+                } finally {
+                    inspections.remove(fileId)
+                }
+            }
+        }
+        deferred.start()
+        return deferred
+    }
+
+    private suspend fun inspect(fileId: String, item: Item?, key: String?) {
+        val wantService = needsService(fileId)
+        val wantDuration = item?.needsProbe() == true
+        if (!wantService && !wantDuration) return
+        val head = try {
+            dvr.readRange(fileId, 0L, HEAD_BYTES)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Head read failed: ${e.message}")
+            if (stateKey == key) {
+                if (wantService) serviceFailed[fileId] = now() + PROBE_RETRY_MS
+                if (wantDuration) backOff(fileId, permanent = false)
+            }
+            return
+        }
+        if (stateKey != key) return
+        if (wantService) {
+            val service = TsServiceDetector.detect(head.bytes)
+            services[fileId] = service?.programNumber ?: NO_SERVICE
+            service?.pcrPid?.let { pcrPids[fileId] = it }
+        }
+        if (item == null || !wantDuration) return
+        try {
+            val sec = probeDurationSec(item.rec, head)
+            if (stateKey != key) return
+            if (sec == null) {
+                backOff(fileId, permanent = true)
+            } else {
+                probed[fileId] = sec
+                probeFailed.remove(fileId)
+                recordedProgramDao.getById(item.id)
+                    ?.takeIf { it.airType == fileId }
+                    ?.let { recordedProgramDao.upsertAll(listOf(it.withDuration(item.rec, sec))) }
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Duration probe failed: ${e.message}")
+            if (stateKey == key) backOff(fileId, permanent = false)
+        }
+    }
+
+    private suspend fun probeDurationSec(rec: DriveRecording, head: DriveRange): Double? {
+        val size = head.totalSize ?: rec.sizeBytes
+        if (size <= HEAD_BYTES + TAIL_BYTES) return null
+        val tail = dvr.readRange(rec.fileId, size - TAIL_BYTES, TAIL_BYTES)
+        val ms = TsTimestampScanner.estimateDurationMs(
+            TsTimestampScanner.scan(head.bytes),
+            TsTimestampScanner.scan(tail.bytes),
+            pcrPid = pcrPids[rec.fileId],
+        ) ?: return null
+        return ms / 1000.0
+    }
+
+    /** tsreadex `-n` for a Drive media URL: the detected program_number, else -1 (first in the PAT). */
+    fun serviceIdFor(url: String): Int =
+        IptvDvrClient.fileIdOf(url)?.let { services[it] }?.takeIf { it > 0 } ?: -1
+
+    override suspend fun getRecordedPrograms(page: Int): RecordedApiResponse =
+        getRecordedPrograms(page, DEFAULT_PAGE_SIZE)
+
+    override suspend fun getRecordedPrograms(page: Int, limit: Int): RecordedApiResponse {
+        val items = currentSnapshot()?.items.orEmpty()
+        return RecordedApiResponse(
+            total = items.size,
+            recordedPrograms = IptvDvrMapper.page(items, page, limit).map { it.toProgram() },
+        )
+    }
+
+    /**
+     * Called by the player right after it opens and on card focus in several lists. Only for a
+     * recording the player has opened is an estimated duration replaced by a probe (awaited).
+     */
+    override suspend fun getRecordedProgram(videoId: Int): Result<RecordedProgram> = try {
+        val known = knownSnapshot()
+        var item = known?.byId?.get(videoId)
+        var row: RecordedProgramEntity? = null
+        if (item == null) {
+            // After a process restart: Room has the synced row (no network for card focus).
+            // After a configuration change the old snapshot is gone: list the new source instead.
+            if (!sourceChanged) row = recordedProgramDao.getById(videoId)?.takeIf { !it.airType.isNullOrEmpty() }
+            if (row == null || isPlaying(videoId)) item = currentSnapshot()?.byId?.get(videoId)
+        }
+        val found = item
+        if (found != null && found.needsProbe() && !isPlaying(videoId)) {
+            // The player marks the recording (keepAlive at screen start) ~300 ms before its detail
+            // fetch; allow for a late mark so the player never keeps the estimate for the session.
+            withTimeoutOrNull(MARK_WAIT_MS) {
+                while (!isPlaying(videoId) && !inspections.containsKey(found.rec.fileId)) delay(50)
+            }
+        }
+        when {
+            found != null -> {
+                if (found.needsProbe() && (isPlaying(videoId) || inspections.containsKey(found.rec.fileId))) {
+                    awaitInspection(found.rec.fileId, found, PROBE_TIMEOUT_MS)
+                }
+                Result.success(found.toProgram())
+            }
+            row != null -> Result.success(RecordDataMapper.toDomainModel(row))
+            else -> Result.failure(IOException("録画番組が見つかりません。"))
+        }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        Result.failure(e)
+    }
+
+    override suspend fun searchRecordedPrograms(keyword: String, page: Int): RecordedApiResponse =
+        RecordedApiResponse(total = 0, recordedPrograms = emptyList())
+
+    override suspend fun getRecordStreamUrl(
+        videoId: Int,
+        quality: String,
+        sessionId: String,
+        offsetSeconds: Double,
+    ): String {
+        val known = knownSnapshot()
+        playing[videoId] = now()
+        var item = known?.byId?.get(videoId)
+        val fileId = item?.rec?.fileId
+            ?: (if (!sourceChanged) recordedProgramDao.getById(videoId)?.airType?.takeIf { it.isNotEmpty() } else null)
+            ?: currentSnapshot()?.byId?.get(videoId)?.also { item = it }?.rec?.fileId
+            ?: throw IOException("録画番組が見つかりません。")
+        // The player's first open follows: it needs the service id, and the resume byte seek needs
+        // the corrected duration. Bounded; on timeout playback falls back to -1 / the estimate.
+        val wantDuration = item?.needsProbe() == true
+        if (wantDuration || needsService(fileId)) {
+            awaitInspection(fileId, item?.takeIf { wantDuration }, if (wantDuration) STREAM_PROBE_WAIT_MS else SERVICE_WAIT_MS)
+        }
+        return IptvDvrClient.mediaUrl(fileId)
+    }
+
+    override suspend fun getArchivedJikkyo(videoId: Int): Result<List<ArchivedComment>> =
+        Result.success(emptyList())
+
+    /** No session to keep alive; the player calls this every 4 s, which marks the recording as playing. */
+    @androidx.annotation.OptIn(UnstableApi::class)
+    override suspend fun keepAlive(videoId: Int, quality: String, sessionId: String) {
+        playing[videoId] = now()
+    }
+
+    override suspend fun getTiledThumbnailUrl(videoId: Int): String? = null
+
+    private companion object {
+        const val TAG = "IptvRecordRepository"
+        const val DEFAULT_PAGE_SIZE = 100
+        const val SNAPSHOT_TTL_MS = 60_000L
+        const val PLAYING_WINDOW_MS = 10 * 60_000L
+        const val HEAD_BYTES = 2 * 1024 * 1024
+        const val TAIL_BYTES = 1024 * 1024
+        const val NO_SERVICE = -1
+        const val PROBE_TIMEOUT_MS = 20_000L
+        const val STREAM_PROBE_WAIT_MS = 8_000L
+        const val SERVICE_WAIT_MS = 5_000L
+        const val MARK_WAIT_MS = 500L
+        const val PROBE_RETRY_MS = 10 * 60_000L
+    }
+}
