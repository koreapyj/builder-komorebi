+package kr.dcmys.komorebi.iptv
+
+import android.content.Context
+import android.util.Log
+import android.util.Xml
+import com.beeregg2001.komorebi.data.SettingsRepository
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import org.xmlpull.v1.XmlPullParser
+import java.io.BufferedInputStream
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+import java.util.zip.GZIPInputStream
+import java.util.zip.GZIPOutputStream
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+/**
+ * [loadChannels] fetches fresh on every call (no TTL cache; the app polls once a minute, intentionally).
+ * The XMLTV guide is cached gzip-compressed in cacheDir and refreshed by one long-lived loader.
+ * A temporarily smaller channel set (a playlist failing for one poll) neither restarts the
+ * loader nor drops guide data.
+ */
+@Singleton
+class IptvStore @Inject constructor(
+    @IptvHttp private val client: OkHttpClient,
+    private val settingsRepository: SettingsRepository,
+    @ApplicationContext private val context: Context,
+) {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val lock = Any()
+
+    @Volatile
+    var channels: List<IptvChannel> = emptyList()
+        private set
+
+    @Volatile
+    private var bySlug: Map<String, IptvChannel> = emptyMap()
+
+    @Volatile
+    private var logoUrls: Set<String> = emptySet()
+
+    private var slugMemory: Map<String, String> = emptyMap() // guarded by lock
+
+    private val channelFlight = SingleFlight<List<IptvChannel>>(scope)
+
+    /** tvg-id -> programmes sorted by start. Replaced atomically. */
+    @Volatile
+    private var epgIndex: Map<String, List<IptvProgramme>> = emptyMap()
+
+    /** XMLTV URL -> parsed programmes grouped by tvg-id. Guarded by [lock]. */
+    private val epgBySource = LinkedHashMap<String, Map<String, List<IptvProgramme>>>()
+
+    private class EpgInputs(val urls: List<String>, val wanted: Set<String>)
+
+    /** What the latest channel list needs. Guarded by [lock]. */
+    private var epgDesired = EpgInputs(emptyList(), emptySet())
+
+    /** URLs / tvg-ids the running loader already covers. Guarded by [lock]. */
+    private var epgCoveredUrls: Set<String> = emptySet()
+    private var epgCoveredWanted: Set<String> = emptySet()
+    private var epgJob: Job? = null // guarded by lock
+
+    /** Wakes the loader early (new inputs, or the backend was switched away). */
+    private val epgWake = Channel<Unit>(Channel.CONFLATED)
+
+    private val epgAttempted = MutableStateFlow(false)
+
+    suspend fun loadConfig(): IptvConfig {
+        val url = settingsRepository.iptvConfigUrl.first().trim()
+        if (url.isEmpty()) {
+            throw IllegalStateException("IPTV の config.json URL が設定されていません。\n設定画面の「接続設定」で入力してください。")
+        }
+        val (body, finalUrl) = try {
+            fetchText(url)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            throw IOException("config.json を取得できませんでした。\nURL とサーバーの稼働状況を確認してください。\n[詳細]: ${e.message ?: e.javaClass.simpleName}", e)
+        }
+        return try {
+            IptvConfigParser.parse(body, finalUrl)
+        } catch (e: IllegalArgumentException) {
+            throw IllegalStateException("config.json の内容を読み込めませんでした。\n[詳細]: ${e.message}", e)
+        }
+    }
+
+    /**
+     * Callers arriving while a fetch is in flight share it. A failing playlist is skipped; throws
+     * only if config.json fails or every playlist fails.
+     */
+    suspend fun loadChannels(): List<IptvChannel> = channelFlight.run { fetchChannels() }
+
+    private suspend fun fetchChannels(): List<IptvChannel> {
+        val config = loadConfig()
+        val errors = ArrayList<String>()
+        val results = coroutineScope {
+            config.playlists.map { source ->
+                async {
+                    try {
+                        val (body, finalUrl) = fetchText(source.url)
+                        source to M3uParser.parseStrict(body, finalUrl)
+                    } catch (e: CancellationException) {
+                        throw e
+                    } catch (e: Exception) {
+                        val msg = e.message ?: e.javaClass.simpleName
+                        Log.w(TAG, "Skipping playlist ${IptvUrls.forLog(source.url)}: $msg")
+                        synchronized(errors) { errors += msg }
+                        null
+                    }
+                }
+            }.awaitAll()
+        }
+        val loaded = results.filterNotNull()
+        if (loaded.isEmpty()) {
+            throw IOException(
+                "プレイリストを読み込めませんでした。\nサーバーの稼働状況を確認してください。" +
+                    (errors.firstOrNull()?.let { "\n[詳細]: $it" } ?: "")
+            )
+        }
+
+        val merged = synchronized(lock) {
+            M3uParser.merge(loaded, slugMemory).also {
+                slugMemory = slugMemory + it.slugs
+                channels = it.channels
+                bySlug = it.channels.associateBy { ch -> ch.slug }
+                logoUrls = it.channels.mapNotNullTo(HashSet()) { ch -> ch.logo }
+            }
+        }
+        ensureEpgLoader(merged.epgUrls, merged.channels.mapNotNullTo(HashSet()) { it.tvgId })
+        return merged.channels
+    }
+
+    fun channel(slug: String): IptvChannel? = bySlug[slug]
+
+    fun isLogoUrl(url: String): Boolean = url in logoUrls
+
+    fun nowNext(
+        tvgId: String?,
+        atMs: Long = System.currentTimeMillis(),
+    ): Pair<IptvProgramme?, IptvProgramme?> {
+        val list = tvgId?.let { epgIndex[it] } ?: return null to null
+        return IptvEpgIndex.nowNext(list, atMs)
+    }
+
+    fun programmes(tvgId: String?, fromMs: Long, toMs: Long): List<IptvProgramme> {
+        val list = tvgId?.let { epgIndex[it] } ?: return emptyList()
+        return IptvEpgIndex.range(list, fromMs, toMs)
+    }
+
+    suspend fun awaitEpg(timeoutMs: Long) {
+        withTimeoutOrNull(timeoutMs) { epgAttempted.first { it } }
+    }
+
+    private suspend fun Call.await(): Response = suspendCancellableCoroutine { cont ->
+        cont.invokeOnCancellation { cancel() }
+        enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                if (cont.isActive) cont.resumeWithException(e)
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                if (cont.isActive) cont.resume(response) else response.close()
+            }
+        })
+    }
+
+    private fun newRequest(url: String): Request =
+        Request.Builder().url(url).header("Cache-Control", "no-cache").build()
+
+    private suspend fun fetchText(url: String): Pair<String, String> {
+        val response = client.newCall(newRequest(url)).await()
+        return withContext(Dispatchers.IO) {
+            response.use { res ->
+                if (!res.isSuccessful) throw IOException("HTTP ${res.code}")
+                val body = res.body ?: throw IOException("empty body")
+                body.string() to res.request.url.toString()
+            }
+        }
+    }
+
+    /** Downloads [url] into [target] as a gzip file (keeps an already-gzipped body as is). */
+    private suspend fun download(url: String, target: File) {
+        val response = client.newCall(newRequest(url)).await()
+        withContext(Dispatchers.IO) {
+            response.use { res ->
+                if (!res.isSuccessful) throw IOException("HTTP ${res.code}")
+                val source = res.body?.source() ?: throw IOException("empty body")
+                val gzipped = source.request(2) &&
+                    source.buffer[0L] == 0x1f.toByte() && source.buffer[1L] == 0x8b.toByte()
+                target.parentFile?.mkdirs()
+                val tmp = File(target.parentFile, target.name + ".tmp")
+                try {
+                    if (gzipped) {
+                        FileOutputStream(tmp).use { out -> source.inputStream().copyTo(out, 64 * 1024) }
+                    } else {
+                        GZIPOutputStream(FileOutputStream(tmp), 64 * 1024).use { out ->
+                            source.inputStream().copyTo(out, 64 * 1024)
+                        }
+                    }
+                    if (!tmp.renameTo(target)) {
+                        target.delete()
+                        if (!tmp.renameTo(target)) throw IOException("cannot write EPG cache")
+                    }
+                } finally {
+                    tmp.delete()
+                }
+            }
+        }
+    }
+
+    /** Wakes the loader only if something new appeared (a smaller set is already covered). */
+    private fun ensureEpgLoader(urls: List<String>, wanted: Set<String>) {
+        synchronized(lock) {
+            epgDesired = EpgInputs(urls, wanted)
+            if (epgJob?.isActive != true) {
+                epgCoveredUrls = emptySet()
+                epgCoveredWanted = emptySet()
+                epgJob = scope.launch { runEpg(coroutineContext[Job]!!) }
+            } else if (!IptvEpgIndex.covers(epgCoveredUrls, epgCoveredWanted, urls, wanted)) {
+                epgWake.trySend(Unit)
+            }
+        }
+    }
+
+    private suspend fun runEpg(self: Job): Unit = coroutineScope {
+
+        // Stop promptly (also mid-parse) once another backend is selected; loadChannels() restarts us.
+        launch {
+            settingsRepository.backendType.first { it != BACKEND_TYPE }
+            synchronized(lock) {
+                if (epgJob === self) {
+                    epgJob = null
+                    epgBySource.clear()
+                }
+            }
+            publishEpg()
+            self.cancel()
+        }
+
+        val parsedFor = HashMap<String, Set<String>>()
+        /** url -> wall-clock time before which a failed download is not retried. */
+        val retryAt = HashMap<String, Long>()
+
+        while (true) {
+            val desired = synchronized(lock) { epgDesired }
+            var now = System.currentTimeMillis()
+
+            val dropped = synchronized(lock) {
+                val gone = epgBySource.keys.filter { it !in desired.urls && isDue(it, now) }
+                epgBySource.keys.removeAll(gone.toSet())
+                gone
+            }
+            if (dropped.isNotEmpty()) publishEpg()
+            parsedFor.keys.retainAll(synchronized(lock) { epgBySource.keys.toSet() })
+
+            for (url in desired.urls) {
+                val prev = parsedFor[url]
+                if (!IptvEpgIndex.needsParse(prev, desired.wanted)) continue
+                val file = cacheFile(url)
+                if (!file.exists()) continue
+                val ids = IptvEpgIndex.parseSet(prev, desired.wanted)
+                if (parseAndStore(url, file, ids, self)) parsedFor[url] = ids
+            }
+            if (parsedFor.isNotEmpty()) epgAttempted.value = true
+
+            // A fresh download is parsed for the current set only, which also evicts disappeared tvg-ids.
+            for (url in desired.urls) {
+                val file = cacheFile(url)
+                now = System.currentTimeMillis()
+                if (!isDue(url, now) || (retryAt[url] ?: 0L) > now) continue
+                val ok = try {
+                    download(url, file)
+                    true
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    Log.w(TAG, "EPG download failed: ${IptvUrls.forLog(url)}: ${e.message}")
+                    false
+                }
+                if (ok && parseAndStore(url, file, desired.wanted, self)) {
+                    parsedFor[url] = desired.wanted
+                    retryAt.remove(url)
+                } else {
+                    retryAt[url] = System.currentTimeMillis() + EPG_RETRY_MS
+                }
+            }
+
+            synchronized(lock) {
+                epgCoveredUrls = parsedFor.keys + desired.urls
+                epgCoveredWanted = parsedFor.values.flatten().toSet() + desired.wanted
+            }
+            epgAttempted.value = true
+
+            // Sleep until the next source is due, but never longer than EPG_WAKE_CAP_MS: delay()
+            // does not advance during deep sleep, so the cache age is re-checked by wall clock.
+            now = System.currentTimeMillis()
+            val nextDue = desired.urls.minOfOrNull { url ->
+                maxOf(cacheFile(url).lastModified() + EPG_MAX_AGE_MS, retryAt[url] ?: 0L)
+            } ?: Long.MAX_VALUE
+            val sleep = (nextDue - now).coerceIn(EPG_MIN_SLEEP_MS, EPG_WAKE_CAP_MS)
+            withTimeoutOrNull(sleep) { epgWake.receive() }
+        }
+    }
+
+    private fun isDue(url: String, now: Long): Boolean {
+        val file = cacheFile(url)
+        return !file.exists() || now - file.lastModified() >= EPG_MAX_AGE_MS
+    }
+
+    private suspend fun parseAndStore(url: String, file: File, wanted: Set<String>, owner: Job): Boolean {
+        val ctx = currentCoroutineContext()
+        val grouped = HashMap<String, MutableList<IptvProgramme>>()
+        try {
+            GZIPInputStream(BufferedInputStream(FileInputStream(file), 64 * 1024), 64 * 1024).use { input ->
+                val parser = Xml.newPullParser()
+                parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+                parser.setInput(input, null)
+                XmltvParser.parse(
+                    parser,
+                    acceptChannel = { it in wanted },
+                    checkpoint = { ctx.ensureActive() },
+                ) { p ->
+                    grouped.getOrPut(p.channel) { ArrayList() }.add(p)
+                }
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "EPG parse failed: ${IptvUrls.forLog(url)}: ${e.message}")
+            if (grouped.isEmpty()) {
+                file.delete()
+                return false
+            }
+        }
+        ctx.ensureActive()
+        val stored = synchronized(lock) {
+            // A loader that was stopped meanwhile must not put data back.
+            (epgJob === owner).also { if (it) epgBySource[url] = grouped }
+        }
+        if (stored) publishEpg()
+        return stored
+    }
+
+    private fun publishEpg() {
+        val snapshot = synchronized(lock) { epgBySource.values.toList() }
+        epgIndex = IptvEpgIndex.build(snapshot)
+    }
+
+    private fun cacheFile(url: String): File {
+        val digest = MessageDigest.getInstance("SHA-1").digest(url.toByteArray())
+        val name = digest.joinToString("") { "%02x".format(it) }
+        return File(File(context.cacheDir, "iptv-epg"), "$name.xml.gz")
+    }
+
+    companion object {
+        /** Value of upstream's backend_type preference that selects this backend. */
+        internal const val BACKEND_TYPE = "IPTV"
+        private const val TAG = "IptvStore"
+        private const val EPG_MAX_AGE_MS = 6 * 60 * 60 * 1000L
+        private const val EPG_RETRY_MS = 10 * 60 * 1000L
+        private const val EPG_WAKE_CAP_MS = 15 * 60 * 1000L
+        private const val EPG_MIN_SLEEP_MS = 30 * 1000L
+    }
+}
+
+/**
+ * Concurrent callers share one in-flight execution; the next call after it completes starts a
+ * fresh one. The work runs in [scope], so a cancelled caller does not cancel it for the others.
+ */
+internal class SingleFlight<T>(private val scope: CoroutineScope) {
+    private var current: Deferred<T>? = null
+
+    suspend fun run(block: suspend () -> T): T {
+        val deferred = synchronized(this) {
+            current?.takeIf { it.isActive } ?: scope.async { block() }.also { current = it }
+        }
+        return deferred.await()
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/IptvUrls.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvUrls.kt
new file mode 100644
