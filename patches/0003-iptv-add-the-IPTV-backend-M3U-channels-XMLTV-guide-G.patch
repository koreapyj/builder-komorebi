--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/XmltvParser.kt
@@ -0,0 +1,121 @@
+package kr.dcmys.komorebi.iptv
+
+import org.xmlpull.v1.XmlPullParser
+
+/** The pull-parser is injected (android.util.Xml on device, kxml2 in JVM tests): no Android dependency. */
+object XmltvParser {
+
+    const val CHECKPOINT_INTERVAL = 256
+
+    private val DATE_RE =
+        Regex("""^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})?(?:\s*([+-])(\d{2})(\d{2}))?$""")
+
+    /** A missing offset means UTC. */
+    fun parseDate(value: String?): Long? {
+        val m = DATE_RE.matchEntire(value?.trim() ?: return null) ?: return null
+        val g = m.groupValues
+        val year = g[1].toInt()
+        val month = g[2].toInt()
+        val day = g[3].toInt()
+        val hour = g[4].toInt()
+        val minute = g[5].toInt()
+        val second = g[6].ifEmpty { "0" }.toInt()
+        if (month !in 1..12 || day !in 1..31 || hour > 23 || minute > 59 || second > 60) return null
+        var offsetSec = 0L
+        if (g[7].isNotEmpty()) {
+            offsetSec = g[8].toLong() * 3600 + g[9].toLong() * 60
+            if (g[7] == "-") offsetSec = -offsetSec
+        }
+        val epochSec = daysFromCivil(year, month, day) * 86_400L +
+            hour * 3600L + minute * 60L + second - offsetSec
+        return epochSec * 1000L
+    }
+
+    private fun daysFromCivil(year: Int, month: Int, day: Int): Long {
+        val y = (if (month <= 2) year - 1 else year).toLong()
+        val era = Math.floorDiv(y, 400L)
+        val yoe = y - era * 400
+        val mp = (month + 9) % 12
+        val doy = (153 * mp + 2) / 5 + day - 1
+        val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
+        return era * 146_097 + doe - 719_468
+    }
+
+    /**
+     * [checkpoint] is called every [CHECKPOINT_INTERVAL] `<programme>` elements (accepted or not) so
+     * the caller can abort a long parse, e.g. by throwing on coroutine cancellation.
+     */
+    fun parse(
+        parser: XmlPullParser,
+        acceptChannel: (String) -> Boolean = { true },
+        checkpoint: () -> Unit = {},
+        onProgramme: (IptvProgramme) -> Unit,
+    ) {
+        var seen = 0
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (event == XmlPullParser.START_TAG && parser.name == "programme") {
+                if (++seen % CHECKPOINT_INTERVAL == 0) checkpoint()
+                readProgramme(parser, acceptChannel)?.let(onProgramme)
+            }
+            event = parser.next()
+        }
+    }
+
+    private fun readProgramme(
+        parser: XmlPullParser,
+        acceptChannel: (String) -> Boolean,
+    ): IptvProgramme? {
+        val channel = parser.getAttributeValue(null, "channel").orEmpty()
+        val start = parseDate(parser.getAttributeValue(null, "start"))
+        val stop = parseDate(parser.getAttributeValue(null, "stop"))
+        val wanted = channel.isNotEmpty() && start != null && acceptChannel(channel)
+
+        var title: String? = null
+        var subTitle: String? = null
+        var desc: String? = null
+        var category: String? = null
+
+        val depth = parser.depth
+        while (true) {
+            val event = parser.next()
+            if (event == XmlPullParser.END_DOCUMENT) break
+            if (event == XmlPullParser.END_TAG && parser.depth == depth) break
+            if (!wanted || event != XmlPullParser.START_TAG || parser.depth != depth + 1) continue
+            when (parser.name) {
+                "title" -> if (title == null) title = readText(parser)
+                "sub-title" -> if (subTitle == null) subTitle = readText(parser)
+                "desc" -> if (desc == null) desc = readText(parser)
+                "category" -> if (category == null) category = readText(parser)
+            }
+        }
+
+        if (!wanted || start == null) return null
+        return IptvProgramme(
+            channel = channel,
+            startMs = start,
+            stopMs = stop ?: start,
+            title = title.orEmpty(),
+            subTitle = subTitle,
+            desc = desc,
+            category = category,
+        )
+    }
+
+    /** Tolerates nested markup by concatenating text nodes. */
+    private fun readText(parser: XmlPullParser): String? {
+        val depth = parser.depth
+        val sb = StringBuilder()
+        while (true) {
+            val event = parser.next()
+            if (event == XmlPullParser.END_DOCUMENT) break
+            if (event == XmlPullParser.END_TAG && parser.depth == depth) break
+            if (event == XmlPullParser.TEXT || event == XmlPullParser.CDSECT ||
+                event == XmlPullParser.ENTITY_REF
+            ) {
+                parser.text?.let { sb.append(it) }
+            }
+        }
+        return sb.toString().trim().ifEmpty { null }
+    }
+}
