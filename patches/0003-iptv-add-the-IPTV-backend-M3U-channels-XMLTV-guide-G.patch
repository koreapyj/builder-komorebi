+package kr.dcmys.komorebi.iptv
+
+import com.google.gson.Gson
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+
+object IptvConfigParser {
+
+    /**
+     * [configUrl] is the post-redirect URL; every URL in the document resolves against it.
+     * @throws IllegalArgumentException if the document is malformed or lists no playlists.
+     */
+    fun parse(json: String, configUrl: String): IptvConfig {
+        val parsed: JsonObject? = try {
+            Gson().fromJson(json, JsonObject::class.java)
+        } catch (e: Exception) {
+            throw IllegalArgumentException("config.json が正しい JSON ではありません", e)
+        }
+        val root = parsed ?: throw IllegalArgumentException("config.json が空です")
+
+        val rawPlaylists = root.get("playlists")
+            ?.takeIf { it.isJsonArray }
+            ?.asJsonArray
+            ?.mapNotNull { it.stringOrNull() }
+            ?.filter { it.isNotBlank() }
+            .orEmpty()
+        if (rawPlaylists.isEmpty()) {
+            throw IllegalArgumentException("config.json にプレイリストがありません")
+        }
+
+        val playlists = rawPlaylists.map { raw ->
+            IptvPlaylistSource(raw = raw, url = IptvUrls.resolve(raw, configUrl))
+        }
+
+        val dvr = root.get("dvr")?.takeIf { it.isJsonObject }?.asJsonObject?.let { obj ->
+            val url = obj.get("url")?.stringOrNull()?.trim().orEmpty()
+            val key = obj.get("key")?.stringOrNull()?.trim().orEmpty()
+            if (url.isEmpty() || key.isEmpty()) null
+            else IptvDvrConfig(url = IptvUrls.resolve(url, configUrl), key = key)
+        }
+
+        return IptvConfig(playlists = playlists, dvr = dvr)
+    }
+
+    private fun JsonElement.stringOrNull(): String? =
+        if (isJsonPrimitive && asJsonPrimitive.isString) asString else null
+}
