+package kr.dcmys.komorebi.iptv
+
+import android.content.Context
+import android.net.Uri
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import java.io.IOException
+import java.util.concurrent.atomic.AtomicLong
+
+@UnstableApi
+object IptvPlayback {
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface Deps {
+        fun iptvDvrClient(): IptvDvrClient
+        fun iptvRecordRepository(): IptvRecordRepository
+    }
+
+    private fun client(context: Context): IptvDvrClient =
+        EntryPointAccessors.fromApplication(context.applicationContext, Deps::class.java).iptvDvrClient()
+
+    fun isDriveMedia(url: String): Boolean = IptvDvrClient.isMediaUrl(url)
+
+    fun isDriveMedia(uri: Uri): Boolean = isDriveMedia(uri.toString())
+
+    /** tsreadex `-n` for a Drive recording: the service actually present in the file, else -1. */
+    fun serviceId(context: Context, uri: Uri): Int =
+        EntryPointAccessors.fromApplication(context.applicationContext, Deps::class.java)
+            .iptvRecordRepository().serviceIdFor(uri.toString())
+
+    /**
+     * Evaluated per DataSource.open(), so every open (start, byte seek, retry) gets a valid token.
+     * BLOCKING on a token miss: call from ExoPlayer's loader thread only.
+     * @throws IOException when no token can be obtained (the player's retry path handles it).
+     */
+    fun requestHeaders(context: Context): Map<String, String> = client(context).authHeadersBlocking()
+
+    /** On HTTP 401 drops the cached token so the retry fetches a fresh one, and restores the byte-seek reservation the failed open consumed. */
+    fun open(context: Context, source: DataSource, dataSpec: DataSpec, pendingSeekByteRef: AtomicLong): Long {
+        val pendingSeek = pendingSeekByteRef.get()
+        try {
+            return source.open(dataSpec)
+        } catch (e: IOException) {
+            if (e.message == "Server returned code 401") {
+                client(context).invalidateToken()
+                if (pendingSeek >= 0L) pendingSeekByteRef.compareAndSet(-1L, pendingSeek)
+            }
+            throw e
+        }
+    }
+}
