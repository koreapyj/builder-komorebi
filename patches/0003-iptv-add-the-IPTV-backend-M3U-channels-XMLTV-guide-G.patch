+++ b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvDvrMapper.kt
@@ -0,0 +1,205 @@
+package kr.dcmys.komorebi.iptv
+
+import com.beeregg2001.komorebi.data.model.RecordedChannel
+import com.beeregg2001.komorebi.data.model.RecordedProgram
+import com.beeregg2001.komorebi.data.model.RecordedVideo
+import java.security.MessageDigest
+import java.text.Normalizer
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+
+data class DriveRecording(
+    val fileId: String,
+    val name: String,
+    val sizeBytes: Long,
+    /** Drive modifiedTime = end of the recording (the uploader keeps the file's mtime), epoch ms. */
+    val modifiedMs: Long,
+    /** Drive createdTime = upload time (always after [modifiedMs]), epoch ms. */
+    val createdMs: Long,
+    /** Name of the date folder holding the file (`2026-11-24`), "" for files directly under the root. */
+    val folderName: String,
+    /** Drive's videoMediaMetadata.durationMillis; only present for files Drive has processed. */
+    val driveDurationMs: Long?,
+)
+
+object IptvDvrMapper {
+
+    data class ParsedName(val channel: String?, val title: String)
+
+    /** Measured on real recordings: 8.6 (AT-X) .. 15.7 (テレ東) Mbps, ~11.7 on average. */
+    const val ESTIMATE_BITS_PER_SECOND = 12_000_000L
+
+    private val ISO_SECONDS: DateTimeFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ssXXX")
+    private val WHITESPACE = Regex("\\s+")
+
+    /**
+     * Most recently UPLOADED first. The sync engine's incremental pass stops after the first page
+     * holding a known recording, so anything new, including a late upload of an old recording
+     * (old modifiedTime / date folder), must be on page 1.
+     */
+    val NEWEST_FIRST: Comparator<DriveRecording> =
+        compareByDescending<DriveRecording> { it.createdMs }
+            .thenBy { it.fileId }
+
+    fun parseFileName(name: String): ParsedName {
+        val base = if (name.endsWith(".ts", ignoreCase = true)) name.dropLast(3) else name
+        val sep = base.indexOf(" - ")
+        if (sep <= 0) return ParsedName(null, normalizeText(base).ifEmpty { name })
+        val channel = normalizeText(base.substring(0, sep))
+        val title = normalizeText(base.substring(sep + 3))
+        return when {
+            title.isEmpty() -> ParsedName(channel.ifEmpty { null }, channel.ifEmpty { name })
+            channel.isEmpty() -> ParsedName(null, title)
+            else -> ParsedName(channel, title)
+        }
+    }
+
+    /**
+     * NFKC so full-width digits / `＃` become ASCII (upstream's TitleNormalizer.hasEpisodeNumber only
+     * recognises ASCII digits). ARIB gaiji become `[字]`, `[新]`... brackets, which TitleNormalizer strips.
+     */
+    fun normalizeText(text: String): String {
+        val sb = StringBuilder(text.length + 8)
+        var i = 0
+        while (i < text.length) {
+            val cp = text.codePointAt(i)
+            val ch = String(Character.toChars(cp))
+            if (isAribSymbol(cp)) {
+                val nfkc = Normalizer.normalize(ch, Normalizer.Form.NFKC)
+                val inner = nfkc.trim('〔', '〕', '[', ']', '(', ')')
+                if (nfkc != ch && inner.isNotEmpty()) sb.append('[').append(inner).append(']') else sb.append(ch)
+            } else {
+                sb.append(ch)
+            }
+            i += Character.charCount(cp)
+        }
+        return Normalizer.normalize(sb, Normalizer.Form.NFKC).replace(WHITESPACE, " ").trim()
+    }
+
+    private fun isAribSymbol(cp: Int): Boolean =
+        cp in 0x1F100..0x1F1E5 || cp in 0x1F200..0x1F2FF
+
+    private val BS_PREFIXES = listOf("BS", "NHKBS", "NHK BS", "WOWOW", "放送大学")
+
+    private val GR_NAMES = listOf(
+        "NHK総合", "NHKEテレ", "NHK Eテレ", "日テレ", "日本テレビ", "テレビ朝日", "テレ朝", "TBS",
+        "テレビ東京", "テレ東", "フジテレビ", "TOKYO MX", "tvk", "テレビ神奈川", "チバテレ", "テレ玉",
+        "群馬テレビ", "とちぎテレビ", "MBS", "ABCテレビ", "ABC", "カンテレ", "関西テレビ", "読売テレビ",
+        "テレビ大阪", "サンテレビ", "KBS京都", "CBC", "東海テレビ", "中京テレビ", "メ~テレ", "テレビ愛知",
+        "HBC", "STV", "HTB", "UHB", "TVh", "RKB", "KBC", "TNC", "FBS", "TVQ",
+    )
+
+    /** Heuristic on the service name: Drive carries no network id. */
+    fun channelType(channel: String): String {
+        if (BS_PREFIXES.any { channel.startsWith(it, ignoreCase = true) }) return "BS"
+        val isGr = GR_NAMES.any { name ->
+            channel.startsWith(name, ignoreCase = true) &&
+                channel.substring(name.length).let { rest ->
+                    rest.isEmpty() || rest[0].isDigit() || rest[0] == ' ' || rest[0] == '・'
+                }
+        }
+        return if (isGr) "GR" else "CS"
+    }
+
+    /** First 4 bytes of SHA-256 as a 31-bit value; may be 0. */
+    fun hash31(key: String): Int {
+        val d = MessageDigest.getInstance("SHA-256").digest(key.toByteArray(Charsets.UTF_8))
+        val v = ((d[0].toInt() and 0xFF) shl 24) or ((d[1].toInt() and 0xFF) shl 16) or
+            ((d[2].toInt() and 0xFF) shl 8) or (d[3].toInt() and 0xFF)
+        return v and 0x7FFFFFFF
+    }
+
+    /**
+     * Oldest file first (modifiedMs, then file id), so an existing recording keeps its id when a
+     * newer file collides with it; the newer one is re-hashed with a `#n` suffix.
+     */
+    fun assignIds(
+        files: List<Pair<String, Long>>,
+        hash: (String) -> Int = ::hash31,
+    ): Map<String, Int> {
+        val used = HashSet<Int>(files.size * 2)
+        val out = LinkedHashMap<String, Int>(files.size * 2)
+        for ((fileId, _) in files.sortedWith(compareBy<Pair<String, Long>> { it.second }.thenBy { it.first })) {
+            if (out.containsKey(fileId)) continue
+            var n = 0
+            var id = hash(fileId)
+            while (id == 0 || id in used) {
+                n++
+                id = hash("$fileId#$n")
+            }
+            used += id
+            out[fileId] = id
+        }
+        return out
+    }
+
+    fun <T> page(items: List<T>, page: Int, limit: Int): List<T> {
+        if (page < 1 || limit < 1) return emptyList()
+        val from = (page - 1).toLong() * limit
+        if (from >= items.size) return emptyList()
+        return items.subList(from.toInt(), minOf(items.size.toLong(), from + limit).toInt())
+    }
+
+    /** Fixed width for a fixed offset: Room sorts these strings lexicographically. */
+    fun toIso8601(epochMs: Long, zone: ZoneId = ZoneId.systemDefault()): String =
+        ISO_SECONDS.format(Instant.ofEpochMilli(epochMs).atZone(zone))
+
+    fun estimateDurationSec(sizeBytes: Long): Double =
+        maxOf(1L, sizeBytes * 8L / ESTIMATE_BITS_PER_SECOND).toDouble()
+
+    fun toRecordedProgram(
+        rec: DriveRecording,
+        id: Int,
+        durationSec: Double,
+        thumbnailUrl: String,
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): RecordedProgram {
+        val parsed = parseFileName(rec.name)
+        val endMs = rec.modifiedMs
+        val startMs = endMs - (durationSec * 1000).toLong()
+        val start = toIso8601(startMs, zone)
+        val end = toIso8601(endMs, zone)
+        val channel = parsed.channel?.let { name ->
+            RecordedChannel(
+                id = name,
+                networkId = null,
+                serviceId = null, // tsreadex -n -1: first service of the PAT
+                displayChannelId = name,
+                type = channelType(name),
+                name = name,
+                channelNumber = "",
+            )
+        }
+        return RecordedProgram(
+            id = id,
+            title = parsed.title,
+            description = "",
+            startTime = start,
+            endTime = end,
+            duration = durationSec,
+            isPartiallyRecorded = false,
+            channel = channel,
+            recordedVideo = RecordedVideo(
+                id = id,
+                status = "Recorded",
+                filePath = "",
+                recordingStartTime = start,
+                recordingEndTime = end,
+                duration = durationSec,
+                containerFormat = "MPEG-TS",
+                videoCodec = "",
+                audioCodec = "",
+                hasKeyFrames = true,
+                thumbnailInfo = null,
+                cmSections = null,
+            ),
+            isRecording = false,
+            playbackPosition = 0.0,
+            directThumbnailUrl = null,
+            apiThumbnailUrl = thumbnailUrl,
+            // The Drive file id: survives the Room round trip and is read by no screen.
+            airType = rec.fileId,
+        )
+    }
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/iptv/IptvEpgIndex.kt b/app/src/main/java/kr/dcmys/komorebi/iptv/IptvEpgIndex.kt
