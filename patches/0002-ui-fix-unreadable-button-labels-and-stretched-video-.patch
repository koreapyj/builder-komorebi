diff --git a/app/src/main/java/kr/dcmys/komorebi/platform/ScreenAspect.kt b/app/src/main/java/kr/dcmys/komorebi/platform/ScreenAspect.kt
new file mode 100644
index 0000000..42ea169
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/platform/ScreenAspect.kt
@@ -0,0 +1,13 @@
+package kr.dcmys.komorebi.platform
+
+import android.view.View
+
+/** True when stretching a video of [videoAspect] over the whole window would distort it by under 3%. */
+fun View.windowMatchesAspect(videoAspect: Float): Boolean {
+    val root = rootView
+    val metrics = resources.displayMetrics
+    val width = if (root.width > 0) root.width else metrics.widthPixels
+    val height = if (root.height > 0) root.height else metrics.heightPixels
+    if (width <= 0 || height <= 0) return false
+    return aspectsMatch(width.toFloat() / height, videoAspect)
+}
diff --git a/app/src/main/java/kr/dcmys/komorebi/platform/VideoArea.kt b/app/src/main/java/kr/dcmys/komorebi/platform/VideoArea.kt
new file mode 100644
index 0000000..4b23d98
--- /dev/null
+++ b/app/src/main/java/kr/dcmys/komorebi/platform/VideoArea.kt
@@ -0,0 +1,35 @@
+package kr.dcmys.komorebi.platform
+
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.layout
+import androidx.compose.ui.unit.Constraints
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/** Upstream stretches video at least this wide over the whole screen; narrower video keeps its shape. */
+private const val WIDE_VIDEO_ASPECT = 1.7f
+
+fun aspectsMatch(a: Float, b: Float): Boolean = a > 0f && b > 0f && abs(a - b) / b < 0.03f
+
+/**
+ * Sizes an overlay to the area a wide video is drawn in: the whole parent when the parent has the
+ * video's shape (the video is stretched to fill it), the centred letterboxed rectangle otherwise.
+ */
+fun Modifier.wideVideoArea(videoAspect: Float): Modifier = layout { measurable, constraints ->
+    val width = constraints.maxWidth
+    val height = constraints.maxHeight
+    if (!constraints.hasBoundedWidth || !constraints.hasBoundedHeight || width <= 0 || height <= 0) {
+        val placeable = measurable.measure(constraints)
+        return@layout layout(placeable.width, placeable.height) { placeable.place(0, 0) }
+    }
+    val parentAspect = width.toFloat() / height
+    val fill = videoAspect < WIDE_VIDEO_ASPECT || aspectsMatch(parentAspect, videoAspect)
+    val areaWidth = if (fill || parentAspect < videoAspect) width else (height * videoAspect).roundToInt()
+    val areaHeight = if (fill || parentAspect >= videoAspect) height else (width / videoAspect).roundToInt()
+    val placeable = measurable.measure(Constraints.fixed(areaWidth, areaHeight))
+    layout(width, height) { placeable.place((width - areaWidth) / 2, (height - areaHeight) / 2) }
+}
+
+fun Modifier.wideVideoArea(videoWidth: Int, videoHeight: Int, pixelWidthHeightRatio: Float = 1f): Modifier =
+    if (videoWidth <= 0 || videoHeight <= 0) this
+    else wideVideoArea(videoWidth * pixelWidthHeightRatio / videoHeight)
